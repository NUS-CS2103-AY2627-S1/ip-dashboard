ia JavaFx","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":7,"deletions":1},"java":{"insertions":128,"deletions":93}}},{"hash":"29dfed0631ae78b4502cf4511c0487c4190731c3","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-10\u0027","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{}},{"hash":"f3407c084811732574faf81746984b4537b0944c","isMergeCommit":false,"messageTitle":"Edit Task initialise to use varargs","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":247,"deletions":3}}},{"hash":"a7346bc1016b7c6cd18eac2aa13acc1ca359fd07","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-Varargs\u0027","messageBody":"","tags":["A-Varargs"],"fileTypesAndContributionMap":{}},{"hash":"8e98819dd7707e9fc28997b04c96a77017fa7d03","isMergeCommit":false,"messageTitle":"Update README.md","messageBody":"","fileTypesAndContributionMap":{"md":{"insertions":2,"deletions":2}}}]},{"date":"2026-09-02T00:00:00","commitResults":[{"hash":"2c379667fa21a1b8c183f47b68c1b8ecebe5afeb","isMergeCommit":false,"messageTitle":"Add assertions","messageBody":"Added some new assertions, particularly to guard against null ptr\nerrors.\n","fileTypesAndContributionMap":{"java":{"insertions":20,"deletions":1}}},{"hash":"dfedac428dfcd9adc48d7d62baa2fcc0e71086cf","isMergeCommit":false,"messageTitle":"Refactor parser command handling","messageBody":"Parser.handleInput handles validation, parsing, command dispatch,\ntask creation, and persistence in one long method.\n\nThe mixed responsibilities make the command-processing flow harder to\nread and maintain, and obscure the behavior of individual commands.\n\nSplit command processing into focused private methods for dispatch,\ntask-number operations, and task creation.\n\nKeep the existing command behavior, response messages, and persistence\noperations unchanged while reducing each method\u0027s level of\nresponsibility.\n\nAll tests and checkstyleMain pass under Java 25.\n","fileTypesAndContributionMap":{"java":{"insertions":100,"deletions":64}}},{"hash":"6adfaaba98c5c8505310bddf9a0bc907003cad94","isMergeCommit":false,"messageTitle":"Refactor JavaFX startup setup","messageBody":"Main.start configures the entire JavaFX window in one long method.\n\nThe mixed setup responsibilities make the application startup flow harder\nto read and maintain.\n\nSplit component creation, stage configuration, layout configuration, event\nhandler registration, and welcome-message display into focused methods.\n\nKeep the existing initialization order and GUI behavior while making the\nstartup sequence easier to understand.\n\nAll tests and checkstyleMain pass under Java 25.\n","fileTypesAndContributionMap":{"java":{"insertions":42,"deletions":9}}},{"hash":"11ce6d0b3af7921fb9485494128099596748e7d8","isMergeCommit":false,"messageTitle":"Refactor task restoration","messageBody":"Task.initialise restores every task type and completion status in one\nmethod while relying on raw storage literals.\n\nThe combined deserialization paths make the restoration logic harder to\nread and allow task symbols and statuses to be interpreted\ninconsistently.\n\nSplit restoration into task-type-specific helper methods and resolve\ntask symbols through TaskType.\n\nName the completion-status values to make the storage format explicit\nwhile preserving the existing serialized representation and behavior.\n\nAll tests and checkstyleMain pass under Java 25.\n","fileTypesAndContributionMap":{"java":{"insertions":84,"deletions":30}}},{"hash":"b58fbd5ff4f7e60dd17edd729351607100ebcfdb","isMergeCommit":false,"messageTitle":"Reuse task number validation","messageBody":"TaskList repeats task-number validation and its error message in three\noperations.\n\nDuplicated validation can drift and makes changes to task-number\nhandling needlessly repetitive.\n\nReuse a shared task-index lookup and invalid-number response across\nremoval, marking, and unmarking.\n\nKeep one-based command numbering and list-index behavior unchanged,\nincluding removing the selected task by its original index.\n\nAll tests and checkstyleMain pass under Java 25.\n","fileTypesAndContributionMap":{"java":{"insertions":36,"deletions":10}}},{"hash":"dd9745827611b9a813b3111b26f2efd811eb1157","isMergeCommit":false,"messageTitle":"Flatten task initialization flow","messageBody":"Deadline and Event initialization use nested branches for validation,\nparsing, and object setup.\n\nThe nested happy path makes task creation harder to follow, while null\nchecks on split results add noise without protecting the code.\n\nUse guard clauses and simplify the validation expressions in both task\ninitializers.\n\nKeep the existing input formats, error messages, date parsing, and\ninitialization behavior unchanged.\n\nAll tests and checkstyleMain pass under Java 25.\n","fileTypesAndContributionMap":{"java":{"insertions":43,"deletions":48}}},{"hash":"fb0605e11c20ab6364456e432e529f8aee16fbab","isMergeCommit":false,"messageTitle":"Refactor list tasks to use streams","messageBody":"Previously, used a for loop. It was relatively bulky, and a little hard\nto understand.\n\nSwap to stream paradigm, each step uses a known stream method, makes the\ncode more compact and easier to follow the chain of logic.\n","fileTypesAndContributionMap":{"java":{"insertions":12,"deletions":6}}},{"hash":"c36d6734dfe2349325cbd5f5202aedd917ee026b","isMergeCommit":true,"messageTitle":"Merge pull request #1 from JellehBelleh/branch-A-Assertions","messageBody":"Add assertions","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"692b1a65c7b28bd9e2555814d1caf2c0d2cebec8","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"311ad4b5ba15fd69085761a35e5c725a2439bf37","isMergeCommit":true,"messageTitle":"Merge pull request #2 from JellehBelleh/branch-A-CodeQuality","messageBody":"Improve code quality","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"4134f4b523fbb7ed6bee12b7a8c036e6fd14d0f2","isMergeCommit":false,"messageTitle":"Fix assertions in task list","messageBody":"Previously, a redundant check for valid task number was still present,\nwhich should not be the case due to the assertion check. Also, assertion\ncheck for null task list was moved to the helper index method instead\nto make the code more reusable and general.\n","fileTypesAndContributionMap":{"java":{"insertions":2,"deletions":6}}},{"hash":"63981776aa6394d7c9e97be587b87d8ab32ea0cc","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"cb52d0684878b80ece29722a149a0cfe5467508e","isMergeCommit":false,"messageTitle":"Remove extra semicolon","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":1,"deletions":1}}},{"hash":"3246cf433bb61ad677d78c692db585ae2fb137f2","isMergeCommit":true,"messageTitle":"Merge pull request #3 from JellehBelleh/branch-A-Streams","messageBody":"Refactor list tasks to use streams","tags":["A-Streams"],"fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionMap":{"JellehBelleh":{"java":1351,"md":98,"fxml":0,"sh":0,"bat":0,"gradle":13,"txt":0}},"authorContributionVariance":{"JellehBelleh":55053.645},"authorDisplayNameMap":{"JellehBelleh":"CS2103T-W08-1 NG M..XUAN"}}
