dd GUI","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{"fxml":{"insertions":28,"deletions":0},"java":{"insertions":16,"deletions":0}}}]},{"date":"2026-09-10T00:00:00","commitResults":[{"hash":"17ff569fb3c0622ce610913912b290c78010d289","isMergeCommit":false,"messageTitle":"Add JavaFX GUI","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":17,"deletions":1},"fxml":{"insertions":79,"deletions":23},"java":{"insertions":322,"deletions":14}}},{"hash":"de8647b3e6bc3ca64bf8269e75137f5946c2cfce","isMergeCommit":false,"messageTitle":"Edit GUI","messageBody":"","fileTypesAndContributionMap":{"fxml":{"insertions":16,"deletions":45},"java":{"insertions":21,"deletions":21}}},{"hash":"d4cfe83197f8a70a717da40b942e3a2fadaf9103","isMergeCommit":false,"messageTitle":"Exit chatbot after bye command","messageBody":"The GUI accepts the bye command but remains open for a while to display the goodbye response.\n\nClose the application after a short delay so that the command behaves like the command-line interface while giving the user time to read Nicola\u0027s reply.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"java":{"insertions":10,"deletions":0}}},{"hash":"4511d39a6ead0135ce21f32c59b633a5382fdffb","isMergeCommit":false,"messageTitle":"Add assertions for internal assumptions","messageBody":"Some parsing and task functions depend on non-null inputs passed in by the other methods\n\nDocument these assumptions with Java assertions so that programming error can be detected earlier during the development\n","fileTypesAndContributionMap":{"gradle":{"insertions":2,"deletions":1},"java":{"insertions":10,"deletions":0}}},{"hash":"1ce297d9bc773b4cbf866cc5b9ade5eee497cc01","isMergeCommit":false,"messageTitle":"Extract shared command execution","messageBody":"The command-line and GUI paths duplicate command-dispatch logic. This makes command changes harder to maintain and allows the two interfaces to develop inconsistent behaviour.\n\nExtract the common dispatch logic into one method so that both interfaces use the same command implementation.\n","fileTypesAndContributionMap":{"java":{"insertions":79,"deletions":84}}},{"hash":"0877fb926b7158079690df898ba2dbcc352f31a0","isMergeCommit":false,"messageTitle":"Rename date parsing method","messageBody":"There was a typo in naming of the method parseData.\n\nRename the method to parseDate so that its name accurately communicates its purpose to readers.\n","fileTypesAndContributionMap":{"java":{"insertions":3,"deletions":2}}},{"hash":"6b6bff7abc44e72652c487608f372ba9bff41bf2","isMergeCommit":false,"messageTitle":"Fail fast when dialog FXML cannot load","messageBody":"A dialog box cannot function when its required FXML resource fails to load, but the constructor only prints the error and continues with uninitialized controls.\n\nThrow an IllegalStateException so that the app stops at the actual failure and reports a clear diagnostic message\n","fileTypesAndContributionMap":{"java":{"insertions":5,"deletions":2}}},{"hash":"21895bddda0b96a1efc61c29e00b91a8439233f5","isMergeCommit":false,"messageTitle":"remove dead declarations","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":0,"deletions":4}}},{"hash":"ac272f090e7c343a71226c416db52d9a54f46a4f","isMergeCommit":false,"messageTitle":"Remove duplicate todo validation","messageBody":"The todo description is checked in both command dispatch and the addTodo method even though addTodo is called only after dispatch validation succeeds.\n\nKeep the validation at the command boundary so that the rule has one clear owner and is not duplicated.\n","fileTypesAndContributionMap":{"java":{"insertions":0,"deletions":4}}},{"hash":"e4c16ed29be90c5affe604b22623e4db74b685fd","isMergeCommit":false,"messageTitle":"Propagate main FXML loading failures","messageBody":"The application cannot display its interface when the main FXML resource fails to load, but startup catches the exception and only prints its stack trace.\n\nAllow the loading exception to propagate so that JavaFX reports the original startup failure clearly instead of ending silently.\n","fileTypesAndContributionMap":{"java":{"insertions":2,"deletions":5}}},{"hash":"cced647cc24e70c827ee5413e5355352ab6e4ae6","isMergeCommit":false,"messageTitle":"Remove unused event date formatter","messageBody":"Event tasks always contain date-time values, but EventTask declares a date-only formatter that is never used.\n\nRemove the dead formatter so that the class exposes only formatting rules relevant to event data.\n","fileTypesAndContributionMap":{"java":{"insertions":0,"deletions":1}}},{"hash":"c9f1cdb4767f9a433a50b5ec3f77876fad5eb067","isMergeCommit":false,"messageTitle":"Remove unused send button binding","messageBody":"The FXML send button is injected into the controller even though the controller never accesses the field.\n\nRemove the unused field and FXML identifier while retaining the action handler that connects the button to user-input processing.\n","fileTypesAndContributionMap":{"fxml":{"insertions":1,"deletions":1},"java":{"insertions":0,"deletions":3}}},{"hash":"1a80431f54dc1c353d8e3a1430f56001ee2c1def","isMergeCommit":false,"messageTitle":"Use a stream to find matching tasks","messageBody":"Task searching previously combined filtering, numbering, and output inside one loop.\n\nUse a stream to produce the matching task list, leaving the subsequent loop responsible only for numbered output.\n","fileTypesAndContributionMap":{"java":{"insertions":11,"deletions":8}}},{"hash":"4ba273a668a0c865982ae390c8328cbac49df3b2","isMergeCommit":true,"messageTitle":"Merge pull request #1 from kkyingovo/branch-A-Assertions","messageBody":"Add assertions for internal assumptions","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"259e5192ffc5c9116d4b01540a2fc50d4ae66a84","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap"