:31,"deletions":23}}},{"hash":"915d89deee95b61ef7a2d7de1ce5da98b1df3bd4","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CheckStyle\u0027","messageBody":"","tags":["A-CheckStyle"],"fileTypesAndContributionMap":{}}]},{"date":"2026-08-31T00:00:00","commitResults":[{"hash":"dfe3d18a40dd2402c40f77f30f70901bbf535c17","isMergeCommit":false,"messageTitle":"Add Launcher.java","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":15,"deletions":1},"java":{"insertions":52,"deletions":0}}},{"hash":"b279a64d31dba311d834bf39741a77b892b163ed","isMergeCommit":false,"messageTitle":"Add Ui elements","messageBody":"","fileTypesAndContributionMap":{"fxml":{"insertions":73,"deletions":0},"java":{"insertions":317,"deletions":23}}},{"hash":"8b837cee767b0b6eff74d46f3c34755a8d42c0a3","isMergeCommit":false,"messageTitle":"Add profile images","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":6,"deletions":30}}},{"hash":"2dac3b6add2e9cc99c1c8cc8b57e0d9434063672","isMergeCommit":false,"messageTitle":"Add css files","messageBody":"","fileTypesAndContributionMap":{"fxml":{"insertions":20,"deletions":3},"java":{"insertions":5,"deletions":1}}}]},{"date":"2026-09-01T00:00:00","commitResults":[{"hash":"d8f813f82f776a837e6a6541ecb953bfee6828b0","isMergeCommit":false,"messageTitle":"Update GUI style","messageBody":"","fileTypesAndContributionMap":{"fxml":{"insertions":55,"deletions":41},"java":{"insertions":18,"deletions":16},"md":{"insertions":1,"deletions":15}}},{"hash":"e0e007fcfe038854513c91b9646cdaa38118c74a","isMergeCommit":true,"messageTitle":"Merge branch-Level-10 into master with explicit history","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{}},{"hash":"00701c3f9e7573b61dfdb696e96fddd42c9f7e41","isMergeCommit":false,"messageTitle":"Change Longfrog\u0027s personality","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":55,"deletions":50},"md":{"insertions":61,"deletions":59}}}]},{"date":"2026-09-05T00:00:00","commitResults":[{"hash":"392efac6acbc8ad943b392478c99520410f9e7a9","isMergeCommit":false,"messageTitle":"Add assertions","messageBody":"Several components rely on assumptions established by other parts of the\napplication. Parsed arguments must be valid, task lists must not contain\nnull entries, and JavaFX dependencies must be initialized before use.\n\nLeaving these contracts implicit can cause programming errors to surface\nlater as unrelated failures that are harder to diagnose.\n\nAdd message-bearing assertions at parser, task-list, storage, command\nexecution, and UI boundaries. Add tests for the task-list null-entry\ninvariant.\n","fileTypesAndContributionMap":{"java":{"insertions":53,"deletions":3}}},{"hash":"635f9138bf0675bbc1f52a00cbeec7531eb8fe2f","isMergeCommit":false,"messageTitle":"Parser: Separate command-specific parsing","messageBody":"Parser.parse mixes command dispatch with detailed delimiter\nvalidation. This makes the high-level flow harder to scan and\nduplicates validation logic.\n\nExtract command-specific parsing and shared argument splitting so\ndispatch stays at one abstraction level and command formats remain\nconsistent.\n","fileTypesAndContributionMap":{"java":{"insertions":91,"deletions":50}}},{"hash":"8c03bf422ad9d0dab977e74e5d9755089183148d","isMergeCommit":false,"messageTitle":"TaskList: Clarify and protect task ownership","messageBody":"TaskList exposes its mutable backing collection and uses generic API\nnames. Callers can change state without TaskList enforcing its\ninvariants, while getAll and addToList obscure the domain action.\n\nReturn an unmodifiable snapshot, copy loaded tasks, and use\ntask-oriented names so TaskList owns mutations and its API states\nintent.\n","fileTypesAndContributionMap":{"java":{"insertions":49,"deletions":28}}},{"hash":"b1c474e9c180abad25006d4a89ae39d0a17e863b","isMergeCommit":false,"messageTitle":"Storage: Close file resources automatically","messageBody":"Storage closes scanners and writers only after normal processing\ncompletes. An I/O exception can skip close and leave a file handle\nopen.\n\nUse try-with-resources so Java closes each resource on every path.\nThis keeps lifecycle explicit and prevents failures from affecting\nlater operations.\n","fileTypesAndContributionMap":{"java":{"insertions":14,"deletions":15}}},{"hash":"64f36380c105c49cd50a857c368c1777d9d7f9a4","isMergeCommit":false,"messageTitle":"Tasks: Own date-matching behavior","messageBody":"DateCommand knows concrete task subclasses and contains each type\u0027s\ndate rules. That branching mixes command orchestration with domain\nbehavior and must grow whenever a new dated task is introduced.\n\nLet each task report whether it occurs on a date. This keeps\nDateCommand at a single abstraction level and keeps date rules beside\ntheir owning data.\n","fileTypesAndContributionMap":{"java":{"insertions":64,"deletions":15}}},{"hash":"6816f51bb49e22b4a67b58a3159bb269ce251e80","isMergeCommit":false,"messageTitle":"Commands: Remove unused EchoCommand","messageBody":"EchoCommand has no parser entry and no callers, so it cannot take part\nin any application flow. Keeping it suggests a capability that does\nnot exist and adds code readers must inspect.\n\nRemove the unused class. Version control preserves it if an echo\nfeature is ever intentionally introduced.\n","fileTypesAndContributionMap":{"java":{"insertions":0,"deletions":21}}},{"hash":"e1fbff99695daef12b04c3f1832ab62bcc170e1b","isMergeCommit":false,"messageTitle":"UI: Centralize numbered task display","messageBody":"List, find, and date commands each construct the same numbered task\noutput. Duplicating this presentation rule makes formatting changes\neasy to apply inconsistently and distracts from each command\u0027s\npurpose.\n\nMove numbered task display into Ui so each command delegates the\nshared format while retaining ownership of its heading and\nempty-state message.\n","fileTypesAndContributionMap":{"java":{"insertions":23,"deletions":17}}}]},{"date":"2026-09-07T00:00:00","commitResults":[{"hash":"c46febfef14d4d68b8a629d8f2345665a345867c","isMergeCommit":false,"messageTitle":"Use streams for collection queries","messageBody":"Task filtering and command lookup use manual loops even when their intent is a simple collection query.\n\nReplace these loops with stream pipelines to express filtering and lookup more directly. Keep date-specific matching in a named helper so the different temporal rules remain easy to understand.\n","fileTypesAndContributionMap":{"java":{"insertions":25,"deletions":39}}},{"hash":"51a066fb51080cfd3cf3adb23bfe1807e071acf2","isMergeCommit":true,"messageTitle":"Merge pull request #1 from JamesLee5182/branch-A-Assertions","messageBody":"Add assertions","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"83703bc57288b6f64d452b930222d8c3cccbeb40","isMergeCommit":true,"messageTitle":"Merge master into branch-A-CodeQuality","messageBody":"Master adds assertions that document parser, storage, task-list, and UI\ninvariants. Its TaskList and Storage changes overlap the code-quality\nrefactors on this branch.\n\nKeep the defensive task-list API and try-with-resources behavior while\nadapting the incoming assertions and tests to those designs.\n","fileTypesAndContributionMap":{}},{"hash":"4cedc48cfe5f994b47071a098e72fd9773c52128","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"7d459c4b95d198c8cb62412027d6822483f94824","isMergeCommit":true,"messageTitle":"Merge pull request #3 from JamesLee5182/branch-A-Streams","messageBody":"Use streams for collection queries","tags":["A-Streams"],"fileTypesAndContributionMap":{}},{"hash":"ae19ce92550c86cb4b6a9ec5a024967bede14ee5","isMergeCommit":true,"messageTitle":"Merge master into branch-A-CodeQuality","messageBody":"Master replaces manual collection queries with stream pipelines.\nThe date query overlaps this branch\u0027s TaskList API rename and\npolymorphic date matching.\n\nKeep stream-based lookup while using getTasks() and Task.occursOn() so\nthe merged code retains concise querying and task-owned date rules.\n","fileTypesAndContributionMap":{}},{"hash":"296afa83aab891541cfd59f19a3325ab1054af73","isMergeCommit":true,"messageTitle":"Merge pull request #2 from JamesLee5182/branch-A-CodeQuality","messageBody":"Improve code quality","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionMap":{"JamesLee5182":{"java":2045,"md":216,"fxml":104,"sh":0,"bat":0,"gradle":21,"txt":0}},"authorContributionVariance":{"JamesLee5182":55677.04},"authorDisplayNameMap":{"JamesLee5182":"CS2103T-T09-4 KEAN.. JIE"}}
