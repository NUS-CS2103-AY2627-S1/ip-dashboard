,"isMergeCommit":false,"messageTitle":"Add task validation tests","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":49,"deletions":0}}},{"hash":"5167cce3d3901c3bc0eca360cf386ab0c6deebd2","isMergeCommit":false,"messageTitle":"Add UI message tests","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":45,"deletions":0}}},{"hash":"3a3277bb7b33b142036131a262ca4d65700881a6","isMergeCommit":false,"messageTitle":"Add walnut validation tests","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":58,"deletions":0}}},{"hash":"58f86f4f66b98aa3643c6d93f3cd0447cab074b5","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-MoreTesting\u0027","messageBody":"","tags":["A-MoreTesting"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-16T00:00:00","commitResults":[{"hash":"11a0b48e88cd802e371b3a36d392818042f00760","isMergeCommit":false,"messageTitle":"Improve dialog UI and application logging","messageBody":"Update DialogBox to use TextFlow/Text for dialog content and\nrefine layout, styling, and error-label detection. Replace\ne.printStackTrace() with java.util.logging.Logger in DialogBox,\nHelpWindow, and Main and configure the root logger in Main.start\nfor consistent application logging. Add missing Javadoc @return\ntags in Ui, improve multi-part UI messages, and replace an\nassert with Objects.requireNonNull in MainWindow. Update related\nFXML/CSS and tests to reflect the UI changes.\n","fileTypesAndContributionMap":{"java":{"insertions":101,"deletions":25}}},{"hash":"f10c68ba27e112fee4a44f43f14e93dd1b33f451","isMergeCommit":false,"messageTitle":"Improve dialog UI and application logging","messageBody":"Update DialogBox to use TextFlow/Text for dialog content and\nrefine layout, styling, and error-label detection. Replace\ne.printStackTrace() with java.util.logging.Logger in DialogBox,\nHelpWindow, and Main and configure the root logger in Main.start\nfor consistent application logging. Add missing Javadoc @return\ntags in Ui, improve multi-part UI messages, and replace an\nassert with Objects.requireNonNull in MainWindow. Update related\nFXML/CSS and tests to reflect the UI changes.\n","fileTypesAndContributionMap":{"java":{"insertions":30,"deletions":3}}},{"hash":"d395d2debbc99c7d8de024257633def3767cbbb4","isMergeCommit":false,"messageTitle":"Configure app logging and window","messageBody":"The app was relying on default logging and window defaults that made runtime\nissues harder to diagnose and the UI less consistent. This updates startup\nto use a consistent INFO log level, logs FXML load failures through the\nlogger instead of printing stack traces, and sets the application title\nwith explicit window sizing constraints.\n","fileTypesAndContributionMap":{"java":{"insertions":13,"deletions":2}}},{"hash":"96eb062d385003587b637e717b66550fdbfe231e","isMergeCommit":false,"messageTitle":"Improve GUI input handling and startup flow","messageBody":"The app now validates the Walnut dependency more explicitly, splits the\nwelcome banner and greeting into separate dialog entries, treats help and\nexit commands case-insensitively, and closes the window when the user says\nbye. This makes the startup sequence clearer and the CLI interactions more\nrobust.\n","fileTypesAndContributionMap":{"java":{"insertions":22,"deletions":5}}},{"hash":"c2b2d59076081d98ea2c0ec1a3c3d867ecee8543","isMergeCommit":false,"messageTitle":"Reorder TaskList helper method","messageBody":"This commit moves the static `toString` helper in `TaskList` to a more\nlogical position in the class, keeping the file structure consistent with\nthe surrounding API and reducing confusion when reading the class. The\nbehavior is unchanged; only the placement is adjusted.\n","fileTypesAndContributionMap":{"java":{"insertions":16,"deletions":16}}},{"hash":"2f4a4d02b0a103dd7d3383e15e64a0a7ea3d810b","isMergeCommit":false,"messageTitle":"Refine UI wording and task messages","messageBody":"This commit simplifies the user-facing messages in `Ui` by removing repeated\n`Walnut:` prefixes, improving grammar, and using singular/plural wording\nfor task counts. It also adds clearer help guidance and standardizes the\nreturned strings so the interface reads more naturally.\n","fileTypesAndContributionMap":{"java":{"insertions":49,"deletions":18}}},{"hash":"1af2bc45cd6e34d5332e00909714236b6ff06f18","isMergeCommit":false,"messageTitle":"Modernize dialog bubble layout","messageBody":"Replace the label-based dialog content with a text flow container and\ntighten the chat bubble sizing for a cleaner, more compact UI. This\nkeeps message text more flexible and consistent with the revised\ndialog styling.\n","fileTypesAndContributionMap":{"fxml":{"insertions":20,"deletions":14}}},{"hash":"9dce1719c4bafcafd741f3d4f31f7dea887e9c8a","isMergeCommit":false,"messageTitle":"Style the help window","messageBody":"Apply a dedicated stylesheet to the help screen and replace inline\nlabels with styled command and description blocks. This improves\nreadability and keeps the help content aligned with the app\u0027s\nupdated visual design.\n","fileTypesAndContributionMap":{"fxml":{"insertions":98,"deletions":26}}},{"hash":"e52afe2e608db36b4f0bcdc22db28d0a33e556c5","isMergeCommit":false,"messageTitle":"Polish the main chat layout","messageBody":"Adjust the main window layout to use a cleaner input bar, add a\nprompt in the command field, and make the conversation area more\nflexible with spacing and scrolling behavior. This keeps the chat\ninterface easier to use and visually consistent with the updated UI.\n","fileTypesAndContributionMap":{"fxml":{"insertions":19,"deletions":14}}},{"hash":"d0c8a114a112c1589509b48b848eb57a4d0347d4","isMergeCommit":false,"messageTitle":"Tidy test imports","messageBody":"Remove and reorder the JUnit static imports in the deadline test so\nthe file matches the project\u0027s import style and keeps the assertions\ngrouped consistently.\n","fileTypesAndContributionMap":{"java":{"insertions":1,"deletions":1}}},{"hash":"d0e882e7e7481ba34bff05a476674dde44fd9abc","isMergeCommit":false,"messageTitle":"Reorder event test imports","messageBody":"Sort the static JUnit imports in the event test to keep the file\nconsistent with the existing test style and avoid noisy ordering\ndifferences.\n","fileTypesAndContributionMap":{"java":{"insertions":1,"deletions":1}}},{"hash":"7220c44a7f4a4e422ed7f338237cd38d9351d958","isMergeCommit":false,"messageTitle":"Reorder parser test imports","messageBody":"Adjust the static import order in the parser test to align with the\nproject\u0027s import conventions and keep the test file tidy.\n","fileTypesAndContributionMap":{"java":{"insertions":1,"deletions":1}}},{"hash":"119268de6d1e3e89fdd269502cbdf3aed3733dca","isMergeCommit":false,"messageTitle":"Simplify validation test inputs","messageBody":"Store the invalid datetime strings in local variables before asserting\nthey throw parse errors. This keeps the tests clearer and makes the\nexpected failing inputs easier to read at a glance.\n","fileTypesAndContributionMap":{"java":{"insertions":4,"deletions":2}}},{"hash":"0e6743e8acfe7e26d409b5c20d48e51151415aca","isMergeCommit":false,"messageTitle":"Remove redundant invalid-command test","messageBody":"Delete the outdated UI assertion that checks invalid command messaging\nfor specific command names, because the current staged changes no longer\nkeep that expectation in the test suite.\n","fileTypesAndContributionMap":{"java":{"insertions":0,"deletions":6}}},{"hash":"311f1f96403d8c8f23090d2a250475a2aadbdc9d","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-BetterGui\u0027","messageBody":"","tags":["A-BetterGui"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-17T00:00:00","commitResults":[{"hash":"1e06a1bab10d550c54176787fcfcaf1146443fbd","isMergeCommit":false,"messageTitle":"Handle more error messages","messageBody":"Expand the dialog error detection in `DialogBox` to cover additional\nuser-facing validation and parsing messages, so more failures render\nwith the correct error styling.\n","fileTypesAndContributionMap":{"java":{"insertions":9,"deletions":4}}},{"hash":"b60544db86a388525ba976a54573bf8ff3790ac2","isMergeCommit":false,"messageTitle":"Refresh the Walnut personality copy","messageBody":"Update the UI text strings to a more playful dog-themed tone while\nkeeping the command, validation, and task messages clear and useful.\nThis makes the app\u0027s responses feel more consistent and distinctive.\n","fileTypesAndContributionMap":{"java":{"insertions":26,"deletions":31}}},{"hash":"8ed19e5f35f3f82d3c67de45ce69416a418894d5","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-Personality\u0027","messageBody":"","tags":["A-Personality"],"fileTypesAndContributionMap":{}},{"hash":"ed3efa838acff1b95bbecffe8e16a56d6688a48b","isMergeCommit":false,"messageTitle":"Add GUI screenshot","messageBody":"","fileTypesAndContributionMap":{"txt":{"insertions":0,"deletions":3}}},{"hash":"45cd18cf66de29e8a611466c5b3660365dd67fd4","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Ui\u0027","messageBody":"","tags":["Ui.png"],"fileTypesAndContributionMap":{}},{"hash":"a6ed08b107a681374b0364275e67d9ed6fc8d589","isMergeCommit":false,"messageTitle":"Update README.md","messageBody":"","fileTypesAndContributionMap":{"md":{"insertions":82,"deletions":14}}},{"hash":"f85c678cf61296986ab062ef331f1e37062523ee","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-UserGuide\u0027","messageBody":"","tags":["A-UserGuide"],"fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionMap":{"EthanJoshLeong":{"java":2107,"md":242,"fxml":249,"sh":0,"bat":0,"gradle":26,"txt":0}},"authorContributionVariance":{"EthanJoshLeong":70334.02},"authorDisplayNameMap":{"EthanJoshLeong":"CS2103T-F14a-1 ETHA.. WAI"}}
