butionMap":{"java":{"insertions":1,"deletions":0}}},{"hash":"d1244d1978a2e172524e1ca24492a0142ca2774b","isMergeCommit":false,"messageTitle":"Add assertion checks for Parser.java","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":20,"deletions":1}}},{"hash":"ecb3d608ae14f611eede2aac296a89d993873bec","isMergeCommit":false,"messageTitle":"Add assertion checks for Storage.java","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":7,"deletions":0}}},{"hash":"03be890ed3074e19e65eb3ace731c9200a675e43","isMergeCommit":false,"messageTitle":"Add assertion checks for Task.java","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":2,"deletions":0}}},{"hash":"0a721fc41aad72c206077309342de2c91a7fc390","isMergeCommit":false,"messageTitle":"Add assertion checks for TaskList.java","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":8,"deletions":0}}},{"hash":"c46c16093e17277c30953efe7d1df65b641b5806","isMergeCommit":false,"messageTitle":"Add assertion checks for ui.java","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":1,"deletions":0}}},{"hash":"9a554c2728aa2d270d212c1b2d4a790f52d711d6","isMergeCommit":false,"messageTitle":"Add assertion checks for Walnut.java","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":6,"deletions":1}}},{"hash":"80c7395aeef79006edf50dcea93a5a688dc8cd1a","isMergeCommit":false,"messageTitle":"Enable assertions","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":4,"deletions":0}}},{"hash":"665ff1de8828e03df093e10c7a7b6bca92a0bb7a","isMergeCommit":false,"messageTitle":"Harden task parsing and storage","messageBody":"Walnut currently assumes stored task lines are always well-formed and\ncan crash when data is malformed or incomplete. Unsupported task types\nalso risk writing blank records during save.\n\nThis commit makes task parsing defensive, validates task indexes more\nconsistently, centralizes date-time formatters, and improves the\ndisplay formatting of deadline and event times. These changes make the\napp more resilient to corrupt saved data and easier to maintain.\n","fileTypesAndContributionMap":{"java":{"insertions":2,"deletions":3}}},{"hash":"8b71ebb79d259c99e9607d8807f9b4aedc6ef73b","isMergeCommit":false,"messageTitle":"Use shared date formatters for events","messageBody":"Update Event to use the shared Parser storage and display formatters\ninstead of re-declaring date-time patterns in the class itself. This keeps\nevent output consistent with the parser\u0027s existing formatting and removes\nduplicated formatting logic.\n","fileTypesAndContributionMap":{"java":{"insertions":4,"deletions":5}}},{"hash":"d638ba1c39db9c9446cd1c98b317179aeecb460e","isMergeCommit":false,"messageTitle":"Centralize date parsing formats","messageBody":"Standardize Parser date-time formatters into shared constants and make\ntask parsing resilient to malformed saved entries. This keeps storage and\nuser input formatting consistent while preventing crashes when a task line\nis missing required fields or has invalid date data.\n","fileTypesAndContributionMap":{"java":{"insertions":44,"deletions":25}}},{"hash":"335573a2be1a8fa56e209ac55a3a2d1828c5b83a","isMergeCommit":false,"messageTitle":"Handle unsupported task types in storage","messageBody":"Ensure storage writes a valid line for every task subtype and fails loudly\nfor unsupported concrete tasks instead of silently producing incomplete\ndata. This keeps saved task records consistent and makes future task\nextensions easier to reason about.\n","fileTypesAndContributionMap":{"java":{"insertions":8,"deletions":8}}},{"hash":"3bdad3cf5314a1487c02d23027a05d0ba5fb3156","isMergeCommit":false,"messageTitle":"Validate task commands and indexes","messageBody":"Validate user input before acting on task commands and indexes to avoid\nconfusing errors from missing or malformed arguments. The change\ncentralizes command markers and index checks so mark, unmark, delete,\nand add operations behave consistently when input is incomplete or\ninvalid.\n","fileTypesAndContributionMap":{"java":{"insertions":67,"deletions":34}}},{"hash":"5f0f828938e2fe94ce4576f019ed22cc168a1f6d","isMergeCommit":false,"messageTitle":"Add code quality checker skill","messageBody":"Add a repository skill that audits code against the CS2103/T Code Quality\nchapter and reports concrete, actionable findings with suggested fixes.\nThis gives contributors a repeatable review workflow without changing\napplication code.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"md":{"insertions":93,"deletions":0}}},{"hash":"f9e2f7bdb803ea60435ed63ae29582764867bbfc","isMergeCommit":false,"messageTitle":"Update skill to include message body","messageBody":"","fileTypesAndContributionMap":{"md":{"insertions":11,"deletions":2}}},{"hash":"179214846cfee2a8ffa7d88f1358d5d8a867ada6","isMergeCommit":true,"messageTitle":"Merge pull request #1 from EthanJoshLeong/branch-A-Assertions","messageBody":"Branch a assertions","tags":["A-Assertions"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-09T00:00:00","commitResults":[{"hash":"1ad886d403167839987d076fe0aa3c2927095b75","isMergeCommit":false,"messageTitle":"Enable assertions and guard task invariants","messageBody":"Enable runtime assertions in Gradle and add guard checks across task\ncreation, parsing, storage, and command handling. This catches invalid\nstates early during development and makes regressions easier to diagnose\nbefore they reach users.\n","fileTypesAndContributionMap":{"gradle":{"insertions":4,"deletions":0},"txt":{"insertions":3,"deletions":0},"java":{"insertions":50,"deletions":4}}},{"hash":"a7a765271521ec8e2ac6c9e650d9a1c450115875","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"15ce1cb3913376faf62458e7e08f7e4f6f4e6777","isMergeCommit":true,"messageTitle":"Merge pull request #2 from EthanJos