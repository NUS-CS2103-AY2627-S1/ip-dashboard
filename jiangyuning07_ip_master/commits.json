99ef1f2ce5498b006dd1c77b1","isMergeCommit":false,"messageTitle":"Refactor Alex to return command responses","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":96,"deletions":40}}},{"hash":"0a9cae5ce611c630d4212eebb5522fee5e337b92","isMergeCommit":false,"messageTitle":"Set up JavaFX application entry point","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":15,"deletions":1},"java":{"insertions":40,"deletions":0}}},{"hash":"43862e0e8921095f619a8f8c90e5c9ba503f650a","isMergeCommit":false,"messageTitle":"Add functional JavaFX window","messageBody":"","fileTypesAndContributionMap":{"fxml":{"insertions":85,"deletions":0},"java":{"insertions":153,"deletions":4}}},{"hash":"2eb469d962522b0af43be3ceb6eaf0d939d68918","isMergeCommit":false,"messageTitle":"Add Alex\u0027s welcome message to GUI window","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":5,"deletions":0}}}]},{"date":"2026-09-03T00:00:00","commitResults":[{"hash":"4287543d36f64d97c5722c80c7396a372414277d","isMergeCommit":false,"messageTitle":"Add JavaFX chat window styling","messageBody":"","fileTypesAndContributionMap":{"fxml":{"insertions":2,"deletions":0},"java":{"insertions":1,"deletions":0}}},{"hash":"706d86db867f59e25e1df54772d9d92c67b354ba","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-10\u0027","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{}},{"hash":"2c465d704eaa999224e1450f1ba4de40d879a5aa","isMergeCommit":false,"messageTitle":"Add varargs constructor for TaskList","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":11,"deletions":2}}},{"hash":"27f96fe15de7ac246d0b1b8174c12fdf7a5d0f25","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-Varargs\u0027","messageBody":"","tags":["A-Varargs"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-09T00:00:00","commitResults":[{"hash":"f2617bc78f2ec5ab3eccdfe622ce9fd2fe52e517","isMergeCommit":false,"messageTitle":"Add assertions for important invariants","messageBody":"Several parser, command-dispatch, and task-model methods rely on\nassumptions established by their callers.\n\nBreaking these assumptions can cause failures far from their source, making\ndefects harder to diagnose.\n\nAdd assertions for valid command types, task indexes, task fields, and task\ncollections to help errors fail closer to their source.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"java":{"insertions":42,"deletions":1}}},{"hash":"3a75e9cfb003c912c4a64d472466b612b4f34fb1","isMergeCommit":false,"messageTitle":"Ui: Remove unused output methods","messageBody":"The console UI retains specialized output methods that no caller uses\nafter command responses move into Alex. Keeping them duplicates response\nformatting and obscures the active UI surface.\n\nRemove the dead methods and their now-unused imports so Ui contains only\nthe output paths used by the application.\n","fileTypesAndContributionMap":{"java":{"insertions":0,"deletions":85}}},{"hash":"cae814aa8cc69d78f72ade639b3d4bee4a8bf3db","isMergeCommit":false,"messageTitle":"Alex: Consolidate task list formatting","messageBody":"List and find responses duplicate the same numbering and formatting\nloop. This makes a presentation change easy to apply inconsistently.\n\nCentralize the shared formatting in one helper while keeping each\ncommand responsible for selecting its heading and tasks.\n","fileTypesAndContributionMap":{"java":{"insertions":8,"deletions":15}}},{"hash":"291bb5879b72634801d9c5ab8414fac5169b1a07","isMergeCommit":false,"messageTitle":"Alex: Clarify loading error name","messageBody":"The name loadingError does not reveal whether it stores an\nexception, a status, or display text, and the local name error is even\nless specific.\n\nRename both values to identify them as the message produced when task\nloading fails, making their role clear at each use site.\n","fileTypesAndContributionMap":{"java":{"insertions":8,"deletions":8}}},{"hash":"a15bea453e166a3e1c4c4253f4709a738c17fa81","isMergeCommit":false,"messageTitle":"Parser: Name task date markers","messageBody":"The date markers are repeated as unexplained string literals when\nlocating and slicing command arguments. A marker change could leave\nparsing offsets or error messages inconsistent.\n\nIntroduce named constants for each marker and use them throughout\ndeadline and event parsing so their meaning and relationships are\nexplicit.\n","fileTypesAndContributionMap":{"java":{"insertions":18,"deletions":9}}},{"hash":"34b15d3b83061f7dbc1c2738b092c582721e6ae3","isMergeCommit":false,"messageTitle":"Storage: Name serialized task fields","messageBody":"Task deserialization relies on numeric indexes, status flags, field\ncounts, and a split limit whose meanings are not evident at their use\nsites. These magic literals make the file format difficult to review.\n\nReplace them with grouped constants that describe each serialized field\nand format rule while preserving the existing on-disk representation.\n","fileTypesAndContributionMap":{"java":{"insertions":39,"deletions":16}}},{"hash":"cc46b40adb05c0ffac25ea93a97ef6a2b3b866e1","isMergeCommit":false,"messageTitle":"Task: Simplify status icon expression","messageBody":"The trailing comment repeats the method Javadoc and the ternary\nexpression, while unnecessary parentheses add visual noise.\n\nKeep the expression self-explanatory and rely on the existing method\ncontract to document the returned status icons.\n","fileTypesAndContributionMap":{"java":{"insertions":1,"deletions":1}}},{"hash":"ff72d612ad4edbd3b3ef02f1b5069933649d2a8e","isMergeCommit":false,"messageTitle":"Storage: Separate task loading steps","messageBody":"loadTasks combines file access, iteration, deserialization, status\nrestoration, and error decoration in one long method. Mixing those\nabstraction levels obscures the normal loading path.\n\nExtract file reading and single-line parsing into focused methods so\nloadTasks presents only the high-level sequence while retaining\nline-specific errors.\n","fileTypesAndContributionMap":{"java":{"insertions":43,"deletions":22}}},{"hash":"efabac233c4d2012ae5baa63969d84f1bab7a180","isMergeCommit":false,"messageTitle":"Tests: Remove redundant method comments","messageBody":"The test method names already state the behavior and expected outcome.\nTheir Javadocs repeat that information and add maintenance noise.\n\nRemove the redundant method comments while retaining class-level\ndocumentation that explains each test suite\u0027s scope.\n","fileTypesAndContributionMap":{"java":{"insertions":0,"deletions":70}}},{"hash":"32d0749fa02516ff0c4db91928c820a0caa0148a","isMergeCommit":false,"messageTitle":"Main: Normalize import spacing","messageBody":"The package declaration and import block are separated by two blank\nlines, which breaks the file\u0027s otherwise consistent source layout.\n\nRemove the extra blank line so the import groups follow the project\u0027s\nstandard spacing.\n","fileTypesAndContributionMap":{"java":{"insertions":0,"deletions":1}}},{"hash":"ae19a89440573678c2fb11d31068a2b2618f2ea4","isMergeCommit":false,"messageTitle":"Use stream to parse command types","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":8,"deletions":15}}},{"hash":"8a014f72fe047aa9dcc3dcbd1ff4155c6742b0da","isMergeCommit":true,"messageTitle":"Merge pull request #1 from jiangyuning07/branch-A-Assertions","messageBody":"Add assertions for important invariants","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"82186d1758dad0b3323eefd91c917f8e046bdbd9","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"5f3093c02af2ff411cdde2de05dc2c821d8c8c7b","isMergeCommit":true,"messageTitle":"Merge pull request #2 from jiangyuning07/branch-A-CodeQuality","messageBody":"Improve code quality","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"9ad1c7c0d71e914a25389bdec98ec09a97600415","isMergeCommit":true,"messageTitle":"Merge pull request #3 from jiangyuning07/branch-A-Streams","messageBody":"Use stream to parse command types","tags":["A-Streams"],"fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionMap":{"jiangyuning07":{"java":1473,"md":192,"fxml":87,"sh":0,"bat":0,"gradle":21,"txt":0}},"authorContributionVariance":{"jiangyuning07":61820.34},"authorDisplayNameMap":{"jiangyuning07":"CS2103T-T14-2 JIAN..NING"}}
