xml":{"insertions":76,"deletions":37},"java":{"insertions":2,"deletions":1}}},{"hash":"f1f0458dd6a6b264ef680d226954c4551d0f0a7b","isMergeCommit":false,"messageTitle":"Change dropshadows and innershadows","messageBody":"","fileTypesAndContributionMap":{"fxml":{"insertions":30,"deletions":16},"java":{"insertions":13,"deletions":4}}}]},{"date":"2026-09-09T00:00:00","commitResults":[{"hash":"f8eea18b3f25dc77a7fc99a8a6c04f6a06685ca3","isMergeCommit":false,"messageTitle":"Add assertions to document code invariants","messageBody":"Task operations and persistence rely on valid indices, task formats, and\nFXML-injected controls, but these assumptions are not explicit.\n\nLet\u0027s make these assumptions executable with assertions so violations are detected\nduring development without changing normal runtime behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":35,"deletions":7}}},{"hash":"368476a5357c036baab20bfb17496dfc50f4e22c","isMergeCommit":false,"messageTitle":"MemoryHandler: Extract memory line processing","messageBody":"MemoryHandler.readMemory handles file I/O, blank-line filtering,\nrecord validation, task creation, and completion-state restoration in\none nested method.\n\nThe mixed abstraction levels make the loading flow harder to follow and\nincrease maintenance risk.\n\nExtract line processing, shared validation, and task creation into\nfocused private methods. Preserve the existing behavior of stopping at\nunknown task types and reporting malformed records.\n\nKeep the refactoring behavior-preserving so future changes to memory\nparsing can be made in smaller, easier-to-review methods.\n","fileTypesAndContributionMap":{"java":{"insertions":60,"deletions":39}}},{"hash":"21dcb289956d97b89dc36ad110153deae7a80c5c","isMergeCommit":false,"messageTitle":"Commands: Reuse shared validation logic","messageBody":"DeadlineCommand and EventCommand each define a private checkEmpty\nmethod with the same validation flow and only command-specific messages\ndiffering.\n\nThe duplicated implementations make validation changes harder to\nmaintain and can cause equivalent commands to produce\ninconsistent behavior.\n\nExtract the common exception-building logic into CommandValidator.\nPass each command\u0027s specific name, message, and usage text to it.\n\nKeep command-specific diagnostics at the call sites while\ncentralizing the shared validation behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":36,"deletions":58}}},{"hash":"9c9d4660d8b36ed899b6afde34af78334018cb76","isMergeCommit":false,"messageTitle":"Commands: Centralize word joining","messageBody":"Several command implementations repeat the same loop to join a range\nof input words.\n\nThe duplicated loops obscure the parsing logic and make command text\nhandling harder to maintain consistently.\n\nExtract the range-joining operation into CommandText. Reuse it across\nthe todo, find, deadline, and event commands. Remove the unused\nStringType enum left behind by the validation refactoring.\n\nPreserve the existing word ranges and trimming behavior so command\noutput remains unchanged.\n","fileTypesAndContributionMap":{"java":{"insertions":24,"deletions":42}}},{"hash":"28429b82578de7909accaafef467930701be6e07","isMergeCommit":false,"messageTitle":"Commands: Centralize task-index parsing","messageBody":"MarkCommand, UnmarkCommand, and DeleteCommand duplicate the logic for\nsplitting input, parsing a task index, validating its range, and\nreporting out-of-bounds errors.\n\nThe repeated validation code makes changes harder to apply consistently\nand leaves each command responsible for parsing details unrelated to its\naction.\n\nExtract task-index parsing and validation into TaskIndexParser. Keep the\ncommands focused on handling missing indices and invoking their\ntask-list operation.\n\nPreserve the existing one-based indexing, error messages, and\nempty-input behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":32,"deletions":35}}},{"hash":"f7dad40dee534ca8defa73d5f8a3d14dd7f7a929","isMergeCommit":false,"messageTitle":"MainWindow: Fix dialog indentation","messageBody":"MainWindow.addDialogs contains a dialog-container update and a scroll\noperation, but the latter is indented outside the input guard.\n\nThe incorrect indentation makes the method\u0027s control flow misleading and\ncauses Checkstyle to reject the code.\n\nIndent the scroll operation within the guard so the source layout\nmatches the existing execution scope.\n\nKeep the behavior unchanged while restoring a clean Checkstyle result.\n","fileTypesAndContributionMap":{"java":{"insertions":1,"deletions":1}}},{"hash":"6eae936f2f3dc3886c03963b4f59bdba825bf82a","isMergeCommit":false,"messageTitle":"MainWindow: Consolidate intro display","messageBody":"MainWindow.showIntroMessage duplicates the dialog insertion logic\nfor the default and secret greetings, with only the message text\ndiffering.\n\nThe repeated branches make the method longer and require both\npaths to be updated when the intro dialog behavior changes.\n\nStore the greeting text in named constants and select the appropriate\nmessage before performing one dialog insertion.\n\nPreserve both greeting variants and their existing display behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":15,"deletions":16}}}]},{"date":"2026-09-10T00:00:00","commitResults":[{"hash":"0f45a1114ca0ae84715c6313e1c2d8aeacaab562","isMergeCommit":false,"messageTitle":"Add streams","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":11,"deletions":18}}},{"hash":"2ff06dcc5c57064c4aedd97eb2522cf7eeb6c86c","isMergeCommit":true,"messageTitle":"Merge pull request #1 from PenguinsGoWild/branch-A-Streams","messageBody":"Add streams","tags":["A-Streams"],"fileTypesAndContributionMap":{}},{"hash":"b0a2a253956324441f3568de5ee683dfa13a4e5d","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Assertions","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"4a9