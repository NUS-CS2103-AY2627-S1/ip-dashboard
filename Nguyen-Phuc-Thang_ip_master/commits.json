ertions":8,"deletions":0}}},{"hash":"8f5ebfa181d21081e0455f7e0317cfbf12923fb2","isMergeCommit":false,"messageTitle":"Assert command-dispatch contracts","messageBody":"The router assumes that every command type has an implementation.\nMissing registrations or null results are programming errors.\nInvalid user input remains on the normal exception path.\n\nAdd Java assertions for registry coverage, command lookup, and response\nmessages. This makes broken dispatch contracts fail early.\n","fileTypesAndContributionMap":{"java":{"insertions":6,"deletions":1}}},{"hash":"5427f8e3aaa94395e773853d9f6fcce234df34fa","isMergeCommit":false,"messageTitle":"Assert date-range parsing contracts","messageBody":"Event listing assumes date parsing produces exactly two ordered dates.\nParser regressions can cause unsafe array access or invalid filters.\n\nAdd Java assertions at parser and command boundaries. This documents the\ntwo-date result and the ordering established by input validation.\n","fileTypesAndContributionMap":{"java":{"insertions":6,"deletions":0}}},{"hash":"bc49bc895114a1b71492b982e5792a5a4cccaaaf","isMergeCommit":false,"messageTitle":"Assert task persistence contracts","messageBody":"Storage assumes each task produces a usable record and that event data\ndecodes into a start/end pair. Violations indicate broken internal\nserialization contracts.\n\nAdd Java assertions around task serialization and event-time decoding.\nMake persistence contract failures explicit during development.\n","fileTypesAndContributionMap":{"java":{"insertions":4,"deletions":0}}},{"hash":"a4183238832c65aa2bcc1f7a7575ef3a904dc8c5","isMergeCommit":false,"messageTitle":"Commands: Extract shared task index parser","messageBody":"Mark, unmark, and delete commands duplicate the same task number\nvalidation and conversion logic.\n\nDuplicated validation can diverge as the commands evolve, causing\ninconsistent syntax errors and task selection behavior.\n\nExtract the shared logic into TaskIndexParser and use it from all three\ncommands. Add focused tests to preserve the existing validation and\none-based-to-zero-based conversion behavior.\n\nA package-private parser keeps the behavior centralized without exposing\nan implementation detail outside the command package.\n","fileTypesAndContributionMap":{"java":{"insertions":136,"deletions":79}}},{"hash":"a75d08a9afb20f3e0895fe75255e7379fa308b76","isMergeCommit":false,"messageTitle":"Task storage: Make serialized data explicit","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":489,"deletions":113}}},{"hash":"e6a1e88f6746a854d4bf6e04ff6dfd3b75151994","isMergeCommit":false,"messageTitle":"Storage: Separate persistence workflow steps","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":138,"deletions":29}}},{"hash":"d2d78a9b7d36819a2dfe43f7fb8212dd6a7d0edd","isMergeCommit":false,"messageTitle":"Task queries: Clarify filtering contracts","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":166,"deletions":60}}},{"hash":"bd114d20591e2f0e2e13ff713d42b834d476ed69","isMergeCommit":false,"messageTitle":"Commands: Clarify parsing and usage guidance","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":81,"deletions":24}}},{"hash":"e8f44f7369792eab61b5834d1246555f36da3b43","isMergeCommit":false,"messageTitle":"UI: Simplify application orchestration","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":30,"deletions":16}}},{"hash":"2860b6c2c4116f54bcadb7e3a10122ad0bf2fb01","isMergeCommit":false,"messageTitle":"Use stream pipeline for task formatting","messageBody":"Generate numbered task lines with IntStream and join them directly, removing the intermediate mutable list while preserving output order.\n","fileTypesAndContributionMap":{"java":{"insertions":5,"deletions":5}}},{"hash":"3bed95a367e174534ad26a15c264a4e15e6048a8","isMergeCommit":true,"messageTitle":"Merge pull request #1 from Nguyen-Phuc-Thang/branch-A-Assertions","messageBody":"branc