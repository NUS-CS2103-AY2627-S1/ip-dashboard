nge output with the expected format.\n","fileTypesAndContributionMap":{"java":{"insertions":9,"deletions":8}}},{"hash":"9c12ca9efb4b053435649502265e94ce5c57d9ef","isMergeCommit":false,"messageTitle":"Add commands to clear chat and tasks","messageBody":"Users currently have no quick way to reset the conversation or remove tasks by category.\n\nClear the displayed conversation when clear is entered.\n\nRemove todos, deadlines, or events using category-specific commands.\n\nSupport clearing all tasks and persist the updated task list.\n\nAdd tests for selective and complete task clearing.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"java":{"insertions":86,"deletions":1}}}]}]},"authorFileTypeContributionMap":{"yx-0000":{"java":850,"md":74,"fxml":0,"sh":0,"bat":0,"gradle":20,"txt":0}},"authorContributionVariance":{"yx-0000":25501.283},"authorDisplayNameMap":{"yx-0000":"CS2103T-F12-4 YU Y..UXIN"}}
