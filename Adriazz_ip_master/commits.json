:{}},{"hash":"3f6e77c53c49eec7d8d182d02840142f273560a6","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-9\u0027","messageBody":"","tags":["Level-9"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-04T00:00:00","commitResults":[{"hash":"933033dd974176db4b39cb96018c9305970f2fa4","isMergeCommit":false,"messageTitle":"Fix checkstyle issues","messageBody":"","tags":["A-CheckStyle"],"fileTypesAndContributionMap":{"gradle":{"insertions":5,"deletions":0},"java":{"insertions":117,"deletions":65}}}]},{"date":"2026-09-05T00:00:00","commitResults":[{"hash":"886adc873ee2436983a2a5a891493dae7a0955ef","isMergeCommit":false,"messageTitle":"Integrate GUI","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":15,"deletions":2},"fxml":{"insertions":41,"deletions":0},"java":{"insertions":538,"deletions":81}}},{"hash":"a8a0e0efa5cfed21cefe8b90d9e390b500a52585","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-10\u0027","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-11T00:00:00","commitResults":[{"hash":"63078663cccdf626dbd12fabb9f37f496c28e53b","isMergeCommit":false,"messageTitle":"Add assertions to document internal invariants","messageBody":"Add assert statements at points where failure should only be\npossible due to a bug in this codebase, not user input, since\nthese are distinct from the NimbusException checks used for\ninput validation.\n\n- Nimbus: assert commandType is non-null after a successful\n  parse, since Parser.parseCommand() either returns a valid\n  Command or throws before returning.\n- Nimbus: assert the TaskList loaded from Storage is non-null.\n- Storage: assert filePath is non-null in the constructor, since\n  Storage is only ever constructed internally with a hardcoded\n  path.\n- TaskList: assert the tasks list passed to the constructor is\n  non-null, since callers such as Storage.readFromFile() should\n  always supply a valid list.\n","fileTypesAndContributionMap":{"java":{"insertions":4,"deletions":0}}},{"hash":"c215e46eeafc2b85b403b38446956096dc6e7814","isMergeCommit":false,"messageTitle":"Update build.gradle to support assert","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":1,"deletions":0}}},{"hash":"31a515e203caa21b2f2010eff99f7e304114eff2","isMergeCommit":false,"messageTitle":"Refactor long methods for single level of abstraction","messageBody":"Nimbus.getResponse, Task.fromFileString, and TaskList\u0027s index-\nchecking methods each mix several levels of abstraction in one\nmethod body.\n\nParsing, dispatch, state mutation, and formatting sit inline\nnext to each other, instead of being named as separate steps.\n\nThis makes the methods harder to read at a glance, since a\nreader has to track low-level details (string splitting, array\nindexing) alongside high-level flow (which command runs, which\ntask type gets built) at the same time.\n\nLet\u0027s extract each mixed method into named helper methods, one\nper distinct step, so each method reads as a short sequence of\ncalls at a single level. Specifically:\n* Nimbus: extract a handle*Command method per command that\n  previously combined parsing, mutation, and formatting inline.\n* Task: split fromFileString into createTaskFromParts and\n  applyDoneStatus.\n* TaskList: extract requireValidIndex from four methods that\n  repeated the same bounds check.\n\nSwitch cases that already call a single method (LIST, FIND,\nBYE) are left inline, since extracting those would add a layer\nof indirection without separating any abstraction levels.\n\nHelper methods are kept private, since they are internal\nimplementation details, not part of any class\u0027s public API.\n","fileTypesAndContributionMap":{"java":{"insertions":132,"deletions":68}}},{"hash":"afef8567e2217536868d0c39280a3f76c7b65fa0","isMergeCommit":true,"messageTitle":"Merge pull request #1 from Adriazz/branch-A-Assertions","messageBody":"Add assertions","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"a91eb34327259f1ef5b17076a2ef91f660d03d50","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"798ebad482c4790461ed3a4af2aa1ce593918904","isMergeCommit":true,"messageTitle":"Merge pull request #2 from Adriazz/branch-A-CodeQuality","messageBody":"Refactor code to match code quality standards","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"a73b22ab812432c4bf55264b0c56d798362f4554","isMergeCommit":false,"messageTitle":"Add duplicate detection feature","messageBody":"","tags":["BCD-Extension","A-FullCommitMesssage"],"fileTypesAndContributionMap":{"java":{"insertions":35,"deletions":1}}}]}]},"authorFileTypeContributionMap":{"Adriazz":{"java":1551,"md":2,"fxml":41,"sh":0,"bat":0,"gradle":22,"txt":0}},"authorContributionVariance":{"Adriazz":43303.188},"authorDisplayNameMap":{"Adriazz":"CS2103T-T10-2 ADRI..KANG"}}
