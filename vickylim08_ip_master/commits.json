utionMap":{"txt":{"insertions":0,"deletions":5}}},{"hash":"0c80226a69e74277d09bfe48d268686f02fa152a","isMergeCommit":false,"messageTitle":"Add varagrs to TaskList","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":19,"deletions":11}}},{"hash":"e9486815de2b5c57b93195ff9d0e70ca2c766997","isMergeCommit":true,"messageTitle":"Merge branch varargs","messageBody":"","tags":["A-Varargs"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-09T00:00:00","commitResults":[{"hash":"b558299840ecfedb23a0d44c4113b5de1bf072f9","isMergeCommit":false,"messageTitle":"  Add assertions for task invariants","messageBody":"  Add development-time assertions at task, task-list, storage, and loading\n  boundaries to detect null values and broken internal assumptions early.\n\n  Cover the new contracts with tests for null storage results and null task\n  entries. These checks help catch invalid state while preserving existing\n  task-management behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":56,"deletions":1},"md":{"insertions":58,"deletions":0}}},{"hash":"310cebd0a4d5624fa1912e7d93075b95cc9b406b","isMergeCommit":false,"messageTitle":"Extract shared task rendering logic","messageBody":"  Extract the common numbered-task formatting used by both list and find\n  responses into one private helper.\n\n  Keeping the heading-specific methods as small delegates removes duplicated\n  loop and response-formatting logic. This makes future display changes\n  consistent across both commands and keeps the rendering behavior unchanged.\n","fileTypesAndContributionMap":{"java":{"insertions":51,"deletions":10}}},{"hash":"434ea16444adfab3b13fdf2ff77421973a4aea7e","isMergeCommit":false,"messageTitle":"Wrap long event help text","messageBody":"  Split the event-command description across adjacent string literals while\n  preserving the exact user-facing help text.\n\n  The previous literal exceeded the 120-character Java style limit and\n  caused the main Checkstyle task to fail. Add a regression assertion so\n  future formatting edits do not accidentally remove or alter the event\n  command documentation.\n","fileTypesAndContributionMap":{"java":{"insertions":4,"deletions":1}}},{"hash":"181d59f38d69620bd0dcdce4ee814a32ac5d2378","isMergeCommit":false,"messageTitle":"Use the shared exit message constant","messageBody":"  Update showExit() to use Ui.EXIT_TEXT instead of repeating the same\n  message literal.\n\n  This removes dead configuration and leaves one source of truth for the\n  exit message, so future wording changes are less likely to update only\n  one path. Existing bye-command coverage confirms that the user-visible\n  output is unchanged.\n","fileTypesAndContributionMap":{"java":{"insertions":1,"deletions":1}}},{"hash":"0733b81271a6e666dadb800b42567aecb4565533","isMergeCommit":false,"messageTitle":"  Preserve separators in stored descriptions","messageBody":"  Reconstruct descriptions from all serialized fields before trailing date\n  fields instead of assuming descriptions never contain the storage\n  separator.\n\n  This keeps todo, deadline, and event descriptions intact when they include\n   | , preventing silent truncation or failed task loading after a\n  restart. Add temporary-path storage tests covering descriptions,\n  completion state, and date fields without modifying the real data file.\n","fileTypesAndContributionMap":{"java":{"insertions":133,"deletions":20}}},{"hash":"aaceaa8cab23108c4e4e9beb386bc5adc5c265f9","isMergeCommit":false,"messageTitle":"Fix test import ordering","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":1,"deletions":0}}},{"hash":"cd06ba380313f389768bc788ef225cbec41e68a3","isMergeCommit":false,"messageTitle":"Name scroll pane bottom spacing","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":3,"deletions":1}}}]},{"date":"2026-09-10T00:00:00","commitResults":[{"hash":"8fbfa9b9e6d5a3a2219b9e3ea06dae039dc1aa89","isMergeCommit":false,"messageTitle":"Extract task-specific storage parsing","messageBody":"  Move deadline and event reconstruction into focused helper methods while\n  leaving createTask responsible for selecting the task type.\n\n  This keeps each method at a single level of abstraction and makes the\n  storage flow easier to scan and extend. Add a malformed-date regression\n  test to ensure the refactoring preserves LunaException-based error\n  handling.\n","fileTypesAndContributionMap":{"java":{"insertions":46,"deletions":13}}},{"hash":"e3886e6b544f2141e0df05ab28f9b7c2316aeb4d","isMergeCommit":false,"messageTitle":"Use stream to serialize tasks","messageBody":"  Replace the manual accumulation loop in Storage.saveTasks with a stream\n  that maps each task to its storage representation.\n\n  The operation is a direct one-to-one transformation, so map expresses the\n  intent more clearly and removes mutable intermediate state without\n  changing the saved output.\n","fileTypesAndContributionMap":{"java":{"insertions":3,"deletions":5}}},{"hash":"8bf28764ae5331df86c5bfaad0602010ec555ad3","isMergeCommit":true,"messageTitle":"Merge pull request #1 from vickylim08/branch-A-Assertions","messageBody":"  Add assertions for task invariants","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"f4b9d65cd9acfe30c483d43695094ff905a3cf88","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"07c434863e350a51bb83195c447a0e1dd1c2277a","isMergeCommit":true,"messageTitle":"Merge pull request #2 from vickylim08/branch-A-CodeQuality","messageBody":"Branch a code quality","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"0a9b19a60b78cb107f9b35f29f74a5818ef254c8","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"2a1c379e842d3d8d94d25fd7eb2db08b3f0ad0b4","isMergeCommit":true,"messageTitle":"Merge pull 