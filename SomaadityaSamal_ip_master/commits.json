ileTypesAndContributionMap":{"java":{"insertions":273,"deletions":2}}},{"hash":"26b20bb7301d5f8a6ee1736bbe6984bcf1a21bf7","isMergeCommit":true,"messageTitle":"Merge A-MoreTesting","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"509b65895a3751a75c78956ebeeafd6e74ae84bb","isMergeCommit":false,"messageTitle":"Give Friday a composed assistant personality","messageBody":"Use concise, formal responses and a cyan-and-gold interface that complement Friday\u0027s capable AI-assistant identity without obscuring task information.\n","fileTypesAndContributionMap":{"fxml":{"insertions":1,"deletions":1},"java":{"insertions":42,"deletions":68}}},{"hash":"082fdb5e6af0ebae17352db0d8115dfdd8977c17","isMergeCommit":true,"messageTitle":"Merge A-Personality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"06f6dcf4294d5366d2c862c9c5739d97b3ac6885","isMergeCommit":false,"messageTitle":"Enable manual chat scrolling","messageBody":"Keep automatic scrolling when new messages arrive while allowing the JavaFX scroll pane to respond to mouse-wheel and trackpad gestures.\n","tags":["A-Personality"],"fileTypesAndContributionMap":{"java":{"insertions":2,"deletions":1}}},{"hash":"b25548d003166f05e68cb5eb31f4e30634f1b6e4","isMergeCommit":true,"messageTitle":"Merge A-Personality scrolling update","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"eb628521b4d99f2028dd1116b95ef3653703e8da","isMergeCommit":false,"messageTitle":"Add FRIDAY user guide and product screenshot","messageBody":"Document installation, every supported command, error behavior, and local storage. Replace the template branding and include a full-window screenshot for the product website.\n","tags":["A-UserGuide"],"fileTypesAndContributionMap":{"md":{"insertions":123,"deletions":34}}},{"hash":"dceb181119e664b433d3794910bd069e2a3aba6a","isMergeCommit":true,"messageTitle":"Merge A-UserGuide","messageBody":"","tags":["v0.2"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-18T00:00:00","commitResults":[{"hash":"455ef3f0ffefb35d49a4c9c2cc5dd3b0f9124ee9","isMergeCommit":false,"messageTitle":"Fix task persistence and recurring task behavior","messageBody":"Smoke testers found that pipe characters could erase saved tasks and\nthat recurring tasks never produced their next occurrence.\n\nReject reserved input, protect unreadable saves, and roll back failed\nwrites. Generate persistent successors without duplicate completion\neffects, omit completed reminders, and support description editing.\nReplace the malformed greeting art and cover the failures with tests.\n","fileTypesAndContributionMap":{"java":{"insertions":297,"deletions":20}}},{"hash":"e4cc464a915f2c8f040b28b1f9fe7e85088e56e5","isMergeCommit":false,"messageTitle":"Bundle JavaFX for both Mac architectures","messageBody":"The release failed on Apple Silicon with a plain Java 25 installation\nbecause its bundled Mac libraries only supported Intel processors.\n\nKeep architecture-specific native libraries separate inside one fat\nJAR and select the matching libraries before JavaFX starts. Preserve\nthe existing Windows and Linux libraries in the same release asset.\n","fileTypesAndContributionMap":{"gradle":{"insertions":22,"deletions":0},"java":{"insertions":39,"deletions":1}}},{"hash":"7c792b8cba6970562586396aa9fca67dbd1fd3db","isMergeCommit":false,"messageTitle":"Document release fixes and grading checks","messageBody":"Explain editing, recurrence, reserved characters, and save recovery\nso the user guide matches the corrected behavior. Refresh the full\nwindow screenshot and link directly to the latest release.\n\nRecord grading evidence and verification limits rather than treating\na passing build as a guarantee of full marks.\n","tags":["v0.3"],"fileTypesAndContributionMap":{"md":{"insertions":71,"deletions":3}}},{"hash":"60481eff5e9de32d3b1473a9e7aebc7992e72bec","isMergeCommit":false,"messageTitle":"Restore the ASCII welcome banner","messageBody":"Keep Friday\u0027s ASCII identity instead of replacing it with plain text.\nUse a dedicated monospace welcome style and a compact font size to\npreserve alignment at the minimum window width.\n\nAdd a regression test to keep the banner ahead of the greeting.\n","tags":["v0.4"],"fileTypesAndContributionMap":{"java":{"insertions":27,"deletions":2}}}]}]},"authorFileTypeContributionMap":{"SomaadityaSamal":{"java":2658,"md":271,"fxml":60,"sh":0,"bat":0,"gradle":42,"txt":8}},"authorContributionVariance":{"SomaadityaSamal":90581.234},"authorDisplayNameMap":{"SomaadityaSamal":"CS2103T-W13-3 SAMA..ITYA"}}
