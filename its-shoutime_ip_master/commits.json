e506b3dc2770","isMergeCommit":false,"messageTitle":"Use LocalDate instead of String","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":272,"deletions":11},"md":{"insertions":35,"deletions":37}}},{"hash":"9537d12a05f00a56493140d3c4d4fa2322b713d8","isMergeCommit":false,"messageTitle":"Add on command","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":136,"deletions":53},"md":{"insertions":92,"deletions":27}}},{"hash":"a28ad4ef5ce31e76a1ea3f69e98c3641813aba7d","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-8\u0027","messageBody":"","tags":["Level-8"],"fileTypesAndContributionMap":{}},{"hash":"a2fd0cf4fb8600f0118f90f2821ac1ff27407f52","isMergeCommit":false,"messageTitle":"Extract Ui class for console I/O","messageBody":"Move welcome/goodbye, command reading, error display, and task\nconfirmation messages out of Kiwi into a dedicated Ui class so\nuser interaction is separated from command handling and task logic.\nBehaviour is unchanged; this is the first step toward the Level-9\nOOP structure (Ui, Storage, Parser, TaskList).\n\nCo-authored-by: Cursor \u003ccursoragent@cursor.com\u003e\n","fileTypesAndContributionMap":{"java":{"insertions":159,"deletions":66}}},{"hash":"bc8d0c2e8715a5e94cfecd46ed4dc9a58bbebbeb","isMergeCommit":false,"messageTitle":"Extract TaskList to own the in-memory tasks","messageBody":"Wrap ArrayList operations (add, delete, get, mark, size, index\nchecks) in TaskList so Kiwi no longer manages the raw list.\nUi now displays via TaskList instead of ArrayList. Persistence and\nmessages stay in Kiwi so TaskList stays free of I/O concerns.\n\nCo-authored-by: Cursor \u003ccursoragent@cursor.com\u003e\n","fileTypesAndContributionMap":{"java":{"insertions":115,"deletions":24}}},{"hash":"2f328181eb6b2602dd787c91faa990a043a6167e","isMergeCommit":false,"messageTitle":"Extract Parser to interpret user commands","messageBody":"Move command recognition and argument parsing (todo/deadline/event/on\nand task numbers) into Parser, which returns a ParsedCommand. Kiwi\nonly executes: update TaskList, save, and show UI feedback. Index\nrange checks stay with the list so Parser stays free of TaskList\ndependencies.\n\nCo-authored-by: Cursor \u003ccursoragent@cursor.com\u003e\n","fileTypesAndContributionMap":{"java":{"insertions":240,"deletions":128}}},{"hash":"7c127d1043acf52ba4b126f27229b3349a4b9f6a","isMergeCommit":false,"messageTitle":"Wire Kiwi as instances with path-based Storage","messageBody":"Refactor Kiwi to match the Level-9 sample shape: constructor takes a\nfile path, holds Ui/Storage/TaskList as fields, and run() drives the\nloop. Storage is now constructed with that path instead of a hardcoded\nstatic file, so save location is injectable while default behaviour\nstays ./data/kiwi.txt.\n\nCo-authored-by: Cursor \u003ccursoragent@cursor.com\u003e\n","fileTypesAndContributionMap":{"java":{"insertions":72,"deletions":39}}},{"hash":"60020c1eddae6aae9c735fdd75d6c64bc6c1f4a9","isMergeCommit":true,"messageTitle":"Merge branch \u0027more-OOP\u0027","messageBody":"","tags":["A-MoreOOP"],"fileTypesAndContributionMap":{}},{"hash":"49e97db39bab325177ba79aafbb439fc2fb53743","isMergeCommit":false,"messageTitle":"Introduce Command pattern for chatbot actions","messageBody":"Replace ParsedCommand plus Kiwi.execute with an abstract Command and\nconcrete classes (Add, Delete, Mark, Unmark, List, On, Exit). Parser\nnow returns Command objects; Kiwi.run uses parse → execute → isExit\nwith try/finally dividers, matching the Level-10 stretch shape.\nUi.showGoodbye prints only the message so the loop owns the lines.\n\nCo-authored-by: Cursor \u003ccursoragent@cursor.com\u003e\n","fileTypesAndContributionMap":{"java":{"insertions":190,"deletions":166}}},{"hash":"e404d0d21fe9c6f140a9416cbf5ce00c715eff41","isMergeCommit":false,"messageTitle":"Organise into packages","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":103,"deletions":0},"md":{"insertions":3,"deletions":2}}},{"hash":"ade47c29debea1f3cfaed4e05248d982b91439a8","isMergeCommit":true,"messageTitle":"Merge branch \u0027packages\u0027","messageBody":"","tags":["A-Packages"],"fileTypesAndContributionMap":{}},{"hash":"ab0f936f7be800e54e89234704358330a6ac7a3b","isMergeCommit":true,"messageTitle":"Merge remote-tracking branch \u0027origin/add-gradle-support\u0027","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"f3d8c9d270e390933bf7bd41173102de453ae496","isMergeCommit":false,"messageTitle":"Use Gradle","messageBody":"","tags":["A-Gradle"],"fileTypesAndContributionMap":{"gradle":{"insertions":2,"deletions":2}}},{"hash":"38c9b28953a0e876730429665ba63618ee998579","isMergeCommit":false,"messageTitle":"Add JUnit tests","messageBody":"","tags":["A-Jar","A-JUnit"],"fileTypesAndContributionMap":{"gradle":{"insertions":1,"deletions":0},"java":{"insertions":610,"deletions":0},"md":{"insertions":11,"deletions":0}}},{"hash":"a9217901e733eda61dd21bcb53f4e7f5996172ab","isMergeCommit":false,"messageTitle":"Add JavaDoc comments","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":71,"deletions":0}}},{"hash":"8cf30ed58392e8c79f21d1fd1816f0becf4ddd26","isMergeCommit":false,"messageTitle":"Align Java sources with SE-EDU coding standard","messageBody":"Java sources use mixed import grouping, incomplete Javadoc tags, and\nswitch-case indentation that do not match the SE-EDU intermediate\nstandard.\n\nCourse work is assessed against that standard. Inconsistent style makes\nreviews harder and risks style-guide marks.\n\nLet\u0027s bring production and test Java into line with that standard.\n\nThe edits are style-only; program behavior is unchanged.\n\nCo-authored-by: Cursor \u003ccursoragent@cursor.com\u003e\n","fileTypesAndContributionMap":{"java":{"insertions":163,"deletions":137}}},{"hash":"1b4f533e1c396f79200b1a0e8326b3dcd04079a6","isMergeCommit":false,"messageTitle":"Add SE-EDU Java coding standard skill","messageBody":"Agents have only generic Javadoc guidance and no project rule that\npoints to the SE-EDU Java coding standard.\n\nCourse Java is judged against that standard. Without a mandatory skill\nand agent rule, generated code can drift from it.\n\nLet\u0027s add the seedu-java-coding-standard skill and require it in agent\nfiles for all Java work.\n\nCo-authored-by: Cursor \u003ccursoragent@cursor.com\u003e\n","fileTypesAndContributionMap":{"md":{"insertions":355,"deletions":1}}},{"hash":"8baa6a9f2fdf729176ee73302ae552447fc03599","isMergeCommit":false,"messageTitle":"Add SE-EDU Git conventions skill","messageBody":"Commit messages follow only a brief \"include rationale\" note. Visual\ndiffs still point at a missing craft-commit-message skill.\n\nCourse Git work is judged against the SE-EDU Git conventions. Agents\nneed a single mandatory skill so subjects, bodies, and branch names\nstay consistent.\n\nLet\u0027s add the seedu-git-standard skill and require it for all commits.\n\nCo-authored-by: Cursor \u003ccursoragent@cursor.com\u003e\n","fileTypesAndContributionMap":{"md":{"insertions":170,"deletions":3}}},{"hash":"20c51aac8eb6e769818b957900d28638dd828c34","isMergeCommit":false,"messageTitle":"Add find command to search tasks by keyword","messageBody":"Co-authored-by: Cursor \u003ccursoragent@cursor.com\u003e\n","fileTypesAndContributionMap":{"java":{"insertions":146,"deletions":3},"md":{"insertions":115,"deletions":2}}},{"hash":"ec2341bc60c7f37883dda835518d62e4b6c50e29","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-JavaDoc\u0027","messageBody":"","tags":["A-JavaDoc"],"fileTypesAndContributionMap":{}},{"hash":"f9b8f856d5ba26adc3a7957ece76779f8da6f397","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CodingStandard\u0027","messageBody":"","tags":["A-CodingStandard"],"fileTypesAndContributionMap":{}},{"hash":"b0f55ea3dec7fa8f099f96a54c4a7826bf106b3a","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-9\u0027","messageBody":"","tags":["Level-9"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-01T00:00:00","commitResults":[{"hash":"642ec8f4f80971b5f8e5d7ee1c74e490da657af2","isMergeCommit":false,"messageTitle":"Add Checkstyle","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":5,"deletions":0},"java":{"insertions":19,"deletions":19}}},{"hash":"18e21c9105804425408a785a3c5fb7361c24524b","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-checkstyle\u0027","messageBody":"","tags":["A-Checkstyle"],"fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionMap":{"its-shoutime":{"java":2029,"md":1717,"fxml":0,"sh":0,"bat":0,"gradle":8,"txt":0}},"authorContributionVariance":{"its-shoutime":657146.6},"authorDisplayNameMap":{"its-shoutime":"CS2103T-T15-4 CHEN..U\u0027AN"}}
