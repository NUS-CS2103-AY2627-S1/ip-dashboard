s"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-10T00:00:00","commitResults":[{"hash":"e811470295c6dcf4d9d9200a9b934a4cbd352efb","isMergeCommit":false,"messageTitle":"Add assertions","messageBody":"","tags":["A-Assertions"],"fileTypesAndContributionMap":{"java":{"insertions":90,"deletions":0}}},{"hash":"422246e3b72978e0d9de5d57d7af0aa00849c2d0","isMergeCommit":false,"messageTitle":"Remove obsolete console UI methods","messageBody":"Response construction now belongs to Tony so the console and GUI can\nshare the same output. Keeping the earlier Ui formatting methods leaves\ndead, duplicated behavior that can drift from the active response path.\n\nRemove those unused methods and their imports to keep Ui focused on the\nconsole input and output operations that Tony still calls.\n","fileTypesAndContributionMap":{"java":{"insertions":0,"deletions":123}}},{"hash":"de4c1f1606c671c5fcd1fdba2b8446ae334b6e05","isMergeCommit":false,"messageTitle":"Separate command dispatch from response flow","messageBody":"getResponse mixes conversation-level exit and error handling with the\ndetails of dispatching every supported command. This obscures its main\ncontrol flow and gives the method multiple abstraction levels.\n\nMove non-exit dispatch to executeCommand so getResponse describes the\nresponse lifecycle concisely while preserving existing command behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":29,"deletions":24}}},{"hash":"e0b41f9c244948919808792ad34a79ccee46a7e0","isMergeCommit":false,"messageTitle":"Restrict access to task internals","messageBody":"Task exposes its state and storage escaping helper to subclasses, even\nthough subclasses do not use them. This permits future subclasses to\ndepend on representation details unnecessarily.\n\nMake the state private, mark the immutable description final, and keep\nthe helper private so Task remains responsible for its own invariants.\n","tags":["A-FullCommitMessage","A-CodeQuality"],"fileTypesAndContributionMap":{"java":{"insertions":3,"deletions":3}}},{"hash":"8b39c035b8cee6b6229f3804a84e7ae05a84470f","isMergeCommit":false,"messageTitle":"Use stream to filter matching tasks","messageBody":"TaskList.find uses a manual loop to collect matching tasks. The loop is\ncorrect, but a stream states the filtering operation more directly.\n\nReplace the loop with a filter pipeline. This preserves the matching\nbehavior and result order while making the method\u0027s intent clearer.\n","tags":["A-Streams"],"fileTypesAndContributionMap":{"java":{"insertions":3,"deletions":6}}},{"hash":"94c078681c255fef5f2ab99afd93c4bca76c34c9","isMergeCommit":true,"messageTitle":"Merge pull request #1 from Totonyny511/branch-A-Assertions","messageBody":"Add assertions","tags":["Merge-A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"e1087336aa28b3f386d1e1b19a245fa4c254e113","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"8412ba26c6888d4ec511f3c8ae9fff3e8100abee","isMergeCommit":true,"messageTitle":"Merge master into branch-A-Streams  and resolve conflicts","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"013b2d6452a5978888155f12d3757095baa939a2","isMergeCommit":true,"messageTitle":"Merge pull request #2 from Totonyny511/branch-A-CodeQuality","messageBody":"Branch a code quality","tags":["Merged-A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"3c6d2dc4f03ca668c8372eb8446934162e584c74","isMergeCommit":true,"messageTitle":"Merge pull request #3 from Totonyny511/branch-A-Streams","messageBody":"Use stream to filter matching tasks","fileTypesAndContributionMap":{}},{"hash":"b6fb2a8dff95b44084194838128dd60f13e67e9d","isMergeCommit":false,"messageTitle":"Support deleting multiple tasks","messageBody":"Users need a way to remove several selected tasks in one command\nwhile retaining the existing single-delete behavior.\n\nValidate every task number before mutation, delete against the original\nlist positions, and report removed tasks in list order. Add unit, CLI,\nand user-guide coverage for the new behavior.\n","tags":["BCD-Extension"],"fileTypesAndContributionMap":{"java":{"insertions":158,"deletions":7},"md":{"insertions":97,"deletions":0}}}]}]},"authorFileTypeContributionMap":{"Totonyny511":{"java":2130,"md":1289,"fxml":0,"sh":0,"bat":0,"gradle":78,"txt":0}},"authorContributionVariance":{"Totonyny511":312217.34},"authorDisplayNameMap":{"Totonyny511":"CS2103T-W10-2 ZHAN..ANYU"}}
