ecific task without browsing\nthe entire task list. Add keyword search to make locating tasks easier.\n\nLet\u0027s,\n* add a search command to the parser\n* search task descriptions case-insensitively\n* display matching tasks to the user\n* handle missing keywords and no matching tasks\n","fileTypesAndContributionMap":{"txt":{"insertions":2,"deletions":0},"java":{"insertions":62,"deletions":6}}},{"hash":"09959bb268c2f706f714019468ff69da0b11e76d","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-JavaDoc\u0027","messageBody":"","tags":["A-JavaDoc"],"fileTypesAndContributionMap":{}},{"hash":"bc2ec2fd244abb2b9227176d308dbf87263c15f0","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CodingStandard\u0027","messageBody":"","tags":["A-CodingStandard"],"fileTypesAndContributionMap":{}},{"hash":"05b5f3b5532b574f652a6aa5b8dd41975d24b36b","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-9\u0027","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"36fe2bd4a74163608665ee28a53f98e796e60364","isMergeCommit":false,"messageTitle":"docs: add Javadocs to Bags class","messageBody":"","tags":["Level-9"],"fileTypesAndContributionMap":{"txt":{"insertions":2,"deletions":0},"java":{"insertions":171,"deletions":34}}}]},{"date":"2026-08-25T00:00:00","commitResults":[{"hash":"8efefffad45e1e46007c04bf36b3cd8c3a60e3ae","isMergeCommit":false,"messageTitle":"FIx styling error","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":6,"deletions":0},"java":{"insertions":96,"deletions":86}}},{"hash":"47c6a6055e97e3052fd10a569276bd4cf5d58b26","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CheckStyle\u0027","messageBody":"","tags":["A-CheckStyle"],"fileTypesAndContributionMap":{}},{"hash":"30984c2565b90ee50a129e6a36a765e4c1b6262f","isMergeCommit":false,"messageTitle":"Refactor Bags to support JavaFX command processing","messageBody":"Bags currently relies on console-based input and output through Ui,\nwith task creation and echo functionality controlled by blocking\nwhile loops.\n\nThe application is being migrated to JavaFX, where blocking console\ninput prevents commands from being handled correctly through the GUI.\n\nAdd GUI interface and move UI Class logic to MainWindows class to handle user interactions.\nConfigure fxml files to set up GUI interface.\n","fileTypesAndContributionMap":{"gradle":{"insertions":15,"deletions":3},"txt":{"insertions":2,"deletions":1},"fxml":{"insertions":63,"deletions":0},"java":{"insertions":306,"deletions":224}}},{"hash":"36dbaf7ff0f8bce4eb785ca8058cb2abd6d63efe","isMergeCommit":false,"messageTitle":"Add profile picture for dialog boxes","messageBody":"","fileTypesAndContributionMap":{"txt":{"insertions":1,"deletions":0},"fxml":{"insertions":36,"deletions":0},"java":{"insertions":83,"deletions":13}}},{"hash":"f453c04a1dd046e0099d4c2976551dc66f29e449","isMergeCommit":false,"messageTitle":"The dialogue box and chat layout have basic components without consistent styling.","messageBody":" The interface needs clearer visual organisation and a more pleasant appearance for users.\n\nAdd CSS styling for the dialogue box and chat layout, link the stylesheet to the relevant FXML files, and adjust the layout of the UI components.\n\nThe changes improve the overall readability and usability of the Bags chat interface without changing its underlying functionality.\n","fileTypesAndContributionMap":{"txt":{"insertions":0,"deletions":1},"fxml":{"insertions":18,"deletions":9},"java":{"insertions":20,"deletions":6}}},{"hash":"1308cf50ce0f5d8f9c54ff78cf0b0069217a0934","isMergeCommit":false,"messageTitle":"Update README.md","messageBody":"","fileTypesAndContributionMap":{"md":{"insertions":1,"deletions":0}}},{"hash":"864a6777f53a67d22f5ab260c7cb6e24c816dfd7","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-10\u0027","messageBody":"","tags":["branch-Level-10"],"fileTypesAndContributionMap":{}}]},{"date":"2026-08-30T00:00:00","commitResults":[{"hash":"95f72454d2d943dc143b00be6d211c99553c899b","isMergeCommit":false,"messageTitle":"Fix coding standard","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":22,"deletions":24}}}]},{"date":"2026-08-31T00:00:00","commitResults":[{"hash":"2523a52dc5afca536af53284aafb50d22d0b1825","isMergeCommit":false,"messageTitle":"Add assertions for all classes assumptions","messageBody":"The application relies on assumptions about non-null inputs,\nvalid task objects and synchronized tsk records. Without explicit checks,\nviolations in certain areas of code may cause failures in later execution.\n\nLet\u0027s add assertions to parser, storage, tasks, and main application classes\nto document and verify the assumptions during the building phase.\n\nUsing assertions will highlight explicit points where the assumption fails\nand running test cases.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"gradle":{"insertions":2,"deletions":0},"java":{"insertions":292,"deletions":104}}},{"hash":"c9438f72f03f9b2bfda500b71e0ba250be364aaf","isMergeCommit":false,"messageTitle":"Refactor deadline class","messageBody":"The class violates the coding standard as createTask method is too long.\nLet\u0027s Extract the /by keyword search and command text construction from\ncreateTask into helper methods.\n\nThis reduces method length and separates\ndistinct parsing responsibilities, improving readability and maintainability\nwithout changing the existing behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":44,"deletions":22}}},{"hash":"38c8777ffa0953c3e8b5876dc30251befbc48b0e","isMergeCommit":false,"messageTitle":"Create Command enum","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":19,"deletions":16}}},{"hash":"fda9a43b1e4fe848fc8440d9a0af3a9c7b8981e6","isMergeCommit":false,"messageTitle":"Refactor event task parsing method","messageBody":"The method violates coding violation as there were missing spaces between file imports. The current method is too long as well and difficult to understand.\n\nLet\u0027s\n* Extract keyword lookup and command text construction from createTask\ninto helper methods.\n* Add spaces in between imports.\n\nThis reduces method length and separates parsing\nresponsibilities, improving readability without changing behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":56,"deletions":34}}},{"hash":"a63e4d3f0ce9fbc9dae83161ebc06279c8900e8d","isMergeCommit":false,"messageTitle":"Improve DialogBox formatting and error handling","messageBody":"There are coding violations in the class, with extra lines and general\nerror handling.\n\nLet\u0027s\n* change message for error handling\n* remove extra lines\n\nCorrect inconsistent Javadoc indentation and remove unnecessary blank\nlines to improve readability. Replace printStackTrace with a descriptive\nruntime exception makes it easier to understand the error context.\n","fileTypesAndContributionMap":{"java":{"insertions":65,"deletions":27}}},{"hash":"9e10595aeb7d918565d94bff82538f3e6e06121e","isMergeCommit":false,"messageTitle":"Fix MainWindow formatting and Javadoc conventions","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":13,"deletions":10}}},{"hash":"aac3eeaba433281623645f11a55ea28121b98807","isMergeCommit":false,"messageTitle":"Add missing Ui Javadocs","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":12,"deletions":6}}},{"hash":"c4e456acf8e4ac8947d874b932ab4cd61fbcba6d","isMergeCommit":false,"messageTitle":"Fix Bags formatting and naming conventions","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":6,"deletions":39}}},{"hash":"c9fefcb3d698d9e6f52e5fb5507a300d07b855c9","isMergeCommit":false,"messageTitle":"Fix ParseTest import formatting","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":15,"deletions":14}}},{"hash":"f1c6c3dcfc4ed9e3a0ad6fdcf0bfd8aa48cc8287","isMergeCommit":false,"messageTitle":"Fix StorageTest formatting conven