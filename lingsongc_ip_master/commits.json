,"deletions":10},"md":{"insertions":60,"deletions":1}}},{"hash":"ec7bc7481980f0d565213845930e8df8d6a36863","isMergeCommit":false,"messageTitle":"Add printing task on specific date","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":160,"deletions":32},"md":{"insertions":82,"deletions":6}}}]},{"date":"2026-08-27T00:00:00","commitResults":[{"hash":"61251a645d02b97342043b7959172928752c0322","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-8\u0027","messageBody":"","tags":["Level-8"],"fileTypesAndContributionMap":{}},{"hash":"f2d6b7626ff0686c48eeac4eb47139eefdeaf6b9","isMergeCommit":false,"messageTitle":"Extract console interactions into Ui","messageBody":"Move command input, response framing, and all user-facing output out of Soar and into a dedicated Ui class. This gives console interaction one clear owner while keeping Soar focused on coordinating commands, storage, and task operations. Preserve every existing message and separator so the refactoring does not change observable behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":156,"deletions":65}}},{"hash":"418c68ca480f0a29d14b0de1c7f849c40dd7e918","isMergeCommit":false,"messageTitle":"Extract command interpretation into Parser","messageBody":"Move command recognition, task-number validation, task construction, and date-query parsing from Soar into a dedicated Parser class. Keep CommandType focused on command metadata and matching while Soar coordinates parsed results with storage, task state, and UI output. Increase the UI-test timeout from 20 to 30 seconds because the existing 101-save stress case can exceed the former limit on this Windows environment; all expected output remains unchanged.\n","fileTypesAndContributionMap":{"java":{"insertions":192,"deletions":155},"md":{"insertions":1,"deletions":1}}},{"hash":"8f3a70151ca7ebd3df77c2a5b7f0c0e8468b6807","isMergeCommit":false,"messageTitle":"Encapsulate task collection in TaskList","messageBody":"Introduce TaskList as the owner of ordered task storage, add/delete operations, completion changes, rollback helpers, immutable snapshots, and date matching. Update Soar to coordinate through TaskList instead of manipulating ArrayList directly, preserving the existing persistence rollback behavior. Add focused TaskList checks to the UI-test build and run each console case with an isolated temporary data directory so cases cannot affect one another through a shared persistence path.\n","fileTypesAndContributionMap":{"java":{"insertions":225,"deletions":34},"md":{"insertions":3,"deletions":3}}},{"hash":"ee1646139a0f70c1e4e6328e428dd81ac2a27072","isMergeCommit":false,"messageTitle":"Establish command hierarchy with ExitCommand","messageBody":"Introduce an abstract Command contract with a shared execute signature and a default non-exiting state. Extract farewell behavior and exit signaling into ExitCommand, then update Soar\u0027s loop to stop based on the command\u0027s isExit result. This creates the foundation for migrating the remaining command branches incrementally while preserving existing console behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":43,"deletions":3}}},{"hash":"49ecc954b4bef18ab7dc48d0f9e9258681ab03fe","isMergeCommit":false,"messageTitle":"Extract task listing into ListCommand","messageBody":"Move list rendering behavior from Soar into a dedicated ListCommand subclass. Execute ListCommand and ExitCommand through one shared Command reference so migrated commands now use the same polymorphic execute and isExit flow. Keep the remaining command branches unchanged for later incremental extraction.\n","fileTypesAndContributionMap":{"java":{"insertions":18,"deletions":7}}}]},{"date":"2026-08-28T00:00:00","commitResults":[{"hash":"43ac795dc26d0f6839b45b94a397bb1286f79cda","isMergeCommit":false,"messageTitle":"Extract date queries into DateCommand","messageBody":"Move date-result formatting, task matching orchestration, and UI presentation from Soar into a dedicated DateCommand. Construct the command with the LocalDate already validated by Parser and execute it through the shared polymorphic command path. This keeps parsing, collection searching, and command behavior in their respective classes while further reducing Soar\u0027s responsibilities.\n","fileTypesAndContributionMap":{"java":{"insertions":37,"deletions":30}}},{"hash":"45c94b3b695e524a97928bc24e59f778aa1224c6","isMergeCommit":false,"messageTitle":"Extract task creation into AddCommand","messageBody":"Move parsed-task addition, persistence, rollback, and success presentation from Soar into a generic AddCommand used by todo, deadline, and event inputs. Construct AddCommand with the Task already validated by Parser and execute it through the shared command path. Add a focused CommandTest that forces a save failure and verifies the in-memory addition is removed before the error is reported.\n","fileTypesAndContributionMap":{"java":{"insertions":79,"deletions":20},"md":{"insertions":1,"deletions":1}}},{"hash":"f93171c2701e96a8249fa1096a66988e2c7e0192","isMergeCommit":false,"messageTitle":"Extract completion changes into command classes","messageBody":"Add MarkCommand and UnmarkCommand to own completion-state mutation, persistence, rollback, and confirmation output. Move reusable save-and-rollback handling into the abstract Command base and update AddCommand to use the same template. Construct validated completion commands in Soar\u0027s command mapping and extend CommandTest to verify failed saves restore both incomplete and completed states.\n","fileTypesAndContributionMap":{"java":{"insertions":125,"deletions":38}}},{"hash":"8dcaa2221d915ecf03e4990d8c37cc0628ae40f9","isMergeCommit":false,"messageTitle":"Extract task deletion into DeleteCommand","messageBody":"Move deletion, persistence, rollback, and confirmation output into DeleteCommand. Add the final enum case to Soar\u0027s exhaustive command switch so all supported commands share one polymorphic execution path, and remove Soar\u0027s last command-specific branch and persistence helper. Extend CommandTest to verify failed deletion restores both task count and original order.\n","fileTypesAndContributionMap":{"java":{"insertions":44,"deletions":38}}},{"hash":"e2128a03f53ac6a3081d97aaf5d8fee6484417d8","isMergeCommit":false,"messageTitle":"Move command construction into Parser","messageBody":"Add a single Parser.parse entry point that recognizes each command, validates its arguments, and returns the matching Command object. Hide the parser\u0027s intermediate helpers so command interpretation has one public interface, and simplify Soar to a uniform parse, execute, and exit-check loop. Retain task-count validation during this increment to preserve all existing task-number errors.\n","fileTypesAndContributionMap":{"java":{"insertions":26,"deletions":19}}},{"hash":"b5bcb15ce47a89ec8f846167a933e2b831706bf0","isMergeCommit":false,"messageTitle":"Move task range validation into commands","messageBody":"Let Parser parse numbered-command syntax without reading task-list state, so its public factory now accepts only the user\u0027s input. Store one-based task numbers in mark, unmark, and delete commands, then validate them against the current TaskList immediately before execution through a shared Command helper. Extend CommandTest to verify empty, zero, and oversized selections produce guidance without mutating tasks, while retaining persistence rollback coverage.\n","fileTypesAndContributionMap":{"java":{"insertions":91,"deletions":49}}},{"hash":"e763299d8ed4629d04e78639763d8d26f9789a3a","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-MoreOOP\u0027","messageBody":"","tags":["A-MoreOOP"],"fileTypesAndContributionMap":{}},{"hash":"bf9b2ae07e70b0448ef293262be3662d1233f538","isMergeCommit":false,"messageTitle":"Organise classes into Java packages","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":166,"deletions":0},"md":{"insertions":2,"deletions":2}}},{"hash":"02736201ed84638f2d7a92b0ca0db9bb358a5868","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-Packages\u0027","messageBody":"","tags":["A-Packages"],"fileTypesAndContributionMap":{}},{"hash":"42099b9a5fe6ad646879b27359198f99e3e9f371","isMergeCommit":true,"messageTitle":"Merge branch \u0027add-gradle-support\u0027","messageBody":"","tags":["A-Gradle"],"fileTypesAndContributionMap":{}},{"hash":"3831bbcba8ee85b0a3976bcb506c4ea67a98ab04","isMergeCommit":false,"messageTitle":"Add JUnit tests for DateTimeParser","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":62,"deletions":0}}},{"hash":"8aa73e5c395c515d9c43e133ab667ed9232996eb","isMergeCommit":false,"messageTitle":"Add more tests for DateTimeParser","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":89,"deletions":0}}},{"hash":"438e39634b74cdc7ebce5c24d3a15ac52e7538e5","isMergeCommit":false,"messageTitle":"Add tests on top 50% methods","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":555,"deletions":0}}},{"hash":"a68ff6707122f2d0bf6f139670395777c4a64e24","isMergeCommit":false,"messageTitle":"Update Agents.md","messageBody":"","fileTypesAndContributionMap":{"md":{"insertions":12,"deletions":4}}},{"hash":"baafb9f6f6d8e7c94a713bc4f195cd1ccb26972e","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-JUnit\u0027","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"a8ecfe908daac40e3aa85f9cfdb081f4d20793cd","isMergeCommit":false,"messageTitle":"Configure JAR","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":6,"deletions":2}}},{"hash":"abfa4206d93292f928f84d6c1366041228b4e563","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-Jar\u0027","messageBody":"","fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionMap":{"lingsongc":{"java":2682,"md":1553,"fxml":0,"sh":0,"bat":0,"gradle":6,"txt":0}},"authorContributionVariance":{"lingsongc":368454.78},"authorDisplayNameMap":{"lingsongc":