,"commitResults":[{"hash":"f1665f9f892f1176e9ea8bf986980375cc560c90","isMergeCommit":false,"messageTitle":"Add checkstyle","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":5,"deletions":0},"txt":{"insertions":97,"deletions":0},"java":{"insertions":35,"deletions":24}}},{"hash":"801ca43c8f8de3e76440c33721b855bc4f9b3a1b","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-Checkstyle\u0027","messageBody":"","tags":["A-Checkstyle"],"fileTypesAndContributionMap":{}},{"hash":"0616550db06f6e3cfb297cb392f7d34eb1e577a1","isMergeCommit":false,"messageTitle":"Add GUI","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":9,"deletions":3},"txt":{"insertions":4,"deletions":0},"java":{"insertions":367,"deletions":37}}},{"hash":"9e4ec6c00b21a047bff017b43aa12deeab55834e","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-10\u0027","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-18T00:00:00","commitResults":[{"hash":"3cf7cf1c8b06ea33d5d1537210074af386422495","isMergeCommit":false,"messageTitle":"Add assertions for critical application invariants","messageBody":"Several methods rely on assumptions about valid state and non-null\nvalues, but these assumptions are not explicitly checked.\n\nUnverified assumptions can allow invalid state to propagate and make\nerrors harder to detect during development.\n\nLet\u0027s add assertions at critical points where the application relies on\nthese invariants.\n\nAssertions make programming errors fail early while leaving normal user\ninput validation separate from internal correctness checks.\n","fileTypesAndContributionMap":{"gradle":{"insertions":2,"deletions":0},"txt":{"insertions":2,"deletions":0},"java":{"insertions":33,"deletions":0}}},{"hash":"745575adccb9214b5f7edd685fdee40b3e22e49c","isMergeCommit":false,"messageTitle":"Parser: Separate command dispatch from task processing","messageBody":"Parser.executeCommand mixes high-level command dispatching with low-level\nparameter extraction, task instantiation, and storage operations.\n\nThis violates the Single Level of Abstraction Principle and makes the\nmethod harder to read, test, and maintain.\n\nLet\u0027s extract the task-processing responsibilities into focused helper\nmethods while keeping executeCommand responsible for command dispatching.\n\nSeparating these responsibilities makes the control flow clearer and\nreduces the risk of unintended changes when new commands are added.\n","fileTypesAndContributionMap":{"java":{"insertions":132,"deletions":126}}},{"hash":"174212b9959803ef4a44253e022eb09574d4cf79","isMergeCommit":false,"messageTitle":" Parser: Separate command dispatch from task processing","messageBody":"Parser.executeCommand mixes high-level command dispatching with low-level\nparameter extraction, task instantiation, and storage operations.\n\nThis violates the Single Level of Abstraction Principle and makes the\nmethod harder to read, test, and maintain.\n\nLet\u0027s extract the task-processing responsibilities into focused helper\nmethods while keeping executeCommand responsible for command dispatching.\n\nSeparating these responsibilities makes the control flow clearer and\nreduces the risk of unintended changes when new commands are added.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"txt":{"insertions":1,"deletions":0},"java":{"insertions":81,"deletions":82}}},{"hash":"6861f25bb07aa29506de214d5ba097452dc2defa","isMergeCommit":true,"messageTitle":"Merge pull request #2 from krit004/branch-A-Assertions","messageBody":"Add assertions for critical application invariants","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"6997a6e5b609d9587a048cd36e5d0c7950db98d1","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"f245b896ef0792e1662ae93adc893b662c5ed0f9","isMergeCommit":true,"messageTi