AndContributionMap":{}},{"hash":"0948d6f452857da8dcc30b5de7d0e99ec2f9ca25","isMergeCommit":false,"messageTitle":"Add JavaFX GUI and refactor architecture for dual CLI/GUI support","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":16,"deletions":1},"fxml":{"insertions":35,"deletions":0},"java":{"insertions":372,"deletions":170}}},{"hash":"38f656a535a026a7e4f48ef705835ae2cd45b4d1","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-10\u0027","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{}},{"hash":"7f9257de956a0b24eb932823e895ee65a6875c25","isMergeCommit":false,"messageTitle":"Use varargs for a helper method in formatting","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":14,"deletions":5}}},{"hash":"9ec9ce4a4a9c248bc2c124485dd0d6ecdbbfff04","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-Varargs\u0027","messageBody":"","tags":["A-Varargs"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-08T00:00:00","commitResults":[{"hash":"c8944783174aec3cf6409fea8b6435af81135e6a","isMergeCommit":false,"messageTitle":"Add assertions to verify critical code assumptions","messageBody":"Key internal assumptions regarding application state and method inputs\nare implicit. For example, the parser expects non-null user inputs\nand valid index boundaries, and UI components assume their\ndependencies exist before rendering.\n\nImplicit assumptions can lead to silent data corruption or confusing\nruntime errors if internal logic fails.\n\nLet\u0027s,\n* enforce non-null inputs in the Parser and DialogBox classes\n* verify that Storage initializes with a valid file path\n* ensure task indexes passed for modification are non-negative\n\nUsing assertions instead of exceptions for these checks documents\nprogrammer intent and catches internal logic errors during\ndevelopment without impacting production runtime performance.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"java":{"insertions":8,"deletions":0}}}]},{"date":"2026-09-09T00:00:00","commitResults":[{"hash":"794cc171e96e3f0f3167f2d2ab42f7bc06213d83","isMergeCommit":false,"messageTitle":"Refactor architecture to improve code quality","messageBody":"The codebase contains minor encapsulation leaks, broad exception\ncatching, duplicated command logic, and bloated parsing methods.\nResources like file readers and writers are manually closed,\nmaking them prone to silent resource leaks upon failure.\n\nThese structural issues reduce maintainability, mask unexpected\nruntime bugs, and violate core software engineering principles like\nSLAP (Single Level of Abstraction) and DRY (Don\u0027t Repeat Yourself).\n\nLet\u0027s,\n* extract complex parser logic into distinct helper methods\n* move the save format constant to Task to reduce coupling\n* enforce defensive copying in TaskList to protect internal state\n* narrow exception catch blocks to avoid masking unrelated bugs\n* implement try-with-resources to guarantee resource closure\n* centralize exit logic in Parser to prevent DRY violations\n\nThese refactorings improve internal code safety, readability, and\nencapsulation without altering the application\u0027s external behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":122,"deletions":93}}},{"hash":"d231185792e3ab785932dff1b65afcd4a1106915","isMergeCommit":false,"messageTitle":"Use Streams to implement finding tasks","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":20,"deletions":7}}},{"hash":"26d2eca6eddfce313b71a1a70036fe273c7dd665","isMergeCommit":true,"messageTitle":"Merge pull request #1 from Ciltan/branch-A-Assertions","messageBody":"Add assertions to verify critical code assumptions","tags":["A-Assertions"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-10T00:00:00","commitResults":[{"hash":"c637942462ac18e2abcb7a806f6664084f74e275","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody"