[{"path":".agents/skills/git-conventions/SKILL.md","fileType":"md","lines":[{"lineNumber":1,"author":{"gitId":"matthewtansh"},"content":"---","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"matthewtansh"},"content":"name: git-conventions","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"matthewtansh"},"content":"description: Apply the SE-EDU Git conventions when proposing or reviewing commit messages and branch names for this project.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"matthewtansh"},"content":"---","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"matthewtansh"},"content":"# Git Conventions","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"matthewtansh"},"content":"Follow the [SE-EDU Git conventions](https://se-education.org/guides/conventions/git.html).","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":9,"author":{"gitId":"matthewtansh"},"content":"Consult the live source when a relevant detail is not covered below or when the user requests a full conventions audit.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":10,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":11,"author":{"gitId":"matthewtansh"},"content":"## Commit messages","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":12,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":13,"author":{"gitId":"matthewtansh"},"content":"- Use an imperative, capitalized subject without a trailing period.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"matthewtansh"},"content":"- Aim for at most 50 characters and never exceed 72 characters.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"matthewtansh"},"content":"- Add a meaningful scope or category prefix only when it improves clarity.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"matthewtansh"},"content":"- For non-trivial changes, add a body after a blank line and wrap it at 72 characters.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"matthewtansh"},"content":"- Explain what changed and why rather than implementation mechanics visible in the diff.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"matthewtansh"},"content":"- Use blank lines and bullet points when they improve readability.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"matthewtansh"},"content":"- Recommend smaller commits when a message becomes too broad or long.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"matthewtansh"},"content":"## Branch names","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":23,"author":{"gitId":"matthewtansh"},"content":"- Use meaningful kebab-case keywords.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":24,"author":{"gitId":"matthewtansh"},"content":"- For issue-related work, prefer `issueNumber-keywords-from-title`.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":25,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":26,"author":{"gitId":"matthewtansh"},"content":"## Completion check","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":27,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":28,"author":{"gitId":"matthewtansh"},"content":"Before suggesting Git actions:","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":29,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":30,"author":{"gitId":"matthewtansh"},"content":"1. Inspect the relevant Git status and diff when available.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":31,"author":{"gitId":"matthewtansh"},"content":"2. Confirm generated files and unrelated changes are not included in the proposed commit.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":32,"author":{"gitId":"matthewtansh"},"content":"3. Suggest a convention-compliant commit message for the actual change.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false},{"lineNumber":33,"author":{"gitId":"matthewtansh"},"content":"4. State the exact assignment tag when an increment has been completed.","lastModifiedDate":"2026-09-02T02:00:10","isFullCredit":false}],"authorContributionMap":{"matthewtansh":33}},{"path":".agents/skills/java-coding-standards/SKILL.md","fileType":"md","lines":[{"lineNumber":1,"author":{"gitId":"matthewtansh"},"content":"---","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"matthewtansh"},"content":"name: java-coding-standards","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"matthewtansh"},"content":"description: Apply the SE-EDU Java coding standard when editing or reviewing Java source and tests in this project.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"matthewtansh"},"content":"---","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"matthewtansh"},"content":"# Java Coding Standards","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"matthewtansh"},"content":"Follow the [SE-EDU Java coding standard (all rules)](https://se-education.org/guides/conventions/java/index.html).","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":9,"author":{"gitId":"matthewtansh"},"content":"Consult the live source when a relevant detail is not covered below or when the user requests a full conventions audit.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":10,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":11,"author":{"gitId":"matthewtansh"},"content":"## Naming","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":12,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":13,"author":{"gitId":"matthewtansh"},"content":"- Use lowercase package names and English noun-based PascalCase names for classes and enums.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"matthewtansh"},"content":"- Use English camelCase names for variables and verb-based camelCase names for methods.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"matthewtansh"},"content":"- Do not capitalize an entire abbreviation or acronym when it forms part of a name, such as `exportHtmlSource`.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"matthewtansh"},"content":"- Use SCREAMING_SNAKE_CASE for constants.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"matthewtansh"},"content":"- Give associated constants a common prefix.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"matthewtansh"},"content":"- Use longer variable names for larger scopes and short scratch names only for small, obvious scopes.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"matthewtansh"},"content":"- Name booleans so they read as booleans, normally with prefixes such as `is`, `has`, `was`, `can`, or `should`.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"matthewtansh"},"content":"- Use plural names for collections. Use `i`, then `j` and `k`, only as loop iterators where appropriate.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"matthewtansh"},"content":"- Name tests using `featureUnderTest_testScenario_expectedBehavior` when underscores improve clarity.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":23,"author":{"gitId":"matthewtansh"},"content":"## Layout and statements","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":24,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":25,"author":{"gitId":"matthewtansh"},"content":"- Indent with 4 spaces, not tabs. Indent wrapped lines by 8 additional spaces.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":26,"author":{"gitId":"matthewtansh"},"content":"- Keep lines below 110 characters where practical and never exceed 120 characters.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":27,"author":{"gitId":"matthewtansh"},"content":"- Wrap for readability: normally break after commas and before operators, keep a method name attached to its opening parenthesis, and prefer higher-level breaks.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":28,"author":{"gitId":"matthewtansh"},"content":"- Use K\u0026R braces. Always use braces for loop and conditional bodies, including one-line bodies.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":29,"author":{"gitId":"matthewtansh"},"content":"- Keep conditionals and their bodies on separate lines.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":30,"author":{"gitId":"matthewtansh"},"content":"- Put each class in an appropriate package when the assignment and current project structure permit it. Do not reorganize existing packages outside the requested increment.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":31,"author":{"gitId":"matthewtansh"},"content":"- Group related classes into packages.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":32,"author":{"gitId":"matthewtansh"},"content":"- Import classes explicitly, keep imports minimal, use a consistent ordering, and do not use wildcard imports.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":33,"author":{"gitId":"matthewtansh"},"content":"- Organize class members as documentation, declaration, class variables by access, instance variables by access, constructors, then methods.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":34,"author":{"gitId":"matthewtansh"},"content":"- Put an access modifier first in a method\u0027s modifier list.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":35,"author":{"gitId":"matthewtansh"},"content":"- Attach array brackets to the type, such as `int[] values`.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":36,"author":{"gitId":"matthewtansh"},"content":"- Initialize variables where declared when practical and declare them in the smallest useful scope.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":37,"author":{"gitId":"matthewtansh"},"content":"- Keep fields non-public unless they are constants or belong to a behavior-free data class.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":38,"author":{"gitId":"matthewtansh"},"content":"- Use `this` only when a field is shadowed by a parameter or local variable.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":39,"author":{"gitId":"matthewtansh"},"content":"- Mark intentional switch fallthrough with `// Fallthrough`.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":40,"author":{"gitId":"matthewtansh"},"content":"- Use spaces around operators, after Java keywords and commas, and after semicolons in `for` statements.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":41,"author":{"gitId":"matthewtansh"},"content":"- Separate logical units within a block with a blank line.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":42,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":43,"author":{"gitId":"matthewtansh"},"content":"## Comments and Javadocs","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":44,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":45,"author":{"gitId":"matthewtansh"},"content":"- Write comments in English using American spelling and indent them with the surrounding code.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":46,"author":{"gitId":"matthewtansh"},"content":"- Write header comments for public classes and methods, except obvious getters/setters, exact overrides, and test code where the standard permits omission.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":47,"author":{"gitId":"matthewtansh"},"content":"- Write header comments for non-trivial private methods.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":48,"author":{"gitId":"matthewtansh"},"content":"- Follow the SE-EDU Javadoc layout: use a concise summary sentence, align `*` characters, separate descriptions from tags with a blank line, punctuate tag descriptions, and include all useful `@param` tags or none when names are self-explanatory.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":49,"author":{"gitId":"matthewtansh"},"content":"- For uncovered topics, follow the Google Java Style Guide unless an assignment or repository rule says otherwise.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":50,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":51,"author":{"gitId":"matthewtansh"},"content":"## Completion check","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":52,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":53,"author":{"gitId":"matthewtansh"},"content":"Before reporting a Java change complete:","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":54,"author":{"gitId":"matthewtansh"},"content":"","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":55,"author":{"gitId":"matthewtansh"},"content":"1. Review changed code against the applicable conventions.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":56,"author":{"gitId":"matthewtansh"},"content":"2. Run the Java 25 checks or tests required by `AGENTS.md`.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":57,"author":{"gitId":"matthewtansh"},"content":"3. Confirm generated files such as `.class` files are not included in Git changes.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false},{"lineNumber":58,"author":{"gitId":"matthewtansh"},"content":"4. Report convention exceptions and test results.","lastModifiedDate":"2026-09-02T02:00:27","isFullCredit":false}],"authorContributionMap":{"matthewtansh":58}},{"path":"AGENTS.md","fileType":"md","lines":[{"lineNumber":1,"author":{"gitId":"-"},"content":"# Project context","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"-"},"content":"This repository is a starter template for a greenfield Java project used in an introductory software engineering course in an undergraduate computer science program. Students use it as the starting point for their own projects.","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"-"},"content":"# Default user context","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-08-04T15:44:37","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"-"},"content":"Unless the user says 