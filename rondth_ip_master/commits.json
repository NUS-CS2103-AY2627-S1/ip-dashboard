tions":159}}},{"hash":"85a5d06d9a46a751e028d4c83c7333ba259ee455","isMergeCommit":false,"messageTitle":"Add SE-EDU Java coding standard skill","messageBody":"Java work needs a project-specific source of formatting, naming, and\ndocumentation rules so future changes remain consistent.\n\nAdd a local skill based on the SE-EDU standard and require agents to\napply it whenever they create, review, or modify Java code.\n","fileTypesAndContributionMap":{"md":{"insertions":80,"deletions":0}}},{"hash":"15d11147dd57590c434582c05937290e1745f0ce","isMergeCommit":false,"messageTitle":"Add SE-EDU Git standard skill","messageBody":"Branch names and commit messages need a shared project standard so\nfuture history remains clear and consistent.\n\nAdd a local skill based on the SE-EDU Git conventions and require\nagents to apply it before branch or commit operations.\n","fileTypesAndContributionMap":{"md":{"insertions":57,"deletions":0}}},{"hash":"b4f4b7d2be9478703bb2303d73fe4bcd9b31c048","isMergeCommit":false,"messageTitle":"Add task description search","messageBody":"Introduce the find command so users can filter tasks by description keyword while preserving their original order. Validate missing keywords and cover matching, empty-result, and console UI behavior with automated tests.\n","fileTypesAndContributionMap":{"java":{"insertions":92,"deletions":1},"md":{"insertions":107,"deletions":2}}},{"hash":"bef4150b99692cd053ce0d5aca8c20d885245722","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-JavaDoc\u0027","messageBody":"","tags":["A-JavaDoc"],"fileTypesAndContributionMap":{}},{"hash":"a4c03fc32fd66b6aed593f3a47db5c10b8f8473e","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CodingStandard\u0027","messageBody":"","tags":["A-CodingStandard"],"fileTypesAndContributionMap":{}},{"hash":"d3c649dafe9c6df05bce24dfc98d985bfb5a0fbc","isMergeCommit":true,"messageTitle":"Merge branch-Level-9","messageBody":"","tags":["Level-9"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-03T00:00:00","commitResults":[{"hash":"a61428dca239a83756c66404bf2bc8971cd0eb58","isMergeCommit":false,"messageTitle":"Add Checkstyle skill","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":5,"deletions":0},"java":{"insertions":44,"deletions":42}}},{"hash":"b0d60095250d3210a8c2896bc73af02b77b21add","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CheckStyle\u0027","messageBody":"","tags":["A-CheckStyle"],"fileTypesAndContributionMap":{}},{"hash":"ccb4d3425879f40c8898e275a6399e8e8c1ac3ee","isMergeCommit":false,"messageTitle":"Add JavaFX GUI for Henry","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":16,"deletions":6},"fxml":{"insertions":77,"deletions":0},"java":{"insertions":422,"deletions":202},"md":{"insertions":11,"deletions":9}}},{"hash":"733bbc251f0eb8be374ddce5cc3dba0327a71174","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-10\u0027","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-08T00:00:00","commitResults":[{"hash":"d67b0a1372919fbe15aa11c5970c4385d6a93915","isMergeCommit":false,"messageTitle":"Add assert","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":14,"deletions":0}}},{"hash":"67dc5f00d52e330397d96b5b93e42b44bd615a0c","isMergeCommit":false,"messageTitle":"Task status: Unify completion state updates","messageBody":"Task completion uses separate mark and unmark methods at the task and\ntask-list levels. Henry repeats the same branch when applying a command\nand when restoring state after a failed save.\n\nThe parallel operations represent one boolean property and make the\npersistence rollback path harder to read and maintain.\n\nReplace them with a single setDone operation. Derive the requested state\nfrom the command type, and use the same operation when loading tasks or\nrolling back failed saves. This gives every completion-state transition\na consistent path.\n\nUpdate affected tests to exercise both values through the unified API.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"java":{"insertions":20,"deletions":43}}},{"hash":"fa21d29661587b8a6a0522f09747c2eaf9520130","isMergeCommit":false,"messageTitle":"Parser: Replace magic delimiter offsets","messageBody":"Parser uses numeric offsets to skip deadline and event delimiters. These\nvalues duplicate knowledge of each delimiter\u0027s length and can become\nincorrect when command syntax changes.\n\nReplace the delimiter literals with named constants and derive parsing\npositions from their lengths. This keeps each delimiter and offset\nsynchronized while making the parsing intent explicit.\n\nExisting parser behavior and user-facing output remain unchanged.\n","fileTypesAndContributionMap":{"java":{"insertions":13,"deletions":6}}}]},{"date":"2026-09-09T00:00:00","commitResults":[{"hash":"0eb414be8cec3c5fcb0298ac1de7846451913e7e","isMergeCommit":false,"messageTitle":"Henry: Centralize save rollback","messageBody":"Henry has three task-changing paths that each repeat the same save,\ncatch, rollback, and rethrow sequence. This duplicates critical\nconsistency logic and makes a new mutation easier to implement with\ndifferent failure behavior.\n\nCentralize that sequence in saveOrRollback. Keep each command\nresponsible only for defining its inverse operation, so the successful\npath stays prominent and all mutations share one persistence boundary.\n\nAdd an end-to-end regression test that makes storage unusable and\nverifies failed additions, status updates, and deletions all preserve\nthe prior in-memory task list.\n","fileTypesAndContributionMap":{"java":{"insertions":34,"deletions":18}}},{"hash":"5f99dfeb6512ce3371e845f5d3f813037744e982","isMergeCommit":false,"messageTitle":"Storage: Convert tasks with streams","messageBody":"Storage builds persisted task lines with a manual loop. Use a stream mapping to express the one-to-one conversion from tasks to their file representations while preserving save behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":3,"deletions":4}}},{"hash":"4918b1aed5803f84961e09ff3e57163a0f6b802a","isMergeCommit":true,"messageTitle":"Merge pull request #1 from rondth/branch-A-Assertions","messageBody":"Add assertions for task state changes","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"1701b1a62065c1f545dacf4e32a4168eb6144011","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"13c4a564bc26627f410877d5754cae4c247e856f","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"43bc77388fa9b1164a433e2d29cd4e082f41fe3c","isMergeCommit":true,"messageTitle":"Merge pull request #2 from rondth/branch-A-CodeQuality","messageBody":"Improve code quality and maintainability","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"55334fe5195ec6d56c394d642a8ffd6616a1a4c2","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"656d820ffb07edbe07afd87419c7eb1b25d513a9","isMergeCommit":true,"messageTitle":"Merge pull request #3 from rondth/branch-A-Streams","messageBody":"Use streams when saving tasks","tags":["A-Streams"],"fileTypesAndContributionMap":{}},{"hash":"cf2a091899960a424f83c4eabad24dacb8af5fd0","isMergeCommit":false,"messageTitle":"Add aliases for existing commands","messageBody":"Full command names make common operations verbose.\n\nAdd fixed lowercase aliases that resolve to existing command types while\npreserving validation and storage behavior. Document and test the alias\nworkflow.\n","fileTypesAndContributionMap":{"java":{"insertions":78,"deletions":24},"md":{"insertions":136,"deletions":0}}},{"hash":"3334a32c951d5a487ba216a7651ff75470e9defa","isMergeCommit":true,"messageTitle":"