dy":"# Conflicts:\n#\tsrc/main/java/beemo/Beemo.java\n#\tsrc/main/java/beemo/BeemoException.java\n#\tsrc/main/java/beemo/command/ExitCommand.java\n#\tsrc/main/java/beemo/command/ListCommand.java\n#\tsrc/main/java/beemo/parser/CommandType.java\n#\tsrc/main/java/beemo/storage/Storage.java\n#\tsrc/main/java/beemo/task/Deadline.java\n#\tsrc/main/java/beemo/task/Event.java\n#\tsrc/main/java/beemo/task/Task.java\n#\tsrc/main/java/beemo/task/Todo.java\n","tags":["A-CodingStandard"],"fileTypesAndContributionMap":{}},{"hash":"61dbed1b347dd7dbab0878b60fc8375b0fe6e7b9","isMergeCommit":true,"messageTitle":"Merge branch-Level-9 into master","messageBody":"# Conflicts:\n#\tsrc/main/java/beemo/parser/CommandType.java\n#\tsrc/main/java/beemo/parser/Parser.java\n#\tsrc/main/java/beemo/task/TaskList.java\n","tags":["Level-9"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-02T00:00:00","commitResults":[{"hash":"bce3bf4b4d458bc28171c35ff98266b5e4330086","isMergeCommit":false,"messageTitle":"Add JavaFX GUI","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{"gradle":{"insertions":15,"deletions":5},"fxml":{"insertions":73,"deletions":0},"java":{"insertions":246,"deletions":21},"md":{"insertions":13,"deletions":0}}}]},{"date":"2026-09-08T00:00:00","commitResults":[{"hash":"8f8985829314c8773037dd2844744cd9be61ce72","isMergeCommit":false,"messageTitle":"Document internal assumptions with assertions","messageBody":"Several methods rely on validated, non-null task data, but these\nexpectations are implicit.\n\nDocument these invariants with Java assertions at task construction,\ncommand creation, parsing and task-list boundaries. This makes\nprogramming errors fail early without changing user-facing validation.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"java":{"insertions":15,"deletions":0}}},{"hash":"808686cde7274ef99d9ed4e2d0556c03827f64f6","isMergeCommit":false,"messageTitle":"Replace parser magic values with constants","messageBody":"Parser offsets currently use unexplained numbers tied to command and\ndelimiter lengths. This makes the parsing logic harder to understand\nand easier to break when command syntax changes.\n\nName command keywords and delimiters, and derive offsets from their\nlengths. This makes each parsing operation explain its own intent.\n","fileTypesAndContributionMap":{"java":{"insertions":18,"deletions":9}}},{"hash":"bb39f144af5bf1f59a4a8868f18dd880bbbfb604","isMergeCommit":false,"messageTitle":"Centralize command execution workflow","messageBody":"Console and JavaFX entry points currently duplicate command parsing,\nexecution, and error handling. Future changes could cause their\nbehavior to diverge.\n\nExtract the shared workflow into one method that executes a command\nand reports whether it requests an exit. This keeps both interfaces\nconsistent and gives each caller a clearer responsibility.\n","fileTypesAndContributionMap":{"java":{"insertions":20,"deletions":11}}},{"hash":"88bb1f06ac9bd432d5f8ef0a9b260442ba0105ad","isMergeCommit":false,"messageTitle":"Encapsulate task state","messageBody":"Task fields currently allow direct access from subclasses even though\nno subclass needs it. Immutable task details also appear mutable,\nmaking their intended lifecycle unclear.\n\nRestrict fields to their declaring classes and mark unchanging task\ndetails as final. This protects task invariants and makes mutability\nexplicit.\n","fileTypesAndContributionMap":{"java":{"insertions":5,"deletions":10}}},{"hash":"a38c38c2583c01dbacdaf07bfecc3e4a01974e22","isMergeCommit":false,"messageTitle":"Name application window constants","messageBody":"Window setup currently contains unexplained dimensions and repeated\nconfiguration literals. Their purpose is only apparent from the\nmethods in which they are used.\n\nReplace these magic literals with descriptive constants. This makes\nthe window configuration easier to understand and update safely.\n","fileTypesAndContributionMap":{"java":{"insertions":11,"deletions":5}}},{"hash":"ef23ee1633749acd7a3e8c4948e0995420cbd232","isMergeCommit":false,"messageTitle":"Clarify task date and time names","messageBody":"Deadline and event values currently use the abbreviated names by,\nfrom, and to. These names depend on command syntax and do not clearly\ndescribe the data represented by each field and accessor.\n\nRename them to due date, start time, and end time terminology. This\nmakes task state and storage usage easier to understand.\n","fileTypesAndContributionMap":{"java":{"insertions":27,"deletions":27}}},{"hash":"01d23137d79ce829ab320e4313100de978a5d2d5","isMergeCommit":false,"messageTitle":"Use a stream to find matching tasks","messageBody":"Task search currently builds its result using a manual loop and\ntemporary list. The operation is a direct filtering transformation\nover the task collection.\n\nExpress the search as a stream filter and collect it to an\nunmodifiable list. This keeps the filtering intent concise while\npreserving result order and immutability.\n","fileTypesAndContributionMap":{"java":{"insertions":3,"deletions":7}}},{"hash":"f8f63d07a9f19c18ae1446cd3fc726053fad15e3","isMergeCommit":true,"messageTitle":"Merge pull request #3 from ffynch/branch-A-Streams","messageBody":"","tags":["A-Streams"],"fileTypesAndContributionMap":{}},{"hash":"8ef19d62140f6d9d1d857f8a1e61ff710af9651b","isMergeCommit":true,"messageTitle":"Merge master into branch-A-Assertions","messageBody":"Master now contains the A-Streams increment, while this branch\ncontains assertions for validated task data.\n\nPreserve the keyword assertion while adopting the stream-based task\nsearch from master.\n","fileTypesAndContributionMap":{}},{"hash":"548189f4272358fd0d968c7c58ba00ab17c18c92","isMergeCommit":true,"messageTitle":"Merge pull request #1 from ffynch/branch-A-Assertions","messageBody":"","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"f379226b09079782ff499c3bb69583f4e96133f4","isMergeCommit":true,"messageTitle"