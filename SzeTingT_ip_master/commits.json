Map":{}},{"hash":"4fd50a8219ee52e1033cb08d90551e3eba583afb","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-9\u0027","messageBody":"","tags":["Level-9"],"fileTypesAndContributionMap":{}},{"hash":"fd4fbc456fa7547b7161d18b766bb3a81daee105","isMergeCommit":false,"messageTitle":"Fix all Checkstyle violations","messageBody":"","fileTypesAndContributionMap":{"txt":{"insertions":3,"deletions":2},"java":{"insertions":21,"deletions":19}}},{"hash":"bd71e1cdd0a0cf749f777bec2ae9f3b54a3fd290","isMergeCommit":false,"messageTitle":"Update AGENTS.md for coding standards","messageBody":"","fileTypesAndContributionMap":{"md":{"insertions":2,"deletions":0}}},{"hash":"e13cfdf268d82f923231b5b3ceae522620a5dc24","isMergeCommit":false,"messageTitle":"Add coding standard Codex skill","messageBody":"","tags":["A-CheckStyle"],"fileTypesAndContributionMap":{"md":{"insertions":25,"deletions":0}}}]},{"date":"2026-09-08T00:00:00","commitResults":[{"hash":"97622a995367b0d3ff1c41b4a467ec9a8d7a7b8c","isMergeCommit":false,"messageTitle":"Add base GUI","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":1,"deletions":1},"java":{"insertions":113,"deletions":1}}},{"hash":"948c5120e05d5be33c71645ce0bf466a71f4e40e","isMergeCommit":false,"messageTitle":"Add more customisation and eparate GUI into components","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":119,"deletions":77}}},{"hash":"4926df8a5b54b3fc1946fd030c3d43f749734d16","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-10\u0027","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{}},{"hash":"279ef3fec881c5da05aa98e758bd8436dc15d578","isMergeCommit":false,"messageTitle":"Create addStylesheets to add multiple stylesheets to scene with varargs","messageBody":"","fileTypesAndContributionMap":{"txt":{"insertions":4,"deletions":1},"java":{"insertions":10,"deletions":3}}}]},{"date":"2026-09-09T00:00:00","commitResults":[{"hash":"f870cf93c8240cbab9636a1599751a5d84cfe6ed","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-Varargs\u0027","messageBody":"","tags":["A-Varargs"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-14T00:00:00","commitResults":[{"hash":"c06180605daca689e8a06ba791caf4dc6e1bafdd","isMergeCommit":false,"messageTitle":"Add assertions for task invariants","messageBody":"Task statuses and task-list entries can be null, and the parser depends\non a valid termination flag.\n\nNull internal state can cause failures during task processing.\n\nLet\u0027s add assertions for non-null statuses, non-null tasks, and a usable\ntermination flag.\n\nAssertions detect programming errors early without changing normal\nuser-input handling.\n","fileTypesAndContributionMap":{"txt":{"insertions":7,"deletions":0},"java":{"insertions":4,"deletions":0}}},{"hash":"6cf2561b403499b35e3ee9ed66f5d8ed5cb21b05","isMergeCommit":false,"messageTitle":"Parser: Extract command handlers","messageBody":"The parser method handles command dispatch, validation, task mutation, and\noutput in one long nested block.\n\nThe mixed responsibilities make command processing harder to read and\nmaintain.\n\nLet\u0027s extract command-specific logic into focused private methods while\nkeeping parse responsible for dispatch, error handling, and persistence.\n\nThe refactoring reduces method length and separates levels of abstraction\nwithout changing command behavior or console output.\n","fileTypesAndContributionMap":{"java":{"insertions":100,"deletions":68}}},{"hash":"156bf76e5958ee8e4924ead7b6ab319ae5642b28","isMergeCommit":false,"messageTitle":"Parser: Extract command flow selection","messageBody":"Parser command handling mixes flow selection with command execution.\n\nThe long conditional chain makes it harder to see the supported flows\nand complicates future command additions.\n\nLet\u0027s move command identification into a Command enum and dispatch the\nselected flow from Parser.parse().\n\nSeparating selection from execution keeps each component at one level of\nabstraction while preserving existing validation and command behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":76,"deletions":12}}},{"hash":"0bb2e0ab24bbdb051c16284d4476e3f8a61fa31d","isMergeCommit":false,"messageTitle":"Storage: Extract task record loading","messageBody":"Storage.loadTasks handles file reading, task parsing, status decoding, and\ncorruption handling in one method.\n\nThe mixed responsibilities and nested switch make persistence logic harder to\nread and maintain.\n\nLet\u0027s extract task-record parsing into a focused loadTask method while keeping\nloadTasks responsible for file loading and result assembly.\n\nSeparating the record-level operation reduces nesting and keeps each method at\none level of abstraction without changing the save-file format or error behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":34,"deletions":33}}},{"hash":"0b01a9c118f05ec642f63ef457dc64db4e920918","isMergeCommit":false,"messageTitle":"Parser: Return termination status","messageBody":"Parser.parse uses a mutable boolean array to communicate termination\nback to its callers.\n\nThe output-parameter pattern obscures control flow and makes callers\nmanage state that belongs to the parsing operation.\n\nLet\u0027s return a boolean from parse and use it in the CLI loop and GUI\ncall path.\n\nReturning the termination decision makes the control flow explicit and\nremoves shared state without changing behavior or output.\n","fileTypesAndContributionMap":{"java":{"insertions":6,"deletions":9}}},{"hash":"8e968f96a4209227488c3c9b6aca975f31f8da44","isMergeCommit":false,"messageTitle":"Command: Centralize keyword matching","messageBody":"Command.identify repeats case-insensitive keyword comparisons for each\ncommand flow.\n\nThe duplicated conditions make the command catalogue harder to scan and\nexpand safely.\n\nLet\u0027s store each flow\u0027s keywords and matching mode in the Command enum, then\nuse one shared matching routine.\n\nData-driven matching keeps command definitions together and preserves the\ndistinction between exact commands and commands with arguments without\nchanging supported input or behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":29,"deletions":37}}},{"hash":"29a46f095dd051559dd2f14f6d8383c4b648f590","isMergeCommit":false,"messageTitle":"Parser: Separate task update actions","messageBody":"handleTaskUpdate combines task deletion with status changes in one\nconditional branch.\n\nThe two operations have different responsibilities and output behavior,\nwhich makes the method harder to read and modify safely.\n\nLet\u0027s extract deletion and status updates into focused private methods while\nkeeping index validation in the shared update flow.\n\nSeparating the operations reduces branching and keeps each method at one level\nof abstraction without changing command behavior or output.\n","fileTypesAndContributionMap":{"java":{"insertions":16,"deletions":8}}},{"hash":"851438cb72362c35097dfbc5a8e5f216f5d80540","isMergeCommit":false,"messageTitle":"Finalize Java code quality cleanup","messageBody":"The code contains unclear boolean and formatter names, an empty CLI\nloop body, and per-instance storage for immutable UI and date-format values.\n\nThese patterns make intent less obvious and can make simple control flow\nlook more complicated than it is.\n\nLet\u0027s use intent-revealing names, make shared immutable values constants, and\nexpress the CLI lifecycle with an explicit do-while loop.\n\nThe cleanup follows the project\u0027s SE-EDU standard and improves readability\nwithout changing user-visible behavior or persistence formats.\n","fileTypesAndContributionMap":{"java":{"insertions":20,"deletions":16}}},{"hash":"972c8e5f39f42a8c26c5ee3e75f2d639699207e7","isMergeCommit":false,"messageTitle":"TaskList: Use streams for collection transforms","messageBody":"TaskList uses manual loops for serialization and keyword filtering.\n\nThe repeated accumulation pattern obscures the direct transformation and\nfiltering operations.\n\nLet\u0027s use streams to map tasks to save lines and filter keywords.\n\nThe pipelines express both operations at the level of their intent while\npreserving mutable list results and task ordering.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"java":{"insertions":7,"deletions":14}}},{"hash":"dba69636d3e4485fec8ed0d22907e3f02a207238","isMergeCommit":true,"messageTitle":"Merge pull request #2 from SzeTingT/branch-A-Assertions","messageBody":"Add assertions for task invariants","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"80e3904a9a3e0438ca65d152278680e76296075f","isMergeCommit":true,"messageTitle":"Merge pull request #3 from SzeTingT/branch-A-Streams","messageBody":"TaskList: Use streams for collection transforms","tags":["A-Streams"],"fileTypesAndContributionMap":{}},{"hash":"a7d37d558fab0969cffa861e756dc2b3a3ae8ca4","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"29840d052a95e7f173eecaefe789bf96a12ba20f","isMergeCommit":true,"messageTitle":"Merge pull request #4 from SzeTingT/branch-A-CodeQuality","messageBody":"Refactor code to adhere to SE-EDU code quality guidelines","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionMap":{"SzeTingT":{"java":1010,"md":223,"fxml":0,"sh":0,"bat":0,"gradle":23,"txt":16}},"authorContributionVariance":{"SzeTingT":31442.0},"authorDisplayNameMap":{"SzeTingT":"CS2103T-F10-4 TAN ..TING"}}
