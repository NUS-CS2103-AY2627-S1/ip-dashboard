tLine() throw.","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":35,"author":{"gitId":"ahsiwt101"},"content":"        while (scanner.hasNextLine()) {","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":36,"author":{"gitId":"ahsiwt101"},"content":"            String command \u003d scanner.nextLine().trim();","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":37,"author":{"gitId":"ahsiwt101"},"content":"            if (command.equals(EXIT_COMMAND)) {","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":38,"author":{"gitId":"ahsiwt101"},"content":"                break;","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":39,"author":{"gitId":"ahsiwt101"},"content":"            }","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":40,"author":{"gitId":"ahsiwt101"},"content":"            printBlock(command);","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":41,"author":{"gitId":"ahsiwt101"},"content":"        }","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":42,"author":{"gitId":"ahsiwt101"},"content":"","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":43,"author":{"gitId":"ahsiwt101"},"content":"        printBlock(\"Bye. Hope to see you again soon!\");","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":44,"author":{"gitId":"ahsiwt101"},"content":"    }","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":45,"author":{"gitId":"ahsiwt101"},"content":"","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":46,"author":{"gitId":"ahsiwt101"},"content":"    /**","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":47,"author":{"gitId":"ahsiwt101"},"content":"     * Prints the given lines as one block: framed by divider lines above and","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":48,"author":{"gitId":"ahsiwt101"},"content":"     * below, indented to match Milo\u0027s output format, and followed by a blank","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":49,"author":{"gitId":"ahsiwt101"},"content":"     * line that separates it from whatever the user types next.","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":50,"author":{"gitId":"ahsiwt101"},"content":"     * A line that itself contains newlines (such as the banner) is split so","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":51,"author":{"gitId":"ahsiwt101"},"content":"     * that every physical line receives the same indentation.","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":52,"author":{"gitId":"ahsiwt101"},"content":"     *","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":53,"author":{"gitId":"ahsiwt101"},"content":"     * @param lines the lines of text to display inside the block","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":54,"author":{"gitId":"ahsiwt101"},"content":"     */","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":55,"author":{"gitId":"ahsiwt101"},"content":"    private static void printBlock(String... lines) {","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":56,"author":{"gitId":"ahsiwt101"},"content":"        System.out.println(DIVIDER);","lastModifiedDate":"2026-08-25T12:07:04","isFullCredit":false},{"lineNumber":57,"author":{"gitId":"ahsiwt101"},"content":"        for (String line : lines) {","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":58,"author":{"gitId":"ahsiwt101"},"content":"            for (String physicalLine : line.split(\"\\n\")) {","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":59,"author":{"gitId":"ahsiwt101"},"content":"                System.out.println(INDENT + \" \" + physicalLine);","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":60,"author":{"gitId":"ahsiwt101"},"content":"            }","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":61,"author":{"gitId":"ahsiwt101"},"content":"        }","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":62,"author":{"gitId":"ahsiwt101"},"content":"        System.out.println(DIVIDER);","lastModifiedDate":"2026-08-25T12:07:04","isFullCredit":false},{"lineNumber":63,"author":{"gitId":"ahsiwt101"},"content":"        System.out.println();","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":64,"author":{"gitId":"-"},"content":"    }","lastModifiedDate":"2019-07-29T17:14:46","isFullCredit":false},{"lineNumber":65,"author":{"gitId":"-"},"content":"}","lastModifiedDate":"2019-07-29T17:14:46","isFullCredit":false}],"authorContributionMap":{"ahsiwt101":63,"-":2}}]
