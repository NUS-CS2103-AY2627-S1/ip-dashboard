 \u003d \"    \";","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":11,"author":{"gitId":"ahsiwt101"},"content":"","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":12,"author":{"gitId":"ahsiwt101"},"content":"    /** Horizontal line used to separate blocks of Milo\u0027s output. */","lastModifiedDate":"2026-08-25T12:07:04","isFullCredit":false},{"lineNumber":13,"author":{"gitId":"ahsiwt101"},"content":"    private static final String DIVIDER \u003d","lastModifiedDate":"2026-08-25T12:07:04","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"ahsiwt101"},"content":"            INDENT + \"____________________________________________________________\";","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"ahsiwt101"},"content":"","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"ahsiwt101"},"content":"    /** The command that makes Milo exit. */","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"ahsiwt101"},"content":"    private static final String EXIT_COMMAND \u003d \"bye\";","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"ahsiwt101"},"content":"","lastModifiedDate":"2026-08-25T12:07:04","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"ahsiwt101"},"content":"    /**","lastModifiedDate":"2026-08-25T12:07:04","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"ahsiwt101"},"content":"     * ASCII-art banner spelling out the chatbot\u0027s name.","lastModifiedDate":"2026-08-25T12:07:04","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"ahsiwt101"},"content":"     * Note there is no trailing newline: the printing helper supplies it.","lastModifiedDate":"2026-08-25T20:51:35","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"ahsiwt101"},"content":"     */","lastModifiedDate":"2026-08-25T12:0