":{"java":{"insertions":67,"deletions":35}}},{"hash":"dcf4b7c09e553144da07d87c1e0962130df0fcac","isMergeCommit":false,"messageTitle":"Handle invalid user input","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":85,"deletions":19},"md":{"insertions":7,"deletions":0}}},{"hash":"aa39b789d0603a0af6c51c1ef097f789c1c57cba","isMergeCommit":false,"messageTitle":"Refactor input validation to use EVException","messageBody":"Throws a checked EVException from the point each problem is detected and catch it once in the command loop. This causes the compiler to now enforce the handling that was previously left to the caller, and isolates the decision of how to errors are displayed to the user in one place.\n","tags":["Level-5","A-Exceptions"],"fileTypesAndContributionMap":{"java":{"insertions":75,"deletions":78}}},{"hash":"4a7461548addb552759acb673b9b769cbcbc48e1","isMergeCommit":false,"messageTitle":"Add delete command","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":35,"deletions":7}}},{"hash":"e91d3e46da13da9fe7c940da82ffd71c7a362db5","isMergeCommit":false,"messageTitle":"Replace task array with ArrayList","messageBody":"Before this, the fixed array forces a manual shift on delete, a separate taskCount that can drift and a MAX_TASKS limit to check before every addition.\n\nStoring tasks in an ArrayList is a better choice, since it resizes itself and reports its own size. This removes the shift loop, the counter, the capacity constant and the error when the registry is full.\n","tags":["Level-6","A-Collections"],"fileTypesAndContributionMap":{"java":{"insertions":26,"deletions":45}}},{"hash":"db3eff3cc370a14743ee5418f622992bf7350f87","isMergeCommit":false,"messageTitle":"Used an enum for commands","messageBody":"The Command enum maps each keyword to a constant, and\nrejects unknown words up front. This ensures that the compiler now checks every command reference, and the fall-through error at the end of the loop is gone.\n","tags":["A-Enums"],"fileTypesAndContributionMap":{"java":{"insertions":44,"deletions":13}}}]},{"date":"2026-08-28T00:00:00","commitResults":[{"hash":"1917a18e3b4fdba465f66a4227abd6de8e24e801","isMergeCommit":false,"messageTitle":"Organize classes into packages","messageBody":"","tags":["A-Packages"],"fileTypesAndContributionMap":{"java":{"insertions":17,"deletions":0}}},{"hash":"43336c3dbf52b1ecf3a3e308799f87c91527e081","isMergeCommit":false,"messageTitle":"Rename EVException to EvException","messageBody":"","fileTypesAndContributionMap":{"txt":{"insertions":28,"deletions":0},"java":{"insertions":15,"deletions":15}}},{"hash":"e40f19fff3f7c6905da132b156d314cf01616e7e","isMergeCommit":false,"messageTitle":"Add header comments for all classes","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":22,"deletions":12}}},{"hash":"51e2e130bf1aaacb36e2fe93d69dd47abddc8abe","isMergeCommit":false,"messageTitle":"Add header comments for public methods and constructors","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":56,"deletions":8}}},{"hash":"4b503827b1db1f1ba9eb77d34a6361189652a656","isMergeCommit":false,"messageTitle":"Rename fromKeyword to parseKeyword","messageBody":"","tags":["A-JavaDoc","A-CodingStandard"],"fileTypesAndContributionMap":{"java":{"insertions":2,"deletions":2}}},{"hash":"ed054165a375645a6c678f54ee07ac78da504d4e","isMergeCommit":false,"messageTitle":"Add newline at end of source files","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":5,"deletions":5},"sh":{"insertions":8,"deletions":0}}},{"hash":"ffd1badd92f4160b725642c2d4083ee39e9efcec","isMergeCommit":false,"messageTitle":"Extract user interaction into Ui class","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":142,"deletions":46}}},{"hash":"d7e64a32880a0f9b95a2564e574969566f46ac3c","isMergeCommit":false,"messageTitle":"Extract task registry into TaskList class","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":58,"deletions":