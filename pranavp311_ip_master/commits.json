rgeCommit":true,"messageTitle":"Merge branch-Level-10","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{}},{"hash":"384b0ef0b4b12b8fb21f8dac98b00445545667b4","isMergeCommit":false,"messageTitle":"Use varargs","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":9,"deletions":7}}},{"hash":"681709eca09746286003cc5d3120b52d56eb26d4","isMergeCommit":true,"messageTitle":"Merge branch-A-Varargs","messageBody":"","tags":["A-Varargs"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-07T00:00:00","commitResults":[{"hash":"378377fbd12bcca651b61708752b32d7fc049777","isMergeCommit":false,"messageTitle":"Document task-list assumptions","messageBody":"TaskList operations rely on callers to pass non-null tasks and indices\\nvalidated against the current list. Those assumptions were implicit, so\\nfuture changes could violate them without an immediate explanation.\\n\\nAdd Java assertions at the mutation and lookup boundaries, and enable\\nassertions for Gradle runs and tests. Test the preconditions so the\\ninvariants remain documented and executable.\n","fileTypesAndContributionMap":{"gradle":{"insertions":2,"deletions":0},"java":{"insertions":17,"deletions":0}}},{"hash":"ecf6c061525c77168f66c94c544e8d55add0b34f","isMergeCommit":false,"messageTitle":"Extract task command handlers","messageBody":"Kopi.execute mixes command dispatch with task mutation, storage, and\\nresponse formatting. This makes its main control flow harder to scan and\\nputs several abstraction levels in one method.\\n\\nExtract one handler for each mutating command. Keep execute focused on\\ndispatch while preserving existing command behavior and persistence.\n","fileTypesAndContributionMap":{"java":{"insertions":34,"deletions":16}}},{"hash":"ea6204132449019b42b392d55c0c55325ab7ff52","isMergeCommit":false,"messageTitle":"Format task lists with streams","messageBody":"Ui.getNumberedTasks builds numbered output with mutable state and an\\nindexed loop. Task-list formatting is a direct list-to-text\\ntransformation, so it is a natural place to use a stream.\\n\\nMap task indices to numbered lines and join them with the platform line\\nseparator. Preserve the existing empty-list and multi-line output.\n","fileTypesAndContributionMap":{"java":{"insertions":8,"deletions":7}}},{"hash":"a7c2b900e409cc1f0d5c72b6e976a2359a245a97","isMergeCommit":true,"messageTitle":"Merge pull request #1 from pranavp311/branch-A-Assertions","messageBody":"A-Assertions: Document assumptions","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"ce6d37620b03cf74862347a43b1d05da0f2ba893","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"118f3d3f480ba48e248d813c75cf7ced2ce2179c","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"ee16c751cc204ade77f5392fed75ba50023aea0e","isMergeCommit":true,"messageTitle":"Merge pull request #3 from pranavp311/branch-A-CodeQuality","messageBody":"A-CodeQuality: Extract command handlers","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"0c55e48092ff68d8cc1703c2655a05a25f6c6441","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"fb2d87d3c5e157902d0c09428a64f17589daf1d4","isMergeCommit":true,"messageTitle":"Merge pull request #2 from pranavp311/branch-A-Streams","messageBody":"A-Streams: Format task lists with streams","tags":["A-Streams"],"fileTypesAndContributionMap":{}},{"hash":"40ffe035083eb55e0f33c49df1515d81f14f5252","isMergeCommit":false,"messageTitle":"Reject duplicate tasks","messageBody":"Kopi accepts the same task more than once, which can leave users with\\nindistinguishable entries and accidental duplicate reminders.\\n\\nTreat tasks as duplicates when their types, descriptions, and date\\ndetails match. Ignore description case and completion state because they\\ndo not make a task distinct. Reject duplicates before saving, and cover\\nthe rule with unit and end-to-end tests.\n","fileTypesAndContributionMap":{"java":{"insertions":85,"deletions":0},"sh":{"insertions":2,"deletions":1},"md":{"insertions":1,"deletions":0}}},{"hash":"f69c1ccd743d9753aab4be4fb1a8b79c77f0a98c","isMergeCommit":true,"messageTitle":"Merge pull request #5 from pranavp311/branch-C-DetectDuplicates","messageBody":"C-DetectDuplicates: Reject duplicate tasks","tags":["BCD-Extension"],"fileTypesAndContributionMap":{}},{"hash":"c913fe6d1ad54bc756682fc4679a5dcc25aa5fec","isMergeCommit":false,"messageTitle":"Guard task-list construction","messageBody":"TaskList.add rejects null tasks, but its list constructor can still copy\na null reference or a collection containing null. That bypasses the\ninvariant documented by the A-Assertions increment.\n\nAssert the same preconditions before copying the input. Cover both\ninvalid forms so every construction path preserves the invariant.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"java":{"insertions":11,"deletions":0}}},{"hash":"b0113e7d50772bf99c036abec65c18b557516c6c","isMergeCommit":false,"messageTitle":"Test duplicates after reload","messageBody":"Duplicate detection ignores completion state and applies to stored data.\nThe integration test covered only two new in-memory tasks. A bug in\neither path could allow duplicate records after a restart.\n\nExercise the rule with a completed task and a fresh Kopi instance.\nKeep checking that rejection leaves exactly one task in the list.\n","fileTypesAndContributionMap":{"java":{"insertions":9,"deletions":6}}},{"hash":"e1e4a17aa633878d8ef2d59a2ca0b3c75db4d0d9","isMergeCommit":true,"messageTitle":"Merge pull request #6 from pranavp311/refine-duplicate-validation","messageBody":"Tighten Week 5 invariant coverage","fileTypesAndContributionMap":{}}]}]},"authorFileTypeContribution