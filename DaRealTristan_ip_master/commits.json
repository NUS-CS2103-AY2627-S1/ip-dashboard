"tags":["A-Jar"],"fileTypesAndContributionMap":{"gradle":{"insertions":1,"deletions":1},"txt":{"insertions":1,"deletions":0}}},{"hash":"4b9ebebc0ca958b5d29122dba867bca556966c95","isMergeCommit":false,"messageTitle":"Add JavaDoc comments","messageBody":"","fileTypesAndContributionMap":{"txt":{"insertions":0,"deletions":1},"java":{"insertions":374,"deletions":9}}},{"hash":"ec69bc83118a144f3fbaa8450de73a43dab2bf92","isMergeCommit":false,"messageTitle":"Style: Apply SE-EDU Java coding standard","messageBody":"Production classes lack the Javadocs and formatting consistency expected by the project coding standard.\n\nLet\u0027s add public API Javadocs, normalize import order and brace spacing, and rename fields and locals so they better match the SE-EDU naming rules.\n\nShared formatting objects are also promoted to constants where they represent fixed reusable values.\n","fileTypesAndContributionMap":{"java":{"insertions":220,"deletions":71}}},{"hash":"51574ca3f2f7d20251345c65be0ef6eec40cc2d4","isMergeCommit":false,"messageTitle":"Agents: Require SE-EDU Java standard","messageBody":"Project guidance needs to make Java style expectations explicit for future code changes.\n\nLet\u0027s require the project-specific Java coding standard skill and link the SE-EDU basic plus intermediate rules used by this project.\n","fileTypesAndContributionMap":{"md":{"insertions":7,"deletions":0}}},{"hash":"d36362c1ec394f3d815b27f0b0da27fd69a377cf","isMergeCommit":false,"messageTitle":" Agents: Require SE-EDU Git standard","messageBody":"","fileTypesAndContributionMap":{"md":{"insertions":3,"deletions":0}}},{"hash":"19fcfd4a96915dcdf79df9d34d43f76c77979f7b","isMergeCommit":false,"messageTitle":"Agents: Ammend student profile","messageBody":"","fileTypesAndContributionMap":{"md":{"insertions":2,"deletions":2}}},{"hash":"208f40a00086e2f40898bcbb8a4f22fd4c2dd712","isMergeCommit":false,"messageTitle":"Add find feature for chatbot","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":46,"deletions":8}}},{"hash":"daf54b07b66aacc971a79ad184eb89a5aa9a13b3","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-JavaDoc\u0027","messageBody":"","tags":["A-JavaDoc"],"fileTypesAndContributionMap":{}}]},{"date":"2026-08-27T00:00:00","commitResults":[{"hash":"8824c9722e4cb9a4ce351b70eed20957b7103620","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CodingStandard","messageBody":"","tags":["A-CodingStandard"],"fileTypesAndContributionMap":{}},{"hash":"2c948fbffcd548151ed81deae7b08c7e89e9f5bd","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-9\u0027","messageBody":"","tags":["Level-9"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-01T00:00:00","commitResults":[{"hash":"f4f70eb361821c560c36f5de2d0681a8aea9fe56","isMergeCommit":false,"messageTitle":"Add checkstyle to project","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":4,"deletions":0},"java":{"insertions":32,"deletions":22}}},{"hash":"3e40d14a82323677d5a44deb652205622467cff4","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-Checkstyle\u0027","messageBody":"","tags":["A-Checkstyle"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-02T00:00:00","commitResults":[{"hash":"1e2422ce45205dbe15a149232065eb4815f93b5c","isMergeCommit":false,"messageTitle":"Add GUI for Nubish chatbot","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":16,"deletions":1},"txt":{"insertions":6,"deletions":1},"fxml":{"insertions":98,"deletions":0},"java":{"insertions":292,"deletions":39}}},{"hash":"2abad9f541a7a25ecd4554bb3a83e340c30f6aa0","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-10\u0027","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{}},{"hash":"3237d8aef0eebb397e03aeba982c435c457ed563","isMergeCommit":false,"messageTitle":"TaskList: Add varargs to add method","messageBody":"","fileTypesAndContributionMap":{"txt":{"insertions":1,"deletions":1},"java":{"insertions":3,"deletions":2}}},{"hash":"492114198d58e86be077720a865924177a910f1d","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-varargs\u0027","messageBody":"","tags":["A-Varargs"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-08T00:00:00","commitResults":[{"hash":"ca2860824b12e1ce21d2ef312ddc4ef7bdf54608","isMergeCommit":false,"messageTitle":"Add variable name changes and minor Javadoc edits based on review comments","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":73,"deletions":73}}},{"hash":"78d953a1052b3e283290384bb34e698b27cbf94d","isMergeCommit":false,"messageTitle":"Add Assertions to Event, Task and Parser","messageBody":"Several assumptions were made in creation of Nubish which were not\nhighlighted in anyway. Assertions are a way of doing so.\n\nLet\u0027s Add assertions to Event, Task and Parser to highlight the following assumptions:\n1. Parser: the /to flag will always be after the /from flag when users\n   create Events\n2. Tasks: all tasks have task descriptions or task names\n3. Event: the entered from date will always be a date that occurs before\n   the to date\n\nAssertions ensure that the system does not bump into any possible\nfailures later on.\n","fileTypesAndContributionMap":{"java":{"insertions":6,"deletions":0}}},{"hash":"8b6850f9f41a1250e9085c95678ace8d5502f251","isMergeCommit":false,"messageTitle":"Parser: Extract command handlers","messageBody":"Parser.parse handles every supported command directly. This makes the\nmethod long and mixes command dispatch with command-specific validation,\nparsing, task updates, and UI output.\n\nThis structure makes the main control flow harder to read because one\nmethod operates at several levels of abstraction. It also makes later\nparser changes riskier because unrelated command details sit in the same\nlarge method.\n\nLet\u0027s extract each command body into a focused private helper so parse\ncan read as a high-level dispatcher.\n\nThis keeps the refactoring standalone: it changes structure only and\npreserves the existing validation behavior and user-facing messages.\nThat makes later behavior changes easier to review independently.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"java":{"insertions":132,"deletions":106}}},{"hash":"434bc4fe82360a0ed8a211a331559e10ac056686","isMergeCommit":false,"messageTitle":"Parser: Merge task status handlers","messageBody":"The mark and unmark command handlers perform the same sequence of\nsteps: validate the task number argument, retrieve the task, update its\ndone status, and show the corresponding response.\n\nKeeping this duplicated flow in separate methods makes future changes to\ntask-number handling easier to apply inconsistently.\n\nLet\u0027s replace the two handlers with one focused helper that accepts the\ndesired done status and keeps the command-specific response at the\ndecision point.\n\nThis keeps the change behavior-preserving while reducing duplication in\nthe parser. The parser can still dispatch mark and unmark commands\nexplicitly, so the high-level command flow remains easy to read.\n","fileTypesAndContributionMap":{"java":{"insertions":12,"deletions":20}}},{"hash":"75f6192d7fe04412a4bd5005351c78b822c52051","isMergeCommit":false,"messageTitle":"TaskList: Add Streams to find feature","messageBody":"The find feature uses a for loop to loop through the entire tasklist to\nfind matching tasks.\n\nLet\u0027s add streams into the find feature.\n\nThis allows the filtering process to be easier to see and understand. Any further modifications can easily be\nchained to the stream.\n","fileTypesAndContributionMap":{"java":{"insertions":3,"deletions":5}}},{"hash":"6da0ec9f475bfe45ed0b708b1675f5e733633633","isMergeCommit":true,"messageTitle":"Merge pull request #1 from DaRealTristan/branch-A-Assertions","messageBody":"Add Assertions to Event, Task and Parser","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"96c2924ab5695a69fb204ae69ac8b9d14d85d46a","isMergeCommit":true,"messageTitle":"Update from master branch","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"2cb9af8a537c8607c71965ea3dc973dbd77bde63","isMergeCommit":true,"messageTitle":"Merge pull request #2 from DaRealTristan/branch-A-CodeQuality","messageBody":"Branch a code quality","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"807059f10bbceab5f1d94387b5f0e9816bc05678","isMergeCommit":true,"messageTitle":"Merge pull request #3 from DaRealTristan/branch-A-Streams","messageBody":"TaskList: Add Streams to find feature","tags":["A-Streams"],"fileTypesAndContributionMap":{}},{"hash":"534e2eb65db4da30789866750722178fce7d60c6","isMergeCommit":false,"messageTitle":"Revert \"Merge pull request #2 from DaRealTristan/branch-A-CodeQuality\"","messageBody":"This reverts commit 2cb9af8a537c8607c71965ea3dc973dbd77bde63, reversing\nchanges made to 6da0ec9f475bfe45ed0b708b1675f5e733633633.\n","fileTypesAndContributionMap":{"java":{"insertions":108,"deletions":124}}},{"hash":"64073e9d5d3f34d37f2f2c04cc4c496670eff675","isMergeCommit":false,"messageTitle":"Reapply \"Merge pull request #2 from DaRealTristan/branch-A-CodeQuality\"","messageBody":"This reverts commit 534e2eb65db4da30789866750722178fce7d60c6.\n","fileTypesAndContributionMap":{"java":{"insertions":124,"deletions":108}}}]},{"date":"2026-09-09T00:00:00","commitResults":[{"hash":"64539fb898d48438ec11a6ca24b08565edc0eeba","isMergeCommit":false,"messageTitle":"Add CI yml file","messageBody":"","tags":["A-CI"],"fileTypesAndContributionMap":{"txt":{"insertions":2,"deletions":2}}},{"hash":"02e060dd330df710ec67292ff1cccee2b5c24b0d","isMergeCommit":true,"messageTitle":"Merge pull request #4 from DaRealTristan/branch-A-CI","messageBody":"Add CI yml file","fileTypesAndContributionMap":{}},{"hash":"f90593bfdcbc25811198d6dd1780ed9456755128","isMergeCommit":false,"messageTitle":"Deadline: Add getDeadline method","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":7,"deletions"