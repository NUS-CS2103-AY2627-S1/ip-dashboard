t":false,"messageTitle":"Implement A-MoreOOP","messageBody":"","tags":["A-MoreOOP"],"fileTypesAndContributionMap":{"java":{"insertions":397,"deletions":261}}},{"hash":"2db2c50090dbab2779db6047442c89b0c8ed5a8a","isMergeCommit":false,"messageTitle":"Implement A-Packages","messageBody":"","tags":["A-Packages"],"fileTypesAndContributionMap":{"txt":{"insertions":0,"deletions":1},"java":{"insertions":98,"deletions":1},"md":{"insertions":1,"deletions":1}}},{"hash":"8e21f239f741294e958241d16e40d8dc1f4126c3","isMergeCommit":true,"messageTitle":"Merge add-gradle-support into master","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"040943a59aea46b423cb50b3cb8b53fd422b6fff","isMergeCommit":false,"messageTitle":"Complete A-Gradle increment setup","messageBody":"","tags":["A-Gradle"],"fileTypesAndContributionMap":{"gradle":{"insertions":2,"deletions":2},"txt":{"insertions":1,"deletions":0}}},{"hash":"956a9ad551fbb97ea4798fda66ada607870a5807","isMergeCommit":false,"messageTitle":"Implement A-JUnit","messageBody":"","tags":["A-JUnit"],"fileTypesAndContributionMap":{"java":{"insertions":473,"deletions":0},"md":{"insertions":4,"deletions":0}}},{"hash":"f1cdf44ec00046589235d8d419f02c8abf4faee5","isMergeCommit":false,"messageTitle":"Enable shadow plugin for A-Jar","messageBody":"","tags":["A-Jar"],"fileTypesAndContributionMap":{"gradle":{"insertions":1,"deletions":0}}},{"hash":"479beb0a54e52c2f6f40c6e07d1a3ac795d141a4","isMergeCommit":false,"messageTitle":"Add JavaDoc documentation across classes","messageBody":"","tags":["A-JavaDoc"],"fileTypesAndContributionMap":{"java":{"insertions":433,"deletions":0}}},{"hash":"4e737ee4c9db55bf3f3fbb3de59543d7111f16b2","isMergeCommit":false,"messageTitle":"Refactor code to meet coding standards","messageBody":"","tags":["A-CodingStandard"],"fileTypesAndContributionMap":{"md":{"insertions":99,"deletions":0}}},{"hash":"114a40ef0537b5423aa49d9d8aab2ed1a37e0398","isMergeCommit":false,"messageTitle":"Implement Level-9 find feature","messageBody":"","tags":["Level-9"],"fileTypesAndContributionMap":{"txt":{"insertions":2,"deletions":0},"java":{"insertions":106,"deletions":2}}},{"hash":"faa02e4382c8b50507e9614f0d59a38fba4eab89","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CodingStandard\u0027","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"39a83069db5ea2c5eb270492d736df5fd25d7e78","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-9\u0027","messageBody":"","fileTypesAndContributionMap":{}}]},{"date":"2026-09-03T00:00:00","commitResults":[{"hash":"2f47416c7c65da499e5b021fd1e2feb84322c539","isMergeCommit":false,"messageTitle":"improve coding standards","messageBody":"","fileTypesAndContributionMap":{"txt":{"insertions":1,"deletions":0},"java":{"insertions":323,"deletions":175},"md":{"insertions":50,"deletions":28}}},{"hash":"a1892773d036a6693c74a9e32c64872ab9af02ee","isMergeCommit":false,"messageTitle":"Complete Level-10 updates","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{"gradle":{"insertions":19,"deletions":1},"fxml":{"insertions":95,"deletions":0},"java":{"insertions":501,"deletions":34},"md":{"insertions":20,"deletions":19}}}]},{"date":"2026-09-10T00:00:00","commitResults":[{"hash":"9c75404a74999fc718512d964d53639fd584769d","isMergeCommit":false,"messageTitle":"Add GitHub Actions workflow for CI","messageBody":"Automated builds and tests are required to verify code on pushes\nand pull requests. Let\u0027s add a Gradle CI workflow configuration\nfile under .github/workflows/ to catch integration errors early.\n","tags":["A-CI"],"fileTypesAndContributionMap":{"gradle":{"insertions":6,"deletions":0}}}]},{"date":"2026-09-11T00:00:00","commitResults":[{"hash":"5a489e9accdfb3465a083fc192a4fa5c9d12b4dc","isMergeCommit":false,"messageTitle":"Add assertions to core logic","messageBody":"Null pointers or invalid states can cause silent bugs during execution.\nLet\u0027s add Java assertions to key classes like Parser and TaskList to\nexplicitly catch invalid runtime states early.\n","fileTypesAndContributionMap":{"gradle":{"insertions":1,"deletions":0},"java":{"insertions":29,"deletions":0},"md":{"insertions":20,"deletions":0}}},{"hash":"9cbec123bf00c57c755a89bc379682d651965cdc","isMergeCommit":false,"messageTitle":"Share task date parsing and display rules","messageBody":"Deadline and Event duplicated date formats, parsing fallbacks, and\nmidnight display rules. Updating one copy could leave the other with\ndifferent behavior, and nested exception handlers obscured the flow.\n\nExtract TaskDateTime to keep those rules in one place and try each\nformat through a small helper. Preserve the existing public methods,\naccepted formats, and fallback text.\n\nThis follows the code quality guidelines on minimizing duplication\nand avoiding deep nesting. Add regression tests for every format,\nblank and unsupported input, and fallback display behavior.\n\nValidation: all 33 JUnit tests and all 10 CLI UI scenarios pass on\nJava 25.\n","fileTypesAndContributionMap":{"java":{"insertions":144,"deletions":110}}},{"hash":"4062e9d76f8c7a96c6ef0c51dd7f0e91d7848d6f","isMergeCommit":false,"messageTitle":"Separate command parsing from validation","messageBody":"Parser.parse mixed command selection with every argument format and\nvalidation rule. Its length made individual command behavior hard to\nfollow, while numeric substring offsets hid their meaning.\n\nExtract focused parsers for task commands and share task-number\nvalidation. Derive argument offsets from command and delimiter lengths\nso those values cannot drift when their text changes.\n\nThis applies the guidelines on short methods, consistent abstraction,\nand avoiding magic numbers. Preserve command matching, error messages,\nand accepted date values with regression tests.\n\nValidation: all 38 JUnit tests and all 10 CLI UI scenarios pass on\nJava 25.\n","fileTypesAndContributionMap":{"java":{"insertions":192,"deletions":63}}},{"hash":"fe5059ed9b8be2eb00aa03b8621a0e0064e4df86","isMergeCommit":false,"messageTitle":"Separate task records from storage file access","messageBody":"Storage mixed file operations with record parsing and serialization.\nRepeated date formatting branches and unexplained field offsets made\nthe persisted format difficult to inspect and change safely.\n\nExtract TaskCodec with named field positions and small methods for\ntask creation and stored-time formatting. Storage now delegates record\nconversion while retaining its existing file and recovery behavior.\n\nThis follows the guidelines on logical structure, short methods,\nconsistent abstraction, and minimizing duplication. Add tests for\nexact records, free-text times, malformed fields, blank lines, and\nrecovery when corruption follows a valid record.\n\nValidation: all 45 JUnit tests and all 10 CLI UI scenarios pass on\nJava 25.\n","fileTypesAndContributionMap":{"java":{"insertions":210,"deletions":95}}},{"hash":"2ff92381f2e6e1247ebe16838be7f67bd87af4b3","isMergeCommit":false,"messageTitle":"Use Java Streams for task filtering","messageBody":"Traditional loops make filtering collections verbose and repetitive.\nLet\u0027s refactor the find feature to use Java Streams for cleaner,\nmore declarative collection processing.\n","fileTypesAndContributionMap":{"java":{"insertions":37,"deletions":8}}},{"hash":"4e7de1746d8693ea1da2284a35ce151aeb670271","isMergeCommit":true,"messageTitle":"Merge pull request #1 from codeforce233/branch-A-Assertions","messageBody":"Add assertions to core logic","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"08b4e95a0637dbfd30477f03c0f4ce410c2c7a95","isMergeCommit":true,"messageTitle":"fix conflicts","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"db7f40afbbff8807e89dddc4e172a1be5e218f54","isMergeCommit":true,"messageTitle":"fix conflicts","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"31c26e387dec8c1f6292e69233a58984dc435d88","isMergeCommit":true,"messageTitle":"Merge pull request #2 from codeforce233/branch-A-CodeQuality","messageBody":"Branch a code quality","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"8f4b8f520d2d91424664769f5287ab17426f4dd0","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"266330b65a48c41e611b32709c12a24b16c7ff37","isMergeCommit":true,"messageTitle":"Merge pull request #3 from codeforce233/branch-A-Streams","messageBody":"Use Java Streams for task filtering","tags":["A-Streams"],"fileTypesAndContributionMap":{}},{"hash":"5c3fcce1714196b42faeff43313580d3013d2ca3","isMergeCommit":false,"messageTitle":"Add notes function for BCD-Extension","messageBody":"","tags":["BCD-Extension"],"fileTypesAndContributionMap":{"java":{"insertions":175,"deletions":97},"md":{"insertions":28,"deletions":5}}}]}]},"authorFileTypeContributionMap":{"codeforce233":{"java":2888,"md":320,"fxml":95,"sh":0,"bat":0,"gradle":28,"txt":4}},"authorContributionVariance":{"codeforce233":298837.94},"authorDisplayNameMap":{"codeforce233":"CS2103T-W09-1 NALL..LAJI"}}
