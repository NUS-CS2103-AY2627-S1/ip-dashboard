rsation. */","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"Lew1sWong"},"content":"    private static final String COMMAND_BYE \u003d \"bye\";","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"Lew1sWong"},"content":"","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"Lew1sWong"},"content":"    /** Command that shows everything stored so far. */","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"Lew1sWong"},"content":"    private static final String COMMAND_LIST \u003d \"list\";","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"Lew1sWong"},"content":"","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"Lew1sWong"},"content":"    /** Upper bound on how many tasks can be stored, as allowed by the Level-2 requirements. */","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"Lew1sWong"},"content":"    private static final int MAX_TASKS \u003d 100;","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"Lew1sWong"},"content":"","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"Lew1sWong"},"content":"    public static void main(String[] args) {","lastModifiedDate":"2026-08-19T17:41:45","isFullCredit":false},{"lineNumber":23,"author":{"gitId":"Lew1sWong"},"content":"        printGreeting();","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":24,"author":{"gitId":"Lew1sWong"},"content":"","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":25,"author":{"gitId":"Lew1sWong"},"content":"        // A fixed-size array is enough here because the requirements let us assume","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":26,"author":{"gitId":"Lew1sWong"},"content":"        // at most 100 tasks. A resizable ArrayList comes later, in A-Collections.","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":27,"author":{"gitId":"Lew1sWong"},"content":"        String[] tasks \u003d new String[MAX_TASKS];","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":28,"author":{"gitId":"Lew1sWong"},"content":"","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":29,"author":{"gitId":"Lew1sWong"},"content":"        // Number of tasks stored so far, which is also the index of the next free slot.","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":30,"author":{"gitId":"Lew1sWong"},"content":"        int taskCount \u003d 0;","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":31,"author":{"gitId":"Lew1sWong"},"content":"","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":32,"author":{"gitId":"Lew1sWong"},"content":"        // Scanner reads the user\u0027s input from standard input (the console), one line at a time.","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":33,"author":{"gitId":"Lew1sWong"},"content":"        Scanner scanner \u003d new Scanner(System.in);","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":34,"author":{"gitId":"Lew1sWong"},"content":"","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":35,"author":{"gitId":"Lew1sWong"},"content":"        // hasNextLine() guards against the input stream ending without a \"bye\"","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":36,"author":{"gitId":"Lew1sWong"},"content":"        // (e.g. when input is piped in from a file, or the user presses Ctrl+D).","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":37,"author":{"gitId":"Lew1sWong"},"content":"        // Without it, nextLine() would throw a NoSuchElementException.","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":38,"author":{"gitId":"Lew1sWong"},"content":"        while (scanner.hasNextLine()) {","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":39,"author":{"gitId":"Lew1sWong"},"content":"            String command \u003d scanner.nextLine().trim();","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":40,"author":{"gitId":"Lew1sWong"},"content":"","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":41,"author":{"gitId":"Lew1sWong"},"content":"            if (command.equals(COMMAND_BYE)) {","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":42,"author":{"gitId":"Lew1sWong"},"content":"                break;","lastModifiedDate":"2026-08-19T18:11:11","isFullCredit":false},{"lineNumber":43,"author":{"gitId":"Lew1sWong"},"content":"            } else if (command.equals(COMMAND_LIST)) {","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":44,"author":{"gitId":"Lew1sWong"},"content":"                printTasks(tasks, taskCount);","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":45,"author":{"gitId":"Lew1sWong"},"content":"            } else {","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":46,"author":{"gitId":"Lew1sWong"},"content":"                // Anything that is not a known command is stored as a new task.","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":47,"author":{"gitId":"Lew1sWong"},"content":"                tasks[taskCount] \u003d command;","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":48,"author":{"gitId":"Lew1sWong"},"content":"                taskCount++;","lastModifiedDate":"2026-08-20T18:25:07","isFullCredit":false},{"lineNumber":49,"author":{"gi