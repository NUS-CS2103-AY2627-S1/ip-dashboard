3},"md":{"insertions":298,"deletions":3}}},{"hash":"3056340f1b05fcd8b00c6d0f7a0a65b81a0c0c60","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-7\u0027","messageBody":"","tags":["Level-7"],"fileTypesAndContributionMap":{}}]},{"date":"2026-08-23T00:00:00","commitResults":[{"hash":"8050e493819d564595eedfd326c2b48b0eecdf0d","isMergeCommit":false,"messageTitle":"Format deadline dates for display","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":48,"deletions":11},"md":{"insertions":42,"deletions":36}}},{"hash":"fbd41924c543056e783608ef8c8ebf5cdcfd7d50","isMergeCommit":false,"messageTitle":"Add date-based task filtering","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":88,"deletions":1},"md":{"insertions":85,"deletions":0}}},{"hash":"15e11429235de40556c11cf17dd52e803f2597dd","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-8\u0027","messageBody":"","tags":["Level-8"],"fileTypesAndContributionMap":{}},{"hash":"3ba4b8ae695657528a5399106e1b36c1147ae718","isMergeCommit":false,"messageTitle":"Extract console interaction into Ui","messageBody":"Move the banner, separators, command input, and repeated task-added response out of Pixel and into a dedicated Ui class.\n\nRoute the remaining console messages through Ui without changing observable behavior. This creates a focused input/output boundary and is the first incremental step toward a smaller orchestration class.\n","fileTypesAndContributionMap":{"java":{"insertions":122,"deletions":81}}},{"hash":"d22bafefa89f748778a51174fe3873358cd561a7","isMergeCommit":false,"messageTitle":"Extract task persistence into Storage","messageBody":"Move the configurable data path, task loading, record validation, and atomic file saving out of Pixel and into a dedicated Storage class.\n\nKeep Pixel responsible for orchestration and user-facing save errors while preserving the existing relative OS-independent path, storage format, and console behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":96,"deletions":72}}},{"hash":"f36e7f947daabf5f6e0411945b80de2b6ff425f5","isMergeCommit":false,"messageTitle":"Encapsulate task collection in TaskList","messageBody":"Introduce TaskList as the owner of the in-memory ArrayList and centralize add, delete, lookup, index validation, mark, and unmark operations.\n\nUpdate Pixel to use task-list operations and Storage to serialize the wrapper directly. This removes direct collection mutation from the orchestrator while preserving command behavior, ordering, and the saved-data format.\n","fileTypesAndContributionMap":{"java":{"insertions":94,"deletions":18}}},{"hash":"5d5d6718c023c22cc88eecea4d861670c6d995ce","isMergeCommit":false,"messageTitle":"Extract command interpretation into Parser","messageBody":"Move command recognition, argument extraction, task-number conversion, date parsing, delimiter validation, and task construction out of Pixel and CommandType into a dedicated Parser class.\n\nKeep Pixel responsible for executing parsed commands and displaying responses. Consolidate the three task-creation paths while preserving all existing validation messages, command syntax, and observable behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":184,"deletions":133}}},{"hash":"8e930066450dc2036f67b128c5b4b7cf98629bf5","isMergeCommit":false,"messageTitle":"Make Pixel an instance-based orchestrator","messageBody":"Promote Ui, Storage, Parser, TaskList, and loading warnings to Pixel fields initialized by a Path-based constructor, and move the console session into run().\n\nReduce main() to supplying the default relative OS-independent data path. This establishes stable collaborators that future Command objects can receive during execution without changing observable behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":31,"deletions":12}}},{"hash":"7412210fd6d4c263e2ccb41bc15eda4434ae73af","isMergeCommit":false,"messageTitle":"Introduce Command hierarchy with ExitCommand","messageBody":"Add an abstract Command execution contract that receives TaskList, Ui, and Storage collaborators and provides a default non-exit state.\n\nMove the farewell and exit signal into ExitCommand, then update Pixel to terminate through Command.isExit(). This establishes the stretch-goal command API while deliberately leaving other commands in the existing dispatcher for later incremental migration.\n","fileTypesAndContributionMap":{"java":{"insertions":43,"deletions":3}}},{"hash":"9ca449e2b112adf073d2fa624ab94beb7c218007","isMergeCommit":false,"messageTitle":"Extract list and unknown command behavior","messageBody":"Add ListCommand to render the numbered task list and UnknownCommand to own the unrecognized-command response, both through the shared Command execution contract.\n\nReplace the corresponding response logic in Pixel while leaving parsing, separators, and all state-changing commands untouched for later incremental migration.\n","fileTypesAndContributionMap":{"java":{"insertions":27,"deletions":5}}},{"hash":"395ba6bb9f6af568d6b6e669da48b069c7ede6c7","isMergeCommit":false,"messageTitle":"Extract date query into DateCommand","messageBody":"Add DateCommand with a parsed LocalDate so it owns matching-task traversal, original list numbering, the first-match heading, and the no-match response.\n\nKeep raw date validation in Parser and reduce Pixel to constructing and executing the query command while preserving invalid-date handling and console formatting.\n","fileTypesAndContributionMap":{"java":{"insertions":38,"deletions":17}}},{"hash":"3eb20835c1c3ef38ba58238f936aa6f383f8913b","isMergeCommit":false,"messageTitle":"Complete command-based execution architecture","messageBody":"Add command objects for task creation, marking, unmarking, and deletion, and centralize safe persistence for mutating commands. Make Parser the factory for every supported command so Pixel can use one parse-execute-exit loop while preserving existing console output and failure handling.\n","fileTypesAndContributionMap":{"java":{"insertions":158,"deletions":96}}},{"hash":"fe2f110a87522f8fb4fad8579f952485b933a794","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-MoreOOP\u0027","messageBody":"","tags":["A-MoreOOP"],"fileTypesAndContributionMap":{}},{"hash":"402e7c905153825ffb2b81948a869c2e5ebefadc","isMergeCommit":false,"messageTitle":"Organise the classes into packages","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":100,"deletions":4},"md":{"insertions":1,"deletions":1}}},{"hash":"4fb18843b5b0ca95a3d2103f17ea995e1e36288a","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-Packages\u0027","messageBody":"","tags":["A-Packages"],"fileTypesAndContributionMap":{}},{"hash":"44284262f2c7eda4a6c575b32a0f1ac0f98e4f2a","isMergeCommit":true,"messageTitle":"Merge branch \u0027add-gradle-support\u0027","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"d3c6f55d6934a38745b10d9f2bca9bd1af540cd0","isMergeCommit":false,"messageTitle":"Set up Gradle","messageBody":"","tags":["A-Gradle"],"fileTypesAndContributionMap":{"gradle":{"insertions":1,"deletions":1}}},{"hash":"95944c27c1f57a395f557b9f53fbf3c32e905d4b","isMergeCommit":false,"messageTitle":"Add JUnit tests","messageBody":"","tags":["A-JUnit"],"fileTypesAndContributionMap":{"java":{"insertions":383,"deletions":0},"md":{"insertions":8,"deletions":0}}},{"hash":"2d35069aa24f7bc9baf27f0fcfdf5396884cd84f","isMergeCommit":false,"messageTitle":"Rename JAR file","messageBody":"","tags":["A-Jar"],"fileTypesAndContributionMap":{"gradle":{"insertions":1,"deletions":1}}},{"hash":"3b4f7500b2b1e9eec1b68aa81a33a2bcf59683d3","isMergeCommit":false,"messageTitle":"Add JavaDoc comments","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":35,"deletions":0}}},{"hash":"4141dc97c08273c36bf728f2700095f6180774ff","isMergeCommit":false,"messageTitle":"Apply SE-EDU Java standard","messageBody":"Java sources use consistent imports and switch formatting.\n\nAdd complete Javadocs for public APIs, constructors, enum constants, and task state fields so generated documentation is warning-free.\n\nPreserve runtime behavior while aligning the code with the project Java coding standard.\n","fileTypesAndContributionMap":{"java":{"insertions":147,"deletions":44}}},{"hash":"f9cc0f06684f8801b1900ed4ae105cd01c585de0","isMergeCommit":false,"messageTitle":"Add Java coding standard skill","messageBody":"Java style guidance is needed to keep production and test code consistent.\n\nAdd a project skill based on the SE-EDU standard and require agents to apply it when writing, reviewing, or refactoring Java.\n\nKeep the guidance local to this repository so future code changes follow the same package, layout, import, and Javadoc rules.\n","fileTypesAndContributionMap":{"md":{"insertions":68,"deletions":0}}},{"hash":"f50e09eaa0e1ec4c31f92e09391506641fefc6a1","isMergeCommit":false,"messageTitle":"Add Git conventions skill","messageBody":"Commit and branch guidance is needed to keep repository history consistent.\n\nAdd a project skill based on the SE-EDU Git conventions and require agents to apply it before future commits.\n\nDocument subject, body, branch naming, and staged-diff review rules in the repository guidance.\n","fileTypesAndContributionMap":{"md":{"insertions":47,"deletions":0}}},{"hash":"1b6101f730b3c5d16109f539138e2b72533a5040","isMergeCommit":false,"messageTitle":"Add find command for keyword task","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":68,"deletions":2}}},{"hash":"2c102f866c82b9811b4ea1bec91eecd95c2cdc2d","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-JavaDoc\u0027","messageBody":"","tags":["A-JavaDoc"],"fileTypesAndContributionMap":{}},{"hash":"364b6524710da702f8eec91da2fd444884774593","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CodingStandard\u0027","messageBody":"","tags":["A-CodingStandard"],"fileTypesAndContributionMap":{}},{"hash":"eab96978f8454d7