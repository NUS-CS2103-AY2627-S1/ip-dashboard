\", or the input runs out.","lastModifiedDate":"2026-08-20T02:20:28","isFullCredit":false},{"lineNumber":36,"author":{"gitId":"skhaw2004"},"content":"            while (scanner.hasNextLine()) {","lastModifiedDate":"2026-08-20T02:20:28","isFullCredit":false},{"lineNumber":37,"author":{"gitId":"skhaw2004"},"content":"                String command \u003d scanner.nextLine();","lastModifiedDate":"2026-08-20T02:27:37","isFullCredit":false},{"lineNumber":38,"author":{"gitId":"skhaw2004"},"content":"                String trimmedCommand \u003d command.trim();","lastModifiedDate":"2026-08-20T02:30:15","isFullCredit":false},{"lineNumber":39,"author":{"gitId":"skhaw2004"},"content":"                if (trimmedCommand.equals(\"bye\")) {","lastModifiedDate":"2026-08-20T02:30:15","isFullCredit":false},{"lineNumber":40,"author":{"gitId":"skhaw2004"},"content":"                    break;","lastModifiedDate":"2026-08-20T02:20:28","isFullCredit":false},{"lineNumber":41,"author":{"gitId":"skhaw2004"},"content":"                } else if (trimmedCommand.equals(\"list\")) {","lastModifiedDate":"2026-08-20T02:30:15","isFullCredit":false},{"lineNumber":42,"author":{"gitId":"skhaw2004"},"content":"                    reply(listItems(items, itemCount));","lastModifiedDate":"2026-08-20T02:30:15","isFullCredit":false},{"lineNumber":43,"author":{"gitId":"skhaw2004"},"content":"                } else if (itemCount \u003e\u003d MAX_ITEMS) {","lastModifiedDate":"2026-08-20T02:33:26","isFullCredit":false},{"lineNumber":44,"author":{"gitId":"skhaw2004"},"content":"                    reply(\"Sorry, I can\u0027t store more than \" + MAX_ITEMS + \" items.\");","lastModifiedDate":"2026-08-20T02:33:26","isFullCredit":false},{"lineNumber":45,"author":{"gitId":"skhaw2004"},"content":"                } else {","lastModifiedDate":"2026-08-20T02:30:15","isFullCredit":false},{"lineNumber":46,"author":{"gitId":"skhaw2004"},"content":"                    items[itemCount] \u003d command;","lastModifiedDate":"2