24643830cea1aa9a3da0977066e","isMergeCommit":false,"messageTitle":"fix: updated mainClass on Line 40","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":2,"deletions":2}}},{"hash":"146a61d3e14a06198df70868a3c5f97c3beb3fce","isMergeCommit":false,"messageTitle":"feat: add JUnit tests","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":507,"deletions":0},"md":{"insertions":6,"deletions":0}}},{"hash":"208275b9c0cd443ef4668bc65df140ef22e7d81e","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-JUnit\u0027 into master","messageBody":"","tags":["A-JUnit"],"fileTypesAndContributionMap":{}}]},{"date":"2026-08-29T00:00:00","commitResults":[{"hash":"b8af0fed4389defab5eaa381f99f79757bc794ca","isMergeCommit":false,"messageTitle":"docs: add JavaDoc to methods to hit stretch goal","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":406,"deletions":17}}},{"hash":"739e95f7a4f87eb07e2a9b9fce45ebc4f940c02e","isMergeCommit":false,"messageTitle":"Fix Java code to follow SE-EDU coding standard","messageBody":"The project now mandates the SE-EDU intermediate Java coding\nstandard (see AGENTS.md and the seedu-java-coding-standard\nskill). Bring the existing codebase into compliance:\n\n- Make Task\u0027s description/isCompleted fields private, since Task\n  has real behaviour and the standard forbids public fields on a\n  class that isn\u0027t a pure data holder.\n- Rename Task.getCompleted() to isCompleted() to match the\n  boolean-method naming convention, and update its three call\n  sites in TaskManagerTest and ParserTest.\n- Fix K\u0026R brace violations in Storage.parseTask/createPath and\n  TaskManager.printTasks, where else/catch were on their own\n  line instead of attached to the preceding closing brace.\n- Reorder imports in the four test classes where java.* was\n  sitting after org.junit.*, reversed from the required order.\n- Wrap three String.format calls in the exception constructors\n  that exceeded the 120-character line limit.\n","fileTypesAndContributionMap":{"java":{"insertions":41,"deletions":41}}},{"hash":"b724ac1d70c0bc9f9a58b05933c3c98905bded8f","isMergeCommit":false,"messageTitle":"Add SE-EDU Java coding standard skill","messageBody":"Create the seedu-java-coding-standard skill, capturing the SE-EDU\nintermediate Java conventions (naming, brace style, imports, line\nlength, comments) in full. Mandate it in AGENTS.md so all Java\ncode written or edited in this project follows it going forward,\nnot just the code already brought into compliance in the previous\ncommit.\n","fileTypesAndContributionMap":{"md":{"insertions":86,"deletions":0}}},{"hash":"2d7b034cff0feb0eaf77f36f4a181c1e79ae68c1","isMergeCommit":false,"messageTitle":"Add SE-EDU git conventions skill","messageBody":"Create the seedu-git-standard skill, capturing the SE-EDU git\nconventions (commit subject/body format, branch naming) in full.\nMandate it in AGENTS.md so all future commit messages and branch\nnames — including ones only proposed for review, not yet\ncommitted — follow it.\n","fileTypesAndContributionMap":{"md":{"insertions":39,"deletions":1}}},{"hash":"1780ce313e846d6045b9b9463c06414bad43838b","isMergeCommit":false,"messageTitle":"Add find command to search tasks by keyword","messageBody":"Level-9 requires letting users find tasks by a keyword in their\ndescription. Add TaskManager.printTasksByName(String), which\nlists every task whose description contains the keyword,\nnumbered from 1, or a message if none match. Wire it into\nParser as the \"find\" command, matching both a bare \"find\"\n(which throws MissingDescriptionException, same as every other\ncommand missing its required argument) and \"find \u003ckeyword\u003e\".\n","fileTypesAndContributionMap":{"java":{"insertions":29,"deletions":2}}},{"hash":"432794318b6905b6f18d3a5f627a2f296a298471","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-JavaDoc\u0027 into master","messageBody":"","tags":["A-JavaDoc"],"fileTyp