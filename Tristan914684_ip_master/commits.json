.\n\nThis reduces the length and nesting of getResponse and keeps command\ndispatch at one abstraction level, making the happy path easier to scan\nand future command changes safer. Behavior, persistence order, and\nuser-facing responses remain unchanged.\n","fileTypesAndContributionMap":{"java":{"insertions":38,"deletions":38}}},{"hash":"ebb21f28b3a472291bc567234160f86dfa704092","isMergeCommit":false,"messageTitle":"Storage: Name task format markers","messageBody":"Replace storage format literals with named constants for task markers,\nthe completed status, and the field separator.\n\nThe file format remains unchanged, but its representation is now\nself-documenting and easier to update safely. This removes magic\nliterals from the loading logic and makes the persistence format\nclearer to future maintainers.\n","fileTypesAndContributionMap":{"java":{"insertions":11,"deletions":5}}},{"hash":"d5dd28f9cbe462ad5faa6e6ada7db138edad40d0","isMergeCommit":true,"messageTitle":"Merge pull request #1 from Tristan914684/branch-A-Assertions","messageBody":"Add Java assertions for internal invariants","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"54243b4c54948f6acd140a859438c2fd3139e9fe","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"b2445d36f3f45b7a692a9dc8dae7a19ced0eeeaa","isMergeCommit":true,"messageTitle":"Merge pull request #2 from Tristan914684/branch-A-CodeQuality","messageBody":"Branch a code quality","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionMap":{"Tristan914684":{"java":1153,"md":54,"fxml":68,"sh":0,"bat":0,"gradle":23,"txt":0}},"authorContributionVariance":{"Tristan914684":44608.2},"authorDisplayNameMap":{"Tristan914684":"CS2103T-F11-4 LYN ..STAN"}}
