:00","commitResults":[{"hash":"fb5d94a1b99718d58c7ae89358a2f8b87d44a094","isMergeCommit":false,"messageTitle":"Use checkstyle","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":5,"deletions":0},"java":{"insertions":154,"deletions":227},"md":{"insertions":19,"deletions":0}}},{"hash":"0b2ca9d0304fc88535724b93d4a0cfe8c1b37f76","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CheckStyle\u0027","messageBody":"","tags":["A-CheckStyle"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-02T00:00:00","commitResults":[{"hash":"5e2d3de497fe4def160872cf76fff50545cd35e9","isMergeCommit":false,"messageTitle":"Level 10","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{"gradle":{"insertions":16,"deletions":1},"fxml":{"insertions":90,"deletions":0},"java":{"insertions":221,"deletions":3},"md":{"insertions":8,"deletions":16}}}]},{"date":"2026-09-07T00:00:00","commitResults":[{"hash":"816014d53249df77823afc1ee07e6d1ca5404835","isMergeCommit":false,"messageTitle":"Add assertions for internal assumptions","messageBody":"Important assumptions made in command handling and GUI setup are\nunchecked, making programming errors hard to locate\n\nAdd assertions to locate assumptions and detect problems early\nContinue using normal exceptions for invalid user input\n","fileTypesAndContributionMap":{"java":{"insertions":278,"deletions":72},"md":{"insertions":3,"deletions":3}}},{"hash":"415b4b8f9bdbf372f81d1529f080dc236adfeafb","isMergeCommit":false,"messageTitle":"Refactor Lumi command handling","messageBody":"Lumi\u0027s main method handles startup, input, command dispatch, task\nupdates, and persistence in one long block. Mixing these abstraction\nlevels makes the application flow difficult to scan and maintain.\n\nExtract the stages into focused methods with explicit command routing.\nThis keeps the main workflow prominent, reduces duplicated status\nhandling, and makes each operation easier to understand in isolation.\n","fileTypesAndContributionMap":{"java":{"insertions":115,"deletions":38}}},{"hash":"862822c89b79c836460a836d2559d5a20607eef8","isMergeCommit":false,"messageTitle":"Simplify task parsing","messageBody":"Parser.parseTask handles every task format in one long method and\nrepeats command-detail extraction. Short names for date text also make\nthe parsing flow harder to follow.\n\nDelegate each format to a focused parser, centralize command\nseparators, and use names that describe each date value. This keeps\neach method at one abstraction level and makes validation easier to\nscan.\n","fileTypesAndContributionMap":{"java":{"insertions":77,"deletions":50}}},{"hash":"ac93c31db2c60a29d38f6ef6b9891e2b9351210a","isMergeCommit":false,"messageTitle":"Simplify storage record parsing","messageBody":"Storage combines record validation, status decoding, task creation,\nand escape handling in long, nested methods. This makes malformed-data\npaths difficult to follow and increases the cost of changing the file\nformat.\n\nSeparate each responsibility into a focused helper and use explicit\nswitch defaults for invalid values. This reduces nesting and lets the\nstorage workflow read from validation through task construction.\n","fileTypesAndContributionMap":{"java":{"insertions":56,"deletions":36}}},{"hash":"80dfe3ac163f91fe4ca80a5b80687f8dd3b297c9","isMergeCommit":false,"messageTitle":"Restrict task field visibility","messageBody":"Task details use protected mutable fields even though subclasses\naccess them only through inherited behavior. The wider visibility\npermits unintended state changes and obscures which values may change.\n\nMake task descriptions and date fields private and final, and keep only\ncompletion status mutable. This narrows the state exposed to subclasses\nand makes each task\u0027s invariants easier to understand.\n","fileTypesAndContributionMap":{"java":{"insertions":5,"deletions":5}}},{"hash":"18d8c6ac124555b6a2af8a6953cc303e08022454","isMergeCommit":false,"messageTitle":"Fail fast when layouts cannot load","messageBody":"FXML loading failures print a stack trace and allow execution to\ncontinue. This hides the startup problem and can cause a secondary null\nerror that obscures the original failure.\n\nPropagate the main-window error and wrap dialog failures with clear\ncontext. This prevents the application from continuing in an invalid\nstate and preserves the original cause for diagnosis.\n","fileTypesAndContributionMap":{"java":{"insertions":12,"deletions":15}}},{"hash":"476bdaa2e3a3a5fd13ac9b94e5fd58a7801a0d6e","isMergeCommit":true,"messageTitle":"Merge pull request #1 from Jigusheng/branch-A-Assertions","messageBody":"Add assertions for internal assumptions","tags":["A-FullCommitMessage","A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"71a3cc2e3eb0fac87fa408ee6ab3c95145c5a58b","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"Merge branch \u0027master\u0027 into branch\nResolve conflict using master\u0027s implementations as it represents the\ncurrent application design.\n\nPreserve the newer functionality while retiaining the independent parse,\netc.\n","fileTypesAndContributionMap":{}},{"hash":"f36bcf70135124e235126791f2f318b7270b17c5","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CodeQuality\u0027","messageBody":"","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-08T00:00:00","commitResults":[{"hash":"64cef1ae6df0bdc9bf1693a276d74c83dfba8d12","isMergeCommit":false,"messageTitle":"B-snooze extension","messageBody":"","tags":["BCD-Extension"],"fileTypesAndContributionMap":{"txt":{"insertions":2,"deletions":0},"java":{"insertions":224,"deletions":9},"md":{"insertions":95,"deletions":5}}}]}]},"authorFileTypeContributionMap":{"Jigusheng":{"java":2295,"md":708,"fxml":90,"sh":0,"bat":0,"gradle":35,"txt":3}},"authorContributionVariance":{"Jigusheng":109090.93},"authorDisplayNameMap":{"Jigusheng":"CS2103T-T08-4 FENG.