2695584b9f","isMergeCommit":false,"messageTitle":"Revert \"Add personality to Gihun\"","messageBody":"This reverts commit d43ac7a20d314f35ac7f9c6123302aafe90c38cb.\n","tags":["v0.2"],"fileTypesAndContributionMap":{"java":{"insertions":34,"deletions":34}}},{"hash":"5826cb283b541b1068717c54377e1bb1505e8ea2","isMergeCommit":false,"messageTitle":"Add assertions to the codebase","messageBody":"Used the assert feature to document important assumptions that should\nhold at various points in the code.\n\nIn particular:\nTask.java - Task descriptions must not be null\nDeadline.java/Event.java - Object constructors receive a non-null date\nParser.java - Parsed commands must always contain a non-null operation\nand argument string.\nTaskList.java - markTask and unmarkTask require\nan index already validated against the current list.\nStorage.java - Storage must not save a null task list or serialize\na null task.\n","fileTypesAndContributionMap":{"java":{"insertions":12,"deletions":0}}},{"hash":"6e1d4f8492a1abd8aaf0f992851f0408effddf6d","isMergeCommit":false,"messageTitle":"Refactor task creation workflow","messageBody":"Centralize task insertion, persistence, and confirmation formatting\nin a single helper.\n\nThe TODO, deadline, and event branches previously repeated the same\nthree-step workflow, increasing the risk that a future change would\nupdate one command path but not the others.\n\nThe helper keeps these responsibilities together while preserving\ncommand validation, storage behavior, and user-facing responses.\n\nCo-Authored-By: Copilot \u003c223556219+Copilot@users.noreply.github.com\u003e\n","fileTypesAndContributionMap":{"java":{"insertions":16,"deletions":12}}},{"hash":"fef5e0e0135c6d3192c29b7e7d09f7d34a5694cc","isMergeCommit":false,"messageTitle":"Avoid reparsing console commands","messageBody":"Parse each console input once and reuse the resulting ParsedInput for\nboth command execution and bye detection.\n\nPreviously, the run loop parsed the same input once through\nprocessCommand and again to determine whether the application should\nterminate.\n\nThis duplicated work and made the control flow depend on two separate\nparsing calls. The new private execution overload preserves the public\nprocessCommand API for the GUI while ensuring both decisions use the\nsame parsed command.\n\nCo-authored-by: Copilot \u003c223556219+Copilot@users.noreply.github.com\u003e\n","fileTypesAndContributionMap":{"java":{"insertions":14,"deletions":3}}},{"hash":"23128f09e176674cf5ad98ba3c06a22bf8a4c359","isMergeCommit":false,"messageTitle":"Centralize task list persistence","messageBody":"Route all task mutations through a single saveTasks helper instead of\nrepeating the storage snapshot operation in each command branch.\n\nThis keeps persistence behavior consistent for add, mark, unmark, and\ndelete operations and gives future storage-related changes one\nmaintenance point.\n\nThe refactoring does not alter when tasks are saved or how storage\nerrors are propagated\n\nCo-authored-by: Copilot \u003c223556219+Copilot@users.noreply.github.com\u003e\n","fileTypesAndContributionMap":{"java":{"insertions":13,"deletions":4}}},{"hash":"ae69aeceed7d1e3f1d3560d450f0b42e6a1854f7","isMergeCommit":false,"messageTitle":"Refactor codebase to add streams","messageBody":"Refactor: use streams for task matching and operation lookup\n\nReplace manual collection iteration with stream pipelines for task\nkeyword matching and case-insensitive operation lookup while preserving\nexisting ordering and error behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":10,"deletions":17}}},{"hash":"20561b60b3df225c57b1cea9ad8b90139e9b8401","isMergeCommit":true,"messageTitle":"Merge pull request #2 from ry-cy/branch-A-Assertions","messageBody":"Add assertions to the codebase","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"d575506f79cfda12d5d86f679d3cecf492e5ca92","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"b59fef95a7ff87ffe70795ed384346ef4af6a6fe","isMergeCommit":true,"messageTitle":"Merge pull request #3 from ry-cy/branch-A-CodeQuality","messageBody":"Refactor codebase to fix code quality issues","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"5df2eade656f03b104f5d08071d3db387f172fe1","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"76d964e727f1bd876028642100442f500426a265","isMergeCommit":true,"messageTitle":"Merge pull request #4 from ry-cy/branch-A-Streams","messageBody":"Refactor codebase to add streams","tags":["A-Streams"],"fileTypesAndContributionMap":{}},{"hash":"582fac1eeced35e5606d30e375c53c6d73c52198","isMergeCommit":false,"messageTitle":"Implement reminders feature","messageBody":"Implement a reminders feature to the chatbot\n\nDeadlines have a due date and time, and Events have a starting and\nending date and time.\n\nThe reminders feature checks all tasks in the current list, and will\nflag out upcoming and missed Deadlines and Events. The threshold for\nflagging out the respective tasks is 3 days from the current system\ntime.\n\nFor Events which the starting date and time has passed, but the ending\ndate and time has not passed yet, the chatbot will flag the Event as\nmissed.\n","fileTypesAndContributionMap":{"java":{"insertions":329,"deletions":7},"md":{"insertions":72,"deletions":15}}},{"hash":"b83434db1adc2db221b889bdeac884dba5cdaacf","isMergeCommit":false,"messageTitle":"Implement scheduling conflicts feature","messageBody":"Implement scheduling conflicts checking feature to the chatbot\n\nWhen a user wishes to add a new Deadline or Event to their task list,\nthe program will validate against existing tasks in the list for\npotential scheduling conflicts.\n\nThe program will report all conflicts found, if any, and then requires\nexplicit confirmation from the user to add the conflicting task.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"java":{"insertions":320,"deletions":7},"md":{"insertions":39,"deletions":0}}},{"hash":"0c6537e5f8e6af0e63cdab1bb267146abf9b0b3f","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-BCD-Extensions\u0027","messageBody":"","tags":["BCD-Extension"],"fileTypesAndContributionMap":{}},{"hash":"a2c4d5d3f7e53e679df1f3178ae11f1285ae6ef8","isMergeCommit":false,"messageTitle":"Update Gihun456.java","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":1,"deletions":1}}},{"hash":"52fb6fca359cb698b1570c21fb9d389f8299ec9a","isMergeCommit":false,"messageTitle":"Update locale parsing for JUnit tests","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":7,"deletions":5}}}]},{"date":"2026-09-17T00:00:00","commitResults":[{"hash":"8702421a5898d09916f2eade6ea837c077fb90b6","isMergeCommit":false,"messageTitle":"Improve GUI of Gihun456","messageBody":"","fileTypesAndContributionMap":{"fxml":{"insertions":14,"deletions":6},"java":{"insertions":72,"deletions":6}}},{"hash":"7ec3fdba3e772a48e688718bd67d3f27561d9e5f","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-BetterGui\u0027","messageBody":"","tags":["A-BetterGui"],"fileTypesAndContributionMap":{}},{"hash":"2f461fc6cbd4567cc18653e23d6f800b7087a3cd","isMergeCommit":false,"messageTitle":"Add personality to Gihun456","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":59,"deletions":46}}},{"hash":"44d4c0b7d6e52a9b01a2ff53b42156c8c7c71462","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-Personality\u0027","messageBody":"","tags":["A-Personality"],"fileTypesAndContributionMap":{}},{"hash":"4f23789bd8a74c965ddf9140af111a8c75e29b26","isMergeCommit":false,"messageTitle":"Add more JUnit tests","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":414,"deletions":11}}},{"hash":"c1c4e44f2d96ee8e3c16f135056ec791cc0821be","isMergeCommit":