ergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-8\u0027","messageBody":"","tags":["Level-8"],"fileTypesAndContributionMap":{}}]},{"date":"2026-08-28T00:00:00","commitResults":[{"hash":"01a2e990d46f63b164d33abec404579b5bc30051","isMergeCommit":false,"messageTitle":"Refactor Rudra to delegate console interaction to Ui","messageBody":"Extract a dedicated Ui class for console input and output so Rudra no longer mixes user interaction details with command orchestration.\n\nMove the welcome banner, goodbye message, task list rendering, task result messages, and startup error/warning output behind Ui methods while preserving existing console text.\n\nKeep parsing, storage, and task mutation logic unchanged in this increment to make the refactor small, testable, and easy to review.\n","fileTypesAndContributionMap":{"java":{"insertions":173,"deletions":55}}},{"hash":"e086df761a6fdc53a5e60388c51633a286b76cd8","isMergeCommit":false,"messageTitle":"Introduce Parser and Command hierarchy","messageBody":"Refactor Rudra so it parses each user input into a Command object and delegates behavior to concrete command classes instead of a large switch statement.\n\nAdd Parser to validate command formats and construct List, Exit, Todo, Deadline, Event, Mark, Unmark, and Delete commands.\n\nMove task mutation rollback logic into the Command abstraction so command execution remains behaviorally equivalent while reducing Rudra\u0027s responsibilities.\n\nKeep the existing ArrayList-based task container for now so this architectural shift stays focused and can be reviewed independently from a future TaskList extraction.\n","tags":["A-MoreOOP"],"fileTypesAndContributionMap":{"java":{"insertions":398,"deletions":167}}},{"hash":"43e9afe07cad4d27627037fb2734969dcecc4c3d","isMergeCommit":false,"messageTitle":"Organize Rudra classes into Java packages","messageBody":"Move the application entry point under the rudra package and group related classes into command, parser, task, storage, ui, and exception subpackages.\n\nUpdate package declarations and imports throughout the codebase so the class relationships stay the same while the structure becomes easier to navigate and reason about.\n\nAdjust the repo-local UI test runner to compile nested source files and launch rudra.Rudra, and refresh the README path so the documented entry point matches the new layout.\n","tags":["A-Packages"],"fileTypesAndContributionMap":{"java":{"insertions":120,"deletions":0},"md":{"insertions":1,"deletions":1}}},{"hash":"4df6dfbc46b08859afca0cf4520d76ddae6ae972","isMergeCommit":true,"messageTitle":"Merge remote-tracking branch \u0027origin/add-gradle-support\u0027","messageBody":"","tags":["A-JavaDoc","A-Gradle"],"fileTypesAndContributionMap":{}},{"hash":"064661d0838de78ceaab9ffad31420586a513295","isMergeCommit":false,"messageTitle":"Add JUnit Tests","messageBody":"","tags":["A-Jar","A-JUnit"],"fileTypesAndContributionMap":{"gradle":{"insertions":1,"deletions":1},"java":{"insertions":285,"deletions":0},"md":{"insertions":2,"deletions":0}}},{"hash":"7fc50ba5f898cbceef13fa5448196cf4a37b9556","isMergeCommit":false,"messageTitle":"Add JavaDoc","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":145,"deletions":0}}},{"hash":"c6c522659857c0ec960715a3db67217de7f07c76","isMergeCommit":false,"messageTitle":"Add Coding Style and Match Code to it","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":2,"deletions":19},"md":{"insertions":103,"deletions":1}}},{"hash":"3f39e35943472667b157344b721f768b6a8ef7e8","isMergeCommit":false,"messageTitle":"Level 9 Find","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":128,"deletions":4},"md":{"insertions":81,"deletions":1}}},{"hash":"26dba3d2dafeb78fc46bb6d62496182f848bc5e7","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CodingStandard\u0027","messageBody":"","tags":["A-CodingStandard"],"fileTypesAndContributionMap":{}},{"hash":"ac625f92076d9ffa16e8cc554263eba771f2b391","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-9\u0027","messageBody":"","tags":["Level-9"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-02T00:00:00","commitResults":[{"hash":"b3604ec6a5880b0ea144a5d90a9794cbb4a8cf47","isMergeCommit":false,"messageTitle":"Add Checkstyle","messageBody":"","tags":["A-CheckStyle"],"fileTypesAndContributionMap":{"gradle":{"insertions":5,"deletions":0},"java":{"insertions":44,"deletions":45}}},{"hash":"2ec07e1597e13a1abc757d8b6c3691ce4a2aba30","isMergeCommit":false,"messageTitle":"Add GUI using JavaFX","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{"gradle":{"insertions":15,"deletions":1},"txt":{"insertions":3,"deletions":0},"java":{"insertions":312,"deletions":35},"md":{"insertions":25,"deletions":25}}},{"hash":"d4863797c9022d5b588b9d7977dc3ebbaf584464","isMergeCommit":false,"messageTitle":"Add Varargs","messageBody":"","tags":["A-Varargs"],"fileTypesAndContributionMap":{"txt":{"insertions":0,"deletions":3},"java":{"insertions":28,"deletions":6}}}]},{"date":"2026-09-09T00:00:00","commitResults":[{"hash":"9fbad5fc286f7f4d66f8cbf9ec1343db6ab61b66","isMergeCommit":false,"messageTitle":"Add Assertions","messageBody":"","fileTypesAndContributionMap":{"gradle":{"insertions":2,"deletions":0},"java":{"insertions":95,"deletions":0}}},{"hash":"a63708bfdbe7b767bc9b10f9b0683a0bdf3425e8","isMergeCommit":false,"messageTitle":"Centralize task index validation","messageBody":"Mark, unmark, and delete commands enforced the same task-index rule\nwith three copy-pasted methods. Keeping identical validation in separate\nclasses makes future rule or message changes easy to apply inconsistently.\n\nMove the shared validation into Command and pass each command\u0027s index\nexplicitly. This gives task-targeting commands one source of truth while\npreserving existing command behavior and user-facing errors.\n","fileTypesAndContributionMap":{"java":{"insertions":17,"deletions":39}}},{"hash":"c38d10773d16bae77a3128724e3d3665ba80b2bd","isMergeCommit":false,"messageTitle":"Centralize command recognition in Parser","messageBody":"Console and GUI entry points both identified the exit command before\ncalling Parser. This duplicated dispatch policy outside the component\nresponsible for turning input into commands and forced callers to work at\ntwo levels of abstraction.\n\nRepresent bye as a CommandWord and let Parser create ExitCommand like\nevery other supported command. Callers now follow one parse-and-execute\nflow, while focused tests preserve exit and invalid-argument behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":20,"deletions":28}}},{"hash":"a9c7be54d1fd1e5adbcf3d3de298f4f4653816d8","isMergeCommit":false,"messageTitle":"Decompose saved task parsing","messageBody":"Storage.parseTask previously combined record validation, type dispatch,\ntype-specific construction, and status restoration. This made a core\npersistence method harder to scan and forced readers to track several\nlevels of detail at once.\n\nSplit those responsibilities into named helpers so parseTask describes\nthe high-level loading flow. Keep validation and error messages unchanged,\nand add coverage for malformed records of every supported task type.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"java":{"insertions":58,"deletions":21}}},{"hash":"8ded0e0a7f0df92acafebc1dd7292a784d26836b","isMergeCommit":false,"messageTitle":"Add Streams","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":4,"deletions":6}}},{"hash":"15365a453f72ea56baa330ee627e384bedbc5a41","isMergeCommit":true,"messageTitle":"Merge pull request #1 from chetangent/branch-A-Assertions","messageBody":"Add Assertions","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"f2721aafc2313c26a1e083ef70fc285468ea2e9b","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"ea7ea5dc8c85cf63aa2c8f356ae6bb8a3ce6f5f5","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"4c2d955627992f1910c75f0fd604d46d805bd933","isMergeCommit":true,"messageTitle":"Merge pull request #2 from chetangent/branch-A-CodeQuality","messageBody":"Branch a code quality","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"acf98481dcd2999d18212620346f1658b16d48eb","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"d55104115c1bbc1b8980e06a6266622757d151d9","isMergeCommit":true,"messageTitle":"Merge pull request #3 from chetangent/branch-A-Streams","messageBody":"Add Streams","tags":["A-Streams"],"fileTypesAndContributionMap":{}},{"hash":"1b085d45f5ff4189bbb82d4b08734443aa2074da","isMergeCommit":false,"messageTitle":"Add deadline sorting command","messageBody":"Deadlines are difficult to review when they remain in insertion\norder.\n\nAdd a persistent sort command that groups deadlines first in stable\nchronological order while preserving other task ordering. Document the\ncommand and cover parsing, rollback, persistence, and CLI behavior.\n","tags":["BCD-Extension"],"fileTypesAndContributionMap":{"java":{"insertions":249,"deletions":5},"md":{"insertions":69,"deletions":2}}}]}]},"authorFileTypeContributionMap":{"chetangent":{"java":2473,"md":897,"fxml":0,"sh":0,"bat":0,"gradle":22,"txt":1}},"authorContributionVariance":{"chetangent":126107.28},"authorDisplayNameMap":{"chetangent":"CS2103T-T17-2 GULL..ETAN"}}
