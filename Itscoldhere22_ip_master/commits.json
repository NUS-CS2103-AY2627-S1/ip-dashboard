ap":{"java":{"insertions":46,"deletions":1}}},{"hash":"11ec3becda6a5fa7b6988c222fcc9948655d63b1","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CodingStandard\u0027","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"6fe8132db3affc52526aeb8ecb981461836aa61b","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-9\u0027","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"7eaa557b49f59baca900e87d4fc4c544b805da5f","isMergeCommit":false,"messageTitle":"Modify method to suit coding standard","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":67,"deletions":0}}},{"hash":"861e3352a29ef7f90a5b974ebda9af9206519274","isMergeCommit":true,"messageTitle":"Merge branch-A-CodingStandard into master","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"7cfcc6c155a16c7fc648271ce551917ef48ad5ee","isMergeCommit":false,"messageTitle":"Add checkstyle","messageBody":"","tags":["A-CheckStyle"],"fileTypesAndContributionMap":{"gradle":{"insertions":6,"deletions":1},"java":{"insertions":368,"deletions":154},"md":{"insertions":47,"deletions":17}}},{"hash":"780656e986ed2a0e555b16d86d78862e07cceb19","isMergeCommit":false,"messageTitle":"Add gui","messageBody":"","tags":["branch-Level-10","Level-10"],"fileTypesAndContributionMap":{"gradle":{"insertions":34,"deletions":5},"txt":{"insertions":1,"deletions":0},"java":{"insertions":519,"deletions":41},"md":{"insertions":150,"deletions":163}}},{"hash":"f053badcdab450fcbda75c381f5c1424adb1b7e8","isMergeCommit":false,"messageTitle":"Document internal assumptions with assertions","messageBody":"Command handling relies on initialization, insertion, and index\nvalidation occurring in the correct order. These assumptions were\nimplicit, making violations harder to identify during development.\n\nAdd assertions to ensure commands run after loading, loading starts\nwith an empty and uninitialized list, add confirmations reference the\nlast appended task, and deletion receives a validated index.\n\nExplain each assertion with a comment. Keep existing exceptions for\ninvalid user input, since assertions may be disabled at runtime.\n\nValidation: Java 25 tests, JavaFX acceptance tests, and Checkstyle pass.\nLegacy console cases 1 and 2 pass with assertions enabled. Case 3\nhits an existing expected-message mismatch; later cases were not run.\n","fileTypesAndContributionMap":{"java":{"insertions":9,"deletions":0}}},{"hash":"4a9297caa17fd33d5387435fac18c11aa9eff6b8","isMergeCommit":false,"messageTitle":"Consolidate task insertion and persistence","messageBody":"The three storeMsg overloads repeat the same insertion and saving steps,\nwhile addTask only displays a confirmation despite its name. Maintaining\nthis split makes it easy for task types to acquire inconsistent\nbehavior.\n\nConstruct each task in its command handler and let addTask own\ninsertion, persistence, and confirmation. This follows the code-quality\nguidelines on minimizing duplication and avoiding misleading names while\npreserving the existing order of operations and the insertion assertion.\n\nValidation: Java 25 tests, JavaFX acceptance tests, and Checkstyle pass.\nThe executed console cases match the baseline exactly. Legacy case 3\nstill disagrees with its expected error message; later cases were not\nrun.\n","fileTypesAndContributionMap":{"java":{"insertions":8,"deletions":48}}},{"hash":"7879632540695d3a34f65d52a6e60afd38b08697","isMergeCommit":false,"messageTitle":"Express command exit decisions as booleans","messageBody":"Command handlers return 0 or 1 to indicate whether the session should\nend. Callers must remember that convention, and the name echo conceals\nthe fact that the method executes commands and changes application\nstate.\n\nReturn booleans from the dispatcher and handlers, rename the dispatcher\nto executeCommand, and name the console result shouldExit. This follows\nthe guidelines on avoiding magic values and using names that explain\nintent without changing command responses or termination behavior.\n\nValidation: Java 25 tests, JavaFX acceptance tests, and Checkstyle pass.\nThe executed console cases match the baseline exactly. Legacy case 3\nstill disagrees with its expected error message; later cases were not\nrun.\n","fileTypesAndContributionMap":{"java":{"insertions":32,"deletions":32}}},{"hash":"3486d7eaaa2cd3f62e71212beda7a7d0cb7d3f7d","isMergeCommit":false,"messageTitle":"Separate record parsing from storage loading","messageBody":"Storage.load mixes file access, field validation, task construction, and\ncompletion-state restoration inside nested loops and exception handlers.\nThis obscures both the loading flow and the malformed-record policy.\n\nExtract parseRecord with guard clauses and an explicit status predicate.\nKeep load focused on collecting valid tasks and reporting file errors.\nThis follows the guidelines on short methods, shallow nesting, and a\nsingle level of abstraction while retaining malformed-record tolerance.\n\nAdd regression coverage for mixed valid and malformed records, task\norder, completion states, and a missing file. Java 25 tests, JavaFX\nacceptance tests, and Checkstyle pass. Executed console output matches\nthe baseline; legacy case 3 retains its known message mismatch and stops\nlater cases.\n","fileTypesAndContributionMap":{"java":{"insertions":89,"deletions":20}}},{"hash":"a085a69fb7ce41433d761a925c607a0212c4c767","isMergeCommit":false,"messageTitle":"Split window setup into focused helpers","messageBody":"Main.start combines heading construction, scrolling, input wiring,\nwindow configuration, and startup messages in one long method. Readers\nmust follow widget details before they can understand the startup flow.\n\nExtract named helpers for the header, conversation pane, footer, and\ngreeting. Keep start focused on assembling and showing the window. This\nfollows the guidelines on avoiding long methods and structuring code\nlogically while preserving layout, event handlers, and startup order.\n\nValidation: Java 25 tests, JavaFX acceptance tests, and Checkstyle pass.\nThe executed console cases match the baseline exactly. Legacy case 3\nstill disagrees with its expected error message; later cases were not\nrun.\n","fileTypesAndContributionMap":{"java":{"insertions":37,"deletions":9}}},{"hash":"b52b4ed2af8c77a4e3465ae3d6353ed17f3db807","isMergeCommit":true,"messageTitle":"Merge pull request #2 from Itscoldhere22/branch-A-Assertions","messageBody":"Document internal assumptions with assertions","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"00aa6ef85338f1d38d5df140ec8a4e895c955de1","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"2c2cf2240468ced07a21d89fd763dc35a69fe395","isMergeCommit":true,"messageTitle":"Merge pull request #3 from Itscoldhere22/branch-A-CodeQuality","messageBody":"Branch a code quality","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{}},{"hash":"ad560fce6828838fde025d72dda197c20a26cfe1","isMergeCommit":false,"messageTitle":"Add natural date format","messageBody":"","tags":["BCD-Extension"],"fileTypesAndContributionMap":{"txt":{"insertions":6,"deletions":0},"java":{"insertions":391,"deletions":135},"md":{"insertions":945,"deletions":167}}},{"hash":"59a01f15d4229eea5502eeac80f6958a27f4598c","isMergeCommit":false,"messageTitle":"Add comments for better UI and resizability","messageBody":"","fileTypesAndContributionMap":{"txt":{"insertions":1,"deletions":0},"java":{"insertions":2,"deletions":2}}},{"hash":"d10bc74d841979e0a653e15b5fbba01a0eca525e","isMergeCommit":false,"messageTitle":"Modify error message to be shown in red","messageBody":"","tags":["A-Personality","A-MoreErrorHandling","A-BetterGui"],"fileTypesAndContributionMap":{"txt":{"insertions":1,"deletions":0},"java":{"insertions":62,"deletions":6},"md":{"insertions":4,"deletions":1}}},{"hash":"59a3d