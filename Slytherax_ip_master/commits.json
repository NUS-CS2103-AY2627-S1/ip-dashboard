hen finding tasks","messageBody":"Refactor TaskList.find to filter tasks with a Java stream instead of an explicit loop. The stream expresses the operation as filtering matching tasks and adds them to the result list, while preserving case-insensitive matching and the original task order. Existing tests pass with Java 25.\n","fileTypesAndContributionMap":{"java":{"insertions":3,"deletions":5}}},{"hash":"2e126a3426f740e29b51cc5cd3fa686978360e96","isMergeCommit":true,"messageTitle":"Merge pull request #2 from Slytherax/branch-A-Assertions","messageBody":"Add assertion for non-null tasks","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"8729110e8f56877b4db463ca44b2ff1818c577fe","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"f328302cdf13a2252f99c5b6886c1b537e16060c","isMergeCommit":true,"messageTitle":"Merge pull request #3 from Slytherax/branch-A-Streams","messageBody":"Branch a streams","fileTypesAndContributionMap":{}},{"hash":"1ddcea6814192bab743f30be58510239cb536471","isMergeCommit":false,"messageTitle":"adding a priority feature to the bot","messageBody":"","tags":["C-Priority"],"fileTypesAndContributionMap":{"txt":{"insertions":0,"deletions":4},"java":{"insertions":131,"deletions":15}}}]}]},"authorFileTypeContributionMap":{"Slytherax":{"java":1440,"md":434,"fxml":35,"sh":0,"bat":0,"gradle":32,"txt":2}},"authorContributionVariance":{"Slytherax":62481.355},"authorDisplayNameMap":{"Slytherax":"CS2103T-T12-2 LAXS..ARAN"}}
