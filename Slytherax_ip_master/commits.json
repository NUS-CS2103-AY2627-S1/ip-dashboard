d1eaab32f","isMergeCommit":true,"messageTitle":"Merge varargs GUI improvements","messageBody":"","tags":["A-Varargs"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-10T00:00:00","commitResults":[{"hash":"cf335a6d83098ba7fc8653e32eed5080481528ec","isMergeCommit":false,"messageTitle":"Updated and renamed the jar file to more accuretely represent the name of the bot.","messageBody":"","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"gradle":{"insertions":1,"deletions":1}}},{"hash":"6be77ceb621e1b3a06224faf212694a4ecfbf667","isMergeCommit":false,"messageTitle":"Refactor CLI command processing","messageBody":"Split the long Kdb.main method into focused helpers for loading tasks, running the command loop, dispatching commands, and handling individual CLI actions. This improves readability by giving each method one clear responsibility and keeps the main startup flow easy to follow. The refactoring preserves existing command behavior while making future command changes safer and easier to review.\n","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{"java":{"insertions":129,"deletions":124}}},{"hash":"20d3394cb935daa8dd4312c591c7a0ba12942839","isMergeCommit":true,"messageTitle":"Merge pull request #1 from Slytherax/branch-A-CodeQuality","messageBody":"Refactor CLI command processing","fileTypesAndContributionMap":{}},{"hash":"45f82724481ea7e20a9c2528094ee9a70b958eda","isMergeCommit":false,"messageTitle":"Add assertion for non-null tasks","messageBody":"Ensure TaskList never receives a null task. A null element would violate the collection\u0027s invariant and cause later operations such as find or save to fail unexpectedly. The assertion documents this developer-facing assumption and detects programming errors during development without replacing normal user-input validation.\n","fileTypesAndContributionMap":{"java":{"insertions":1,"deletions":0}}},{"hash":"4b7a2c79b1107122a2d04437ac756aad2ddc5a27","isMergeCommit":false,"messageTitle":"Use stream when finding tasks","messageBody":"Refactor TaskList.find to filter tasks with a Java stream instead of an explicit loop. The stream expresses the operation as filtering matching tasks and adds them to the result list, while preserving case-insensitive matching and the original task order. Existing tests pass with Java 25.\n","fileTypesAndContributionMap":{"java":{"insertions":3,"deletions":5}}},{"hash":"2e126a3426f740e29b51cc5cd3fa686978360e96","isMergeCommit":true,"messageTitle":"Merge pull request #2 from Slytherax/branch-A-Assertions","messageBody":"Add assertion for non-null tasks","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"8729110e8f56877b4db463ca44b2ff1818c577fe","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"f328302cdf13a2252f99c5b6886c1b537e16060c","isMergeCommit":true,"messageTitle":"Merge pull request #3 from Slytherax/branch-A-Streams","messageBody":"Branch a streams","fileTypesAndContributionMap":{}},{"hash":"1ddcea6814192bab743f30be58510239cb536471","isMergeCommit":false,"messageTitle":"adding a priority feature to the bot","messageBody":"","tags":["BCD-Extension"],"fileTypesAndContributionMap":{"txt":{"insertions":0,"deletions":4},"java":{"insertions":131,"deletions":15}}}]},{"date":"2026-09-16T00:00:00","commitResults":[{"hash":"f0cc94d852edd04b475552027425a3b691f2e9f8","isMergeCommit":false,"messageTitle":"Fix Java coding standard violations","messageBody":"Java source files contain inconsistent import ordering, wrapped-line\nindentation, fall-through comments, whitespace, and Javadoc spacing.\n\nThese inconsistencies reduce readability and can trigger Checkstyle\nwarnings.\n\nAlign the affected files with the projects Java coding standards without\nchanging application behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":35,"deletions":32}}},{"hash":"f1b4988fe643f141e1928672be628f7f6655b58c","isMergeCommit":false,"messageTitle":"Improve GUI and expand command coverage","messageBody":"The GUI needs clearer message presentation, responsive sizing, readable\nmulti-line content, and a visible distinction between normal and error\nresponses.\n\nThe existing tests do not cover all GUI bot commands or response\nstatuses.\n\nImprove the GUI layout and styling, preserve the ASCII banner with\nmonospaced rendering, and add isolated JUnit coverage for every bot\ncommand,invalid input, response errors, and task persistence.\n","tags":["A-BetterGui"],"fileTypesAndContributionMap":{"fxml":{"insertions":18,"deletions":25},"java":{"insertions":213,"deletions":42}}},{"hash":"61b762e32e919b7b94baf1e52a952a4536afb219","isMergeCommit":false,"messageTitle":"Add KDB football-themed personality","messageBody":"KDB\u0027s responses do not yet reflect its identity as Kevin De Bruyne, the\nassist king.\n\nGive the chatbot a calm football-inspired personality by updating its\ncommand confirmations, error messages, list and search responses,\npriority prompt, and farewell message.\n\nAdd tests to verify the new personality phrases while preserving command\nbehaviour.\n","tags":["A-Personality"],"fileTypesAndContributionMap":{"txt":{"insertions":1,"deletions":0},"java":{"insertions":20,"deletions":15}}},{"hash":"1e14cd4e3789708143e595f67af7b5768bf46b8e","isMergeCommit":false,"messageTitle":"Remove generated Gradle cache files","messageBody":"Generated Gradle cache files are tracked in the repository, increasing\nits size and causing GitHub large-file warnings.\n\nRemove the cached files from version control and ignore the\nproject-local. Gradle cache to prevent them from being committed again.\n","fileTypesAndContributionMap":{"txt":{"insertions":0,"deletions":1}}},{"hash":"2366247983cec67d4403bfb28a41cb218e526dd7","isMergeCommit":false,"messageTitle":"Improve error handling for commands and storage","messageBody":"The application accepts several invalid command inputs and malformed\ntask-file records without providing sufficiently clear error handling.\n\nValidate null and blank commands, malformed task statuses, extra task\nfields, incomplete event data, and file-save failures.\n\nAdd JUnit tests for the new validation cases to improve reliability\nduring normal usage.\n","tags":["A-MoreErrorHandling"],"fileTypesAndContributionMap":{"java":{"insertions":77,"deletions":7}}},{"hash":"8a49a95c1111cf5a6c5f89f65516b2e9cdd3a335","isMergeCommit":false,"messageTitle":"Expand automated test coverage","messageBody":"Several non-GUI code paths have limited automated coverage, especially\nfor invalid commands, malformed task data, and boundary conditions.\n\nAdd JUnit tests for command conversion, parser edge cases, task\noperations, storage failures, invalid inputs, persistence,\nand chatbot responses.\n\nIncrease confidence in expected behaviour while leaving GUI interactions\nfor manual testing.\n","tags":["A-MoreTesting"],"fileTypesAndContributionMap":{"java":{"insertions":89,"deletions":0}}},{"hash":"a0b686dc9016ad31db2683c3fa361f8ccf811dd1","isMergeCommit":false,"messageTitle":"Complete the KDB user guide","messageBody":"The user guide contains placeholder sections and does not describe the\ncurrent KDB features or command syntax.\n\nDocument the GUI, available commands, priorities, date formats, error\nhandling, task storage, and example usage for new users.\n","tags":["A-UserGuide"],"fileTypesAndContributionMap":{"md":{"insertions":81,"deletions":14}}}]},{"date":"2026-09-18T00:00:00","commitResults":[{"hash":"269a1fb6b690ffb7cc227f224d0b91bc7aec83c0","isMergeCommit":false,"messageTitle":"Finalize submission quality and documentation","messageBody":"Resolve Checkstyle violations, remove tracked compiled artifacts,\nand configure JavaFX for the appropriate operating system architecture.\n\nUpdate the README and UI testing documentation to reflect the current\nKDB commands, launch process, and user-facing behaviour.\n","fileTypesAndContributionMap":{"gradle":{"insertions":18,"deletions":23},"java":{"insertions":11,"deletions":9},"md":{"insertions":80,"deletions":321}}},{"hash":"2b00e5b5bd3b689b11613b2112a3baf737a86bb6","isMergeCommit":false,"messageTitle":"Document packaged JAR usage","messageBody":"Explain how to build, smoke-test, and run the executable KDB JAR from an\nempty folder using Gradle and the `java -jar` command.\n","tags":["v0.2"],"fileTypesAndContributionMap":{"md":{"insertions":18,"deletions":0}}}]}]},"authorFileTypeContributionMap":{"Slytherax":{"java":1780,"md":293,"fxml":28,"sh":0,"bat":0,"gradle":27,"txt":2}},"authorContributionVariance":{"Slytherax":63160.39},"authorDisplayNameMap":{"Slytherax":"CS2103T-T12-2 LAXS..ARAN"}}
