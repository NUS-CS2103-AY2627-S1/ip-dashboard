267b81de7cc2255bf928da152775bac45609f5","isMergeCommit":true,"messageTitle":"Merge master into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"bd725c1eb1405b5d1edf799de9ae23c8624bf759","isMergeCommit":true,"messageTitle":"Merge pull request #2 from shiverin/branch-A-CodeQuality","messageBody":"Improve TaskList ownership","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"43f64b722e7628d726cde1578c113b7ff7593396","isMergeCommit":true,"messageTitle":"Merge master into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"a86cdb8361c5f5b125ed0daed877db39ca283932","isMergeCommit":true,"messageTitle":"Merge pull request #1 from shiverin/branch-A-Streams","messageBody":"Use streams for task formatting","tags":["A-Streams"],"fileTypesAndContributionMap":{}},{"hash":"e572b521a59e5f828886bca6ee3f50641b99eb83","isMergeCommit":false,"messageTitle":"Add task description updates","messageBody":"Users must delete and recreate a task to correct its description, which loses its completion state and is unnecessarily cumbersome. Add an update command that changes only the description while preserving the task type, status, dates, and times.\n","fileTypesAndContributionMap":{"java":{"insertions":65,"deletions":2},"md":{"insertions":6,"deletions":25}}},{"hash":"fa379ce495a0994a968b162453971782a5c81cd9","isMergeCommit":true,"messageTitle":"Merge pull request #4 from shiverin/branch-C-Update","messageBody":"Add task description updates","tags":["BCD-Extension"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-11T00:00:00","commitResults":[{"hash":"6fc995a12c7fa8c0cee6533ae16e08d8454dc470","isMergeCommit":false,"messageTitle":"Parser: Handle missing task descriptions","messageBody":"Malformed task commands can trigger unchecked substring errors.\n\nParse the separated command argument instead of slicing the full input.\n\nUse marker lengths so invalid input returns normal usage guidance.\n\nAdd regression tests for both affected command forms.\n","fileTypesAndContributionMap":{"java":{"insertions":34,"deletions":12}}},{"hash":"36914dbbf9e8e83bc7af6cb6aa57bc373ccd702d","isMergeCommit":false,"messageTitle":"GUI: Share command and startup state","messageBody":"The GUI duplicates exit detection and hides storage load failures.\n\nReturn the exit state with each response and expose the startup message.\n\nUse both values in the console and JavaFX interfaces, with regression tests.\n","fileTypesAndContributionMap":{"java":{"insertions":70,"deletions":12}}},{"hash":"0b7b9ce854d15e28bee5b27d84b05eff41356653","isMergeCommit":false,"messageTitle":"Refactor ambiguous boolean parameters","messageBody":"Raw boolean arguments obscure task actions and message senders.\n\nUse intention-revealing methods for marking tasks.\n\nUse a sender enum so each call site identifies the message sender.\n","fileTypesAndContributionMap":{"java":{"insertions":23,"deletions":16}}},{"hash":"7f51924c3fcdacbfdcee80b76887fa2b73ec077d","isMergeCommit":false,"messageTitle":"Clean up reviewed code conventions","messageBody":"Storage naming and constructor documentation need clearer intent.\n\nUi also retains helpers with no callers.\n\nClarify names and documentation, and remove the dead methods.\n","fileTypesAndContributionMap":{"java":{"insertions":23,"deletions":37}}},{"hash":"fdd2f68aab497dcfb68986aa7f4a1e920006ad6f","isMergeCommit":true,"messageTitle":"Merge review feedback fixes","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"bb07aaa76358c595d395d727e306a129dec1ab28","isMergeCommit":false,"messageTitle":"GUI: Polish the Nimbus conversation view","messageBody":"Replace the plain inline styling with a reusable stylesheet and a clearer visual hierarchy. Show speaker names, a concise command hint, and a calm Nimbus-themed header while preserving the existing interaction flow.\n","fileTypesAndContributionMap":{"java":{"insertions":36,"deletions":17}}},{"hash":"3360dff70bcb67e12543c896aa57f37c4bed705e","isMergeCommit":true,"messageTitle":"Merge branch-A-BetterGui","messageBody":"","tags":["A-BetterGui"],"fileTypesAndContributionMap":{}},{"hash":"a9fa4ef4afb83a9a74d41b950f0e7cd17fdb2c6e","isMergeCommit":false,"messageTitle":"Give Nimbus a calm weather personality","messageBody":"Use a consistent cloud-and-sky voice for greetings, successes, errors, and farewells. Keep each response informative so the personality does not obscure command outcomes.\n","fileTypesAndContributionMap":{"java":{"insertions":21,"deletions":19}}},{"hash":"ac6300dc6b6714dd6977c023ee12bb5f6b60c31b","isMergeCommit":true,"messageTitle":"Merge branch-A-Personality","messageBody":"","tags":["A-Personality"],"fileTypesAndContributionMap":{}},{"hash":"bb854daa58925e93be0064073adb2f6ba63160b3","isMergeCommit":false,"messageTitle":"Handle damaged data and blank commands","messageBody":"Keep valid tasks when individual storage records are damaged and tell the user how many records were skipped. Give blank input a helpful response and accept any whitespace between a command and its argument.\n","fileTypesAndContributionMap":{"java":{"insertions":56,"deletions":7}}},{"hash":"419660f699fa31a91aa8f48f4dc12e1769a5f807","isMergeCommit":true,"messageTitle":"Merge branch-A-MoreErrorHandling","messageBody":"","tags":["A-MoreErrorHandling"],"fileTypesAndContributionMap":{}},{"hash":"6a66220cda3ca995811d5efce73df7de1bacb650","isMergeCommit":false,"messageTitle":"Test task workflows and storage recovery","messageBody":"Cover the full task lifecycle, search and command errors, cross-session persistence, mixed task serialization, damaged records, and file replacement. These tests protect the final release paths that users rely on most.\n","fileTypesAndContributionMap":{"java":{"insertions":129,"deletions":0}}},{"hash":"966bd160594c68638ea55b4459392b5e72a6bfd4","isMergeCommit":true,"messageTitle":"Merge branch-A-MoreTesting","messageBody":"","tags":["A-MoreTesting"],"fileTypesAndContributionMap":{}},{"hash":"eff51