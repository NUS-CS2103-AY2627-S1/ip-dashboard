st\ncapabilities were too tightly coupled, so TaskList and TaskStorage are\nnow seperate, so TaskList is simply a wrapper over List\u003cTask\u003e to allow\neasier modification of tasks.\n","fileTypesAndContributionMap":{"java":{"insertions":188,"deletions":68}}},{"hash":"a81e18dcc47cc3d9fcc37ccc903e36dba45a0dcc","isMergeCommit":false,"messageTitle":"Fix typo for event serialization","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":1,"deletions":1}}},{"hash":"c53ab28d6ae85b81dea7cdc5038b08f3347dc16d","isMergeCommit":false,"messageTitle":"Add task deserializer","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":295,"deletions":0}}},{"hash":"32275c7f4947887c8d53e93cb34e9bf607f0f781","isMergeCommit":false,"messageTitle":"Replace by string literal instead of regex","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":3,"deletions":3}}},{"hash":"afbe22fde3fd00c5056100c708cb41d80c99c11d","isMergeCommit":false,"messageTitle":"Add support for loading saved tasks on startup","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":33,"deletions":4}}},{"hash":"052bab58b578bf6d9d38ca7df90be49873b87606","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-Level-7\u0027","messageBody":"","tags":["Level-7"],"fileTypesAndContributionMap":{}},{"hash":"f143ec203ed7689100f7f3cbd871ef80bf8d6133","isMergeCommit":false,"messageTitle":"Add LocalDateTime support for deadlines","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":51,"deletions":16}}},{"hash":"053330e876e448f51af98ee0c661ea29b4c2edf2","isMergeCommit":false,"messageTitle":"Move date time formats into parent Task class","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":33,"deletions":25}}},{"hash":"fe44286b305fbde405401924095a3050ce33ea1b","isMergeCommit":false,"messageTitle":"Add LocalDateTime support for events","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":28,"deletions":4}}},{"hash":"33607