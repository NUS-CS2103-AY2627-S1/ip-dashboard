":187,"deletions":214}}},{"hash":"9982521ad4b9fec0c685ce25c64482e9b099df10","isMergeCommit":false,"messageTitle":"Add project Java coding standard","messageBody":"Java changes need a shared, repository-specific interpretation of the\nSE-EDU conventions so automated contributors apply the same rules.\n\nAdd a project skill that captures the required naming, layout,\ndocumentation, and verification practices. Require agents to load it\nfor every Java change and expose only that skill through .gitignore.\n","fileTypesAndContributionMap":{"md":{"insertions":46,"deletions":0}}},{"hash":"4f6bc18daeaede1b28d03967d7ff90ba1f74737c","isMergeCommit":false,"messageTitle":"Add project Git commit standard","messageBody":"Commit and branch metadata need consistent formatting so repository\nhistory remains readable across tools and contributors.\n\nAdd a project skill based on SE-EDU Git conventions. Require agents to\nload it before proposing or creating commits and branch names, while\npreserving the rule that commits require user authorization.\n","tags":["A-CodingStandard"],"fileTypesAndContributionMap":{"md":{"insertions":46,"deletions":0}}},{"hash":"5f00df93617a8676085f4be027bb417c05e8f4d2","isMergeCommit":false,"messageTitle":"Add task search by description","messageBody":"","fileTypesAndContributionMap":{"java":{"insertions":123,"deletions":0}}},{"hash":"6eefe5addfff9631af1814c90bb454b86178317a","isMergeCommit":false,"messageTitle":"Fix Gongrilla name in user messages","messageBody":"","tags":["Level-9"],"fileTypesAndContributionMap":{"java":{"insertions":15,"deletions":7}}},{"hash":"838a012990aeb69cc1e2d25080b31be0754c4582","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-JavaDoc\u0027","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"17acc9879ad9773a8c8a1e5481ac5824c2e7105e","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-A-CodingStandard\u0027","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"6e726b110a9b20670b8fba78fe