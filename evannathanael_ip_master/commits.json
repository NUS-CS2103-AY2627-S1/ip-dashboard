":"80e1167efa4c6aac3e66288b5f2beaa3df912021","isMergeCommit":true,"messageTitle":"Merge JavaDoc branch","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"7f60c95ac4629f8ee833e7b6b8ebbd9280458cb9","isMergeCommit":true,"messageTitle":"Merge coding standard branch","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"060fd9b2ac87b1eca7f47cde500c9dcfc63f5edb","isMergeCommit":true,"messageTitle":"Merge Level 9 branch","messageBody":"","tags":["Level-9","A-JavaDoc","A-CodingStandard"],"fileTypesAndContributionMap":{}}]},{"date":"2026-09-03T00:00:00","commitResults":[{"hash":"4fb8287c5b6743863ebabea507f7c8973eec9715","isMergeCommit":false,"messageTitle":"Configure Checkstyle and fix style violations","messageBody":"","tags":["A-Checkstyle"],"fileTypesAndContributionMap":{"gradle":{"insertions":4,"deletions":0},"java":{"insertions":86,"deletions":88}}},{"hash":"f9cba152ca08d2a20345c445bd7b0cb82cb46a8c","isMergeCommit":false,"messageTitle":"Implement GUI for Ducky","messageBody":"","tags":["Level-10"],"fileTypesAndContributionMap":{"gradle":{"insertions":15,"deletions":1},"fxml":{"insertions":48,"deletions":0},"java":{"insertions":336,"deletions":81}}}]},{"date":"2026-09-09T00:00:00","commitResults":[{"hash":"8f734276996ac04bfc6c86736c36acd11e742cdb","isMergeCommit":false,"messageTitle":"Address pull request review comments","messageBody":"Update documentation wording for deadline fields.\nFormat enum declarations according to the coding standard.\nCorrect test annotation placement and improve test readability.\nIgnore generated JAR files in Git.\n","fileTypesAndContributionMap":{"java":{"insertions":53,"deletions":25}}},{"hash":"862c61a029002bab347817dd61f583278c66f3df","isMergeCommit":false,"messageTitle":"Document invariants with Java assertions","messageBody":"Assert that parsed commands contain only the arguments valid for\ntheir command types.\n\nAssert that every parsed command type is handled during command\nexecution. These assertions document internal assumptions and help\ndetect programming errors while preserving user-facing validation\nthrough exceptions.\n","fileTypesAndContributionMap":{"java":{"insertions":17,"deletions":0}}},{"hash":"65c6071fa3d85b09fc9a3d266a3e8d9df6264c18","isMergeCommit":false,"messageTitle":"Extract task command handlers","messageBody":"The command-processing method mixed high-level dispatch with the\ndetails of mutating tasks, formatting responses, and persisting\nchanges. This made its main control flow longer and forced readers to\nswitch between abstraction levels.\n\nExtract each state-changing command into a focused helper so the\nswitch now reads as a concise overview of supported behavior. Keeping\neach mutation workflow together also makes future changes easier to\nlocate while preserving the existing execution order and user-visible\nbehavior.\n","fileTypesAndContributionMap":{"java":{"insertions":62,"deletions":18}}},{"hash":"bad0ba3bec13f6936a86a862911f6c5b2b480c61","isMergeCommit":false,"messageTitle":"Extract saved task parsers","messageBody":"The saved-task parser combined record dispatch with field validation,\ndate conversion, and construction for every task type. This made the\nmethod longer than necessary and mixed several levels of abstraction.\n\nMove each record format into a focused parsing method so the main\nmethod presents the storage workflow clearly. Keeping type-specific\nvalidation together makes each format easier to understand and change\nwhile preserving existing parsing behavior and error messages.\n","fileTypesAndContributionMap":{"java":{"insertions":55,"deletions":22}}},{"hash":"8078fd5757970d4103d5deef851c99606d38734e","isMergeCommit":false,"messageTitle":"Centralize parser grammar tokens","messageBody":"Command words, prefixes, and argument markers were repeated as string\nliterals across command detection and argument extraction. Their\nmeaning was implicit, and changing one occurrence without another\ncould make parsing behavior inconsistent.\n\nGive each grammar token a descriptive constant and reuse it wherever\nthe syntax is interpreted. This makes the accepted command language\nvisible in one place and allows future syntax changes to remain\nconsistent without altering current behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":39,"deletions":22}}},{"hash":"e5b0d6f78f79d8c0f1c30280f7fb64c18aef4066","isMergeCommit":false,"messageTitle":"Constrain parsed command creation","messageBody":"ParsedCommand exposed overloaded constructors that accepted any command\ntype alongside any payload. This allowed contradictory objects, such\nas a BYE command carrying a task, and made valid field combinations\nimplicit to callers.\n\nReplace those constructors with command-specific factory methods and\nkeep the raw constructor private. Each creation call now states its\nintent and fixes the matching type and payload, preventing accidental\ninvalid combinations without changing parsed command behavior.\n","fileTypesAndContributionMap":{"java":{"insertions":36,"deletions":45}}},{"hash":"fc5af6b47c8c47fac3b9f3d396c125b640dde0e8","isMergeCommit":false,"messageTitle":"Name storage format constants","messageBody":"Storage parsing and formatting relied on raw field indexes, record\nsizes, status codes, and separator strings. Their meaning was hidden\nat each use site, and the similar read and write separators were easy\nto confuse during future format changes.\n\nIntroduce descriptive constants for every structural part of the\nsaved-task format and use named local values when constructing dated\ntasks. This makes the format readable in domain terms and keeps its\nparsing and serialization rules consistent without changing output.\n","fileTypesAndContributionMap":{"java":{"insertions":37,"deletions":19}}},{"hash":"05c9adc56f98d1b65d3d6f197a1c3e8849805a80","isMergeCommit":false,"messageTitle":"Use Java Streams for task processing","messageBody":"Refactor task searching and UI task formatting to use Streams.\nPreserve existing task ordering and output behavior while reducing\nmanual collection-processing loops.\n","tags":["A-FullCommitMessage"],"fileTypesAndContributionMap":{"java":{"insertions":14,"deletions":19}}}]},{"date":"2026-09-10T00:00:00","commitResults":[{"hash":"ae9bfc1759c99d201c3241d7c30c247ec20ca2e8","isMergeCommit":true,"messageTitle":"Merge pull request #1 from evannathanael/branch-A-Assertions","messageBody":"[evannathanael] A-Assertions","tags":["A-Assertions"],"fileTypesAndContributionMap":{}},{"hash":"e8db5f6400eb2950b3a53cb7e3cf80a8992d2e84","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-CodeQuality","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"49cf0fb11ee2eff094cad94340e872105a2731a6","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"8afd3a29d2f0dbd09f36c696880a2d3ca1790137","isMergeCommit":true,"messageTitle":"Merge pull request #2 from evannathanael/branch-A-CodeQuality","messageBody":"[evannathanael] A-CodeQuality","tags":["A-CodeQuality"],"fileTypesAndContributionMap":{}},{"hash":"445d998f7214668f915ba69c678ca3722d4a9360","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-A-Streams","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"408d479b476013e7441b2c996073fbde53eb149f","isMergeCommit":true,"messageTitle":"Merge pull request #3 from evannathanael/branch-A-Streams","messageBody":"[evannathanael] A-Streams","tags":["A-Streams"],"fileTypesAndContributionMap":{}},{"hash":"f43398ab934c6185c43351501c14b9162ebd6555","isMergeCommit":false,"messageTitle":"Add task tagging support","messageBody":"","tags":["BCD-Extension"],"fileTypesAndContributionMap":{"java":{"insertions":298,"deletions":23},"md":{"insertions":12,"deletions":3}}},{"hash":"90ea169da71b81c5afe0acd9ceaaecba306ae829","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-C-Tagging\u0027","mes